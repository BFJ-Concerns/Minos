# Shared memory envelope for Minos run units. Runs land here via the
# --slice systemd-run flag in SpawnRun; nothing throttles any run until the
# runs together approach the envelope, reclaim then pushes them back, and
# only combined demand the envelope cannot hold kills. Keep the ceilings in
# step with runMemoryEnvelopeGiB in internal/shell/spawn.go.
[Unit]
Description=Minos run memory envelope

[Slice]
MemoryHigh=18G
MemoryMax=20G
