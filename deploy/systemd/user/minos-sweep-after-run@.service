# The run's OnSuccess hook targets this short-lived instance so systemd can
# collect both units before the next run of the same pull request. Keep the
# actual sweep in its own service and leave a request for the path unit to
# notice, including when a sweep is already active.
[Unit]
Description=Request a Minos reconciliation sweep after run unit %i exited cleanly
Documentation=file:/opt/minos/docs/deployment.md
CollectMode=inactive-or-failed

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/bin/touch %t/minos-sweep.request
ExecStart=/usr/bin/systemctl --user start --no-block minos-sweep-request.path
