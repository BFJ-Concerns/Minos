[Unit]
Description=Minos Forgejo webhook receiver
Documentation=file:/opt/minos/docs/go-live.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/minos receive --config /etc/minos
Restart=on-failure
RestartSec=5s
UMask=0077

[Install]
WantedBy=default.target
