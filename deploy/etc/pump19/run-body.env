# Static run-session wiring. The model identifiers themselves live in the
# separately approved pins file.
PUMP19_ENGINE_LAUNCH_LEAD="/opt/pump19/run-body/launch-claude-lead"
PUMP19_ENSEMBLE_LAUNCH="/opt/pump19/run-body/launch-ensemble"
PUMP19_PINS="/opt/pump19/pins.toml"
PUMP19_REVIEW_SCRIPTS="/opt/pump19/review"
PUMP19_BIN="/usr/local/bin/pump19"
PUMP19_CLAUDE="/usr/local/bin/claude"

# Fix-run wiring. The fix skill is the one service-authored skill, fixed by the
# deployment (not selectable per repository). A landed fix is attributed to the
# service's forge bot identity (operator instruction 2026-07-11), with the
# serving model recorded in a commit trailer.
PUMP19_FIX_SKILL="/opt/pump19/skills/service/fix/SKILL.md"
PUMP19_FLAKY_SKILL="/opt/pump19/skills/foundry/root-cause/SKILL.md"
PUMP19_FIX_AUTHOR_NAME="Minos"
PUMP19_FIX_AUTHOR_EMAIL="minos@example.invalid"
