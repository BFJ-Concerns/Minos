# Copy this file to a name ending in .toml only after every REPLACE_WITH value
# is set. Files ending in .toml are live repository opt-ins.
forge = "forgejo"
owner = "REPLACE_WITH_FORGEJO_OWNER"
repo = "REPLACE_WITH_FORGEJO_REPOSITORY"

[adaptation]
build = "REPLACE_WITH_BUILD_COMMAND"
test = "REPLACE_WITH_TEST_COMMAND"
briefs = ".review"
skill = "REPLACE_WITH_PINNED_REVIEW_SKILL_PATH"
run-body = "/opt/pump19/run-body/run-body"

# If the forge enforces the repository's build and full test suite as required
# checks, name those contexts here and omit build/test above. An absent or empty
# list means the workspace carries the gate, so both commands remain required.
# [ci]
# required-checks = ["REPLACE_WITH_REQUIRED_CHECK_CONTEXT"]

[policy]
auto-merge = false

[[trigger]]
run = "review"
on = ["pr-opened", "pr-reopened", "pr-synchronized", "pr-edited"]
authors = ["*"]
drafts = false

# A rejected review (verified material findings) triggers a fix run. The fix lands
# commits and pushes them; that PR update re-triggers review on its own, so no
# review-after-fix trigger is needed. A fruitless or unwritable-head fix lands
# nothing and the loop stops at the standing findings — deliberately not
# re-reviewed on an unchanged head, which would only loop.
[[trigger]]
run = "fix"
on = ["review-rejected"]
authors = ["*"]

# The Ready label triggers a finish run. Triggering is permissive; the finish run's own
# gate (clean-or-flagged, current, forge-mergeable, build/test) protects the
# tree. WHO may apply Ready is the whole merge policy: with auto-merge off, only
# these actors' Ready is honoured. Set them to real forge logins with merge
# authority — authority, not display names. An unreplaced value authorises
# nobody, so finish never runs until you set it.
[[trigger]]
run = "finish"
on = ["label-added:Ready"]
actors = ["REPLACE_WITH_AUTHORISED_FINISH_LOGINS"]

# Flaky Tests is inert for repair until this stanza is configured. Name the CI
# and service accounts that are allowed to pause the loop and request repair.
[[trigger]]
run = "flaky"
on = ["label-added:Flaky Tests"]
actors = ["REPLACE_WITH_AUTHORISED_FLAKY_LABEL_ACTORS"]
