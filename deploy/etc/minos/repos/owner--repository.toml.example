forge = "forgejo"
owner = "REPLACE_WITH_FORGEJO_OWNER"
repo = "REPLACE_WITH_FORGEJO_REPOSITORY"

[adaptation]
build = "REPLACE_WITH_BUILD_COMMAND"
# The canonical verify entrypoint the repository's own CI also runs, so the
# gate Minos verifies against and the gate CI applies cannot drift apart.
test = "just verify"
run-body = "/opt/minos/run-body/run-body"

[policy]
auto-merge = false

[review]
threshold = "High"
cluster-cap = 5
# maximum-rounds is optional and defaults unset.
