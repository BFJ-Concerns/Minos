forge = "forgejo"
owner = "REPLACE_WITH_FORGEJO_OWNER"
repo = "REPLACE_WITH_FORGEJO_REPOSITORY"
# work-in-progress-branch-prefixes is optional. Prefixes are literal and case-sensitive:
# "structural" also matches "structural-notes"; use "structural/" for that directory convention.
# Long-lived integration branches (structural lanes, say) park under this knob.
# work-in-progress-branch-prefixes = ["REPLACE_WITH_BRANCH_PREFIX/"]

# Every knob below is optional: an omitted knob takes the service-level value
# from [repositories] in service.toml, and a knob written here replaces that
# value whole.
# This table replaces [repositories.admission] in service.toml. An empty
# table restores the shipped rules (ready, same-repository pull requests).
# [admission]
# labels = ["Ready"]
# exclude-labels = ["Blocked"]
# authors = ["trusted-user"]
# base-branches = ["main"]
# drafts = "ready"
# title-pattern = '^Release '
# paths = ["internal/", "docs/*.md"]
# allow-forks = false
# [[guidance-sources]]
# repository = "REPLACE_WITH_OWNER/REPLACE_WITH_PLANNING_REPOSITORY"
# path = "README.md"
# The service's identity (bot login, commit author, status-context) is
# service-level only: set it in service.toml, never here.
# [filing-destination]
# kind = "file"
# repository = "REPLACE_WITH_OWNER/REPLACE_WITH_PLANNING_REPOSITORY"
# path = "ISSUES.md"
# [description]
# enabled = true
# [markers]
# in-flight = {label = "REPLACE_WITH_IN_FLIGHT_LABEL"}
# clean = {reaction = "+1"}
# Routing overrides [routing] in service.toml one role or concern at a time:
# a role or concern set here replaces the service's whole, and every other
# role and concern keeps the service's.
# [routing.proposer]
# effort = "high"
# [routing.concerns.security]
# engine = "claude"
# model = "claude-opus-5-5"

[adaptation]
run-body = "/opt/minos/run-body/run-body"
