# Copy this file to a name ending in .toml only after every REPLACE_WITH value
# is set. Files ending in .toml are live repository opt-ins.
forge = "forgejo"
owner = "REPLACE_WITH_FORGEJO_OWNER"
repo = "REPLACE_WITH_FORGEJO_REPOSITORY"

[adaptation]
build = "REPLACE_WITH_BUILD_COMMAND"
test = "REPLACE_WITH_TEST_COMMAND"
briefs = ".review"
skill = "REPLACE_WITH_PINNED_REVIEW_SKILL_PATH"
run-body = "/opt/minos/run-body/run-body"

# If the forge enforces the repository's build and full test suite as required
# checks, name those contexts here and omit build/test above. An absent or empty
# list means the workspace carries the gate, so both commands remain required.
# [ci]
# required-checks = ["REPLACE_WITH_REQUIRED_CHECK_CONTEXT"]

[policy]
auto-merge = false
# Inclusive fixed P0-P3 boundaries. Omission keeps the shipped P1/P3 defaults.
publish-threshold = "P1"
repair-threshold = "P3"

[finding-disposition]
# Normal production mode: quiet verified findings go to the named authenticated
# durable destination configured in service.toml.
mode = "destination"
destination = "engineering-backlog"
target = "REPLACE_WITH_FINDING_DESTINATION_TARGET"

# A repository without a destination may instead make the explicit disclosure
# trade-off below. Replace the table above; do not configure both forms.
# [finding-disposition]
# mode = "publish-through-p3"

[[eligibility]]
authors = ["*"]
