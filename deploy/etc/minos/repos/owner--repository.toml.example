forge = "forgejo"
owner = "REPLACE_WITH_FORGEJO_OWNER"
repo = "REPLACE_WITH_FORGEJO_REPOSITORY"
# work-in-progress-branch-prefixes is optional. Prefixes are literal and case-sensitive:
# "structural" also matches "structural-notes"; use "structural/" for that directory convention.
# Long-lived integration branches (structural lanes, say) park under this knob.
# work-in-progress-branch-prefixes = ["REPLACE_WITH_BRANCH_PREFIX/"]

[adaptation]
run-body = "/opt/minos/run-body/run-body"

[review]
threshold = "High"
