MINOS_CLAUDE="/usr/local/bin/claude"
MINOS_LEAD_MODEL="claude-opus-5"
MINOS_GIT_AUTHOR_NAME="Minos"
MINOS_GIT_AUTHOR_EMAIL="minos@example.invalid"
MINOS_CLAUDE_CONFIG_SEED="/etc/minos/claude-config-seed"
MINOS_CODEX_CONFIG_SEED="/etc/minos/codex-config-seed"
MINOS_LIFECYCLE_INSTRUCTION="/opt/minos/lifecycle/lifecycle.md"
MINOS_REVIEW_WORKFLOW="/opt/minos/workflows/adjudicated-review"
MINOS_ROOT_CAUSE_SKILL="/opt/minos/skills/foundry/codex/root-cause"
MINOS_SKILLS_DIR="/opt/minos/skills/foundry"
MINOS_SETUP_WORKSPACE="/opt/minos/run-body/setup-workspace"
MINOS_BIN="/usr/local/bin/minos"
MINOS_FAILURE_LOG="/var/lib/minos/failures.log"
MINOS_ARCHIVE_RUN="/opt/minos/run-body/archive-run"
MINOS_ARCHIVE_CONFIG="/etc/minos/archive.env"
MINOS_REAP_WORKTREES="/opt/minos/run-body/reap-worktree-build-dirs"
# The shared build jobserver (minos-build-jobserver.service) bounds
# compiler jobs box-wide: cargo inherits the token pool through MAKEFLAGS
# and an inherited jobserver overrides CARGO_BUILD_JOBS, so the pool
# governs every concurrent build together rather than each invocation
# multiplying its own cap. CARGO_BUILD_JOBS stays as the measured fallback:
# with the FIFO unreachable, cargo warns and honours it per invocation.
MAKEFLAGS="-j --jobserver-auth=fifo:/run/user/1000/minos-build-jobserver"
CARGO_BUILD_JOBS="6"
# Compile caches persist across runs under the per-repository shared cache
# (run-body derives SCCACHE_DIR from it), so identical crate compiles are
# served from disk instead of rebuilt. The cap is per repository store:
# size it for one repository's live toolchain and dependency set, not the
# whole disk — every reviewed repository carries its own store.
RUSTC_WRAPPER="/usr/bin/sccache"
SCCACHE_CACHE_SIZE="20G"
CARGO_INCREMENTAL="0"
RUSTUP_HOME="/var/lib/minos/cache/rustup"
CARGO_HOME="/var/lib/minos/cache/cargo"
