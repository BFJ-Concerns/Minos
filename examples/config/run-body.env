# Deployment-static paths exported to the accountable run session.
MINOS_ENGINE_LAUNCH_LEAD="/opt/minos/run-body/launch-claude-lead"
MINOS_ENSEMBLE_LAUNCH="/opt/minos/run-body/launch-ensemble"
MINOS_PINS="/opt/minos/pins.toml"
MINOS_REVIEW_SCRIPTS="/opt/minos/review"
MINOS_BIN="/usr/local/bin/minos"
MINOS_CLAUDE="/home/REPLACE_WITH_DEPLOYMENT_USER/.local/bin/claude"

# Fix-run wiring. The fix skill is the one service-authored skill, fixed by the
# deployment (not selectable per repository). A landed fix is attributed to this
# service identity, with the serving model recorded in a commit trailer.
MINOS_FIX_SKILL="/opt/minos/skills/service/fix/SKILL.md"
MINOS_FLAKY_SKILL="/opt/minos/skills/foundry/root-cause/SKILL.md"
MINOS_FIX_AUTHOR_NAME="Minos"
MINOS_FIX_AUTHOR_EMAIL="minos@bfj.invalid"
