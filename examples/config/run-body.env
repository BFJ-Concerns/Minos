# Deployment-static paths exported to the accountable run session.
MINOS_ENGINE_LAUNCH_LEAD="/opt/minos/run-body/launch-claude-lead"
MINOS_ENSEMBLE_LAUNCH="/opt/minos/run-body/launch-ensemble"
MINOS_PINS="/opt/minos/pins.toml"
MINOS_REVIEW_SCRIPTS="/opt/minos/review"
MINOS_WORKER_MODEL_POLICY="/opt/minos/worker-models.json"
MINOS_BIN="/usr/local/bin/minos"
MINOS_CLAUDE="/home/REPLACE_WITH_DEPLOYMENT_USER/.local/bin/claude"
MINOS_ENSEMBLE="/home/REPLACE_WITH_DEPLOYMENT_USER/.local/bin/ensemble"
MINOS_LIFECYCLE_INSTRUCTION="/opt/minos/lifecycle/lifecycle.md"
MINOS_FIX_SKILL="/opt/minos/skills/service/fix/SKILL.md"
MINOS_ROOT_CAUSE_SKILL="/opt/minos/skills/foundry/root-cause/SKILL.md"

# Repair attribution used by the accountable lifecycle. Model provenance stays
# in deployment evidence rather than entering the commit message.
MINOS_FIX_AUTHOR_NAME="Minos"
MINOS_FIX_AUTHOR_EMAIL="minos@example.invalid"
