#!/usr/bin/env python3
"""Account for a review inspection record against an immutable Git diff."""

import argparse
import json
import pathlib
import re
import subprocess
import sys


HUNK = re.compile(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@")
HUNK_FIELDS = ("old_start", "old_lines", "new_start", "new_lines")


class InputError(Exception):
    pass


def git(repo, *args, text=True):
    completed = subprocess.run(
        ["git", "-C", str(repo), *args], capture_output=True, text=text, check=False
    )
    if completed.returncode != 0:
        message = completed.stderr.strip() if text else completed.stderr.decode(errors="replace").strip()
        raise InputError(f"git {' '.join(args)}: {message}")
    return completed.stdout


def commit(repo, revision):
    return git(repo, "rev-parse", "--verify", f"{revision}^{{commit}}").strip()


def changed_files(repo, base, head):
    raw = git(repo, "diff", "--name-status", "-z", "--find-renames", base, head, text=False)
    fields = raw.decode("utf-8", errors="strict").split("\0")
    files = []
    index = 0
    while index < len(fields) and fields[index]:
        status = fields[index]
        index += 1
        if status.startswith(("R", "C")):
            old_path, path = fields[index], fields[index + 1]
            index += 2
        else:
            path = fields[index]
            old_path = path
            index += 1
        source_commit = base if status.startswith("D") else head
        source_path = old_path if status.startswith("D") else path
        blob = git(repo, "rev-parse", f"{source_commit}:{source_path}").strip()
        patch = git(
            repo, "diff", "--no-ext-diff", "--no-color", "--unified=0",
            "--find-renames", base, head, "--", old_path, path,
        )
        hunks = []
        for line in patch.splitlines():
            match = HUNK.match(line)
            if match:
                old_start, old_lines, new_start, new_lines = match.groups()
                hunks.append({
                    "old_start": int(old_start),
                    "old_lines": int(old_lines or 1),
                    "new_start": int(new_start),
                    "new_lines": int(new_lines or 1),
                })
        item = {"path": path, "blob": blob, "hunks": hunks}
        if old_path != path:
            item["old_path"] = old_path
        files.append(item)
    return files


def hunk_key(hunk):
    try:
        return tuple(int(hunk[field]) for field in HUNK_FIELDS)
    except (KeyError, TypeError, ValueError) as error:
        raise InputError(f"invalid hunk record: {hunk!r}") from error


def omission(kind, **details):
    return {"kind": kind, **details}


def validate_reference(repo, reference, allowed_commits):
    required = ("kind", "path", "commit", "blob", "line", "name", "line_text")
    if not isinstance(reference, dict) or any(field not in reference for field in required):
        raise InputError(f"reference requires {', '.join(required)}")
    if reference["kind"] not in ("definition", "call_site"):
        raise InputError("reference kind must be definition or call_site")
    if reference["commit"] not in allowed_commits:
        return omission(
            "reference_commit_mismatch", path=reference["path"], name=reference["name"],
            claimed_commit=reference["commit"], allowed_commits=sorted(allowed_commits),
        )
    try:
        expected_blob = git(repo, "rev-parse", f"{reference['commit']}:{reference['path']}").strip()
    except InputError:
        return omission("reference_not_found", path=reference["path"], name=reference["name"])
    if reference["blob"] != expected_blob:
        return omission(
            "reference_blob_mismatch", path=reference["path"], name=reference["name"],
            expected_blob=expected_blob, claimed_blob=reference["blob"],
        )
    try:
        line_number = int(reference["line"])
        content = git(repo, "show", f"{reference['blob']}").splitlines()
    except (TypeError, ValueError):
        return omission("reference_not_found", path=reference["path"], name=reference["name"])
    if (
        line_number < 1
        or line_number > len(content)
        or not isinstance(reference["line_text"], str)
        or content[line_number - 1] != reference["line_text"]
        or not isinstance(reference["name"], str)
        or not reference["name"]
        or re.search(
            rf"(?<![A-Za-z0-9_]){re.escape(reference['name'])}(?![A-Za-z0-9_])",
            content[line_number - 1],
        ) is None
    ):
        return omission(
            "reference_not_found", path=reference["path"], line=line_number,
            name=reference["name"], reference_kind=reference["kind"],
        )
    return None


def account(repo, base, head, record):
    inventory = changed_files(repo, base, head)
    expected_by_path = {item["path"]: item for item in inventory}
    omissions = []

    if record.get("schema_version") != 1:
        raise InputError("coverage record schema_version must be 1")
    if record.get("base_commit") != base or record.get("head_commit") != head:
        omissions.append(omission(
            "revision_mismatch", expected_base=base, claimed_base=record.get("base_commit"),
            expected_head=head, claimed_head=record.get("head_commit"),
        ))

    recorded_files = record.get("files")
    if not isinstance(recorded_files, list):
        raise InputError("coverage record files must be an array")
    by_path = {}
    for item in recorded_files:
        if not isinstance(item, dict) or not isinstance(item.get("path"), str):
            raise InputError("each coverage file requires a path")
        if item["path"] in by_path:
            raise InputError(f"duplicate coverage file: {item['path']}")
        by_path[item["path"]] = item
    for path in sorted(set(by_path) - set(expected_by_path)):
        omissions.append(omission("recorded_file_outside_diff", path=path))

    for expected in inventory:
        path = expected["path"]
        claimed = by_path.get(path)
        if claimed is None:
            omissions.append(omission("unaccounted_file", path=path))
            continue
        if claimed.get("blob") != expected["blob"]:
            omissions.append(omission(
                "blob_mismatch", path=path, expected_blob=expected["blob"],
                claimed_blob=claimed.get("blob"),
            ))
        if claimed.get("account") not in ("read", "omitted"):
            raise InputError(f"{path}: account must be read or omitted")
        if claimed["account"] == "omitted":
            omissions.append(omission("file_omitted", path=path))
        recorded_hunks = claimed.get("hunks")
        if not isinstance(recorded_hunks, list):
            raise InputError(f"{path}: hunks must be an array")
        recorded_by_key = {}
        for hunk in recorded_hunks:
            key = hunk_key(hunk)
            if key in recorded_by_key:
                raise InputError(f"{path}: duplicate hunk {key}")
            if hunk.get("account") not in ("read", "omitted"):
                raise InputError(f"{path}: hunk account must be read or omitted")
            recorded_by_key[key] = hunk
        expected_keys = {hunk_key(hunk) for hunk in expected["hunks"]}
        for key in sorted(set(recorded_by_key) - expected_keys):
            omissions.append(omission("recorded_hunk_outside_diff", path=path, hunk=dict(zip(HUNK_FIELDS, key))))
        for hunk in expected["hunks"]:
            key = hunk_key(hunk)
            recorded = recorded_by_key.get(key)
            if recorded is None:
                omissions.append(omission("unaccounted_hunk", path=path, hunk=hunk))
            elif recorded["account"] == "omitted":
                omissions.append(omission("hunk_omitted", path=path, hunk=hunk))

    references = record.get("references", [])
    if not isinstance(references, list):
        raise InputError("coverage record references must be an array")
    for reference in references:
        missing = validate_reference(repo, reference, {base, head})
        if missing:
            omissions.append(missing)

    return {
        "schema_version": 1,
        "status": "complete" if not omissions else "partial",
        "base_commit": base,
        "head_commit": head,
        "files_changed": len(inventory),
        "hunks_changed": sum(len(item["hunks"]) for item in inventory),
        "omissions": omissions,
    }


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", required=True)
    parser.add_argument("--base", required=True)
    parser.add_argument("--head", required=True)
    choice = parser.add_mutually_exclusive_group(required=True)
    choice.add_argument("--record")
    choice.add_argument("--inventory", action="store_true")
    args = parser.parse_args()
    try:
        repo = pathlib.Path(args.repo).resolve()
        base = commit(repo, args.base)
        head = commit(repo, args.head)
        if args.inventory:
            result = {
                "schema_version": 1, "base_commit": base, "head_commit": head,
                "files": changed_files(repo, base, head),
            }
            code = 0
        else:
            with open(args.record, encoding="utf-8") as source:
                record = json.load(source)
            result = account(repo, base, head, record)
            code = 0 if result["status"] == "complete" else 1
    except (InputError, OSError, json.JSONDecodeError) as error:
        result = {"schema_version": 1, "status": "error", "error": str(error)}
        code = 2
    json.dump(result, sys.stdout, sort_keys=True)
    sys.stdout.write("\n")
    return code


if __name__ == "__main__":
    raise SystemExit(main())
