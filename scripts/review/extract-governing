#!/usr/bin/env sh
set -eu

: "${PUMP19_WORKSPACE:?PUMP19_WORKSPACE is required}"
: "${PUMP19_RUN_DIR:?PUMP19_RUN_DIR is required}"
: "${PUMP19_BASE_REF:?PUMP19_BASE_REF is required}"
: "${PUMP19_BRIEFS:?PUMP19_BRIEFS is required}"

case "$PUMP19_BRIEFS" in
  /*|..|../*|*/../*|*/..)
    echo "PUMP19_BRIEFS must be a safe repository-relative path" >&2
    exit 2
    ;;
esac

ref="origin/$PUMP19_BASE_REF"
git -C "$PUMP19_WORKSPACE" rev-parse --verify "$ref^{commit}" >/dev/null

target="$PUMP19_RUN_DIR/governing"
tmp="$PUMP19_RUN_DIR/.governing.$$"
rm -rf "$tmp"
mkdir -p "$tmp"
cleanup() {
  rm -rf "$tmp"
}
trap cleanup EXIT HUP INT TERM

copy_blob() {
  path="$1"
  case "$path" in
    /*|..|../*|*/../*|*/..)
      echo "unsafe governing path: $path" >&2
      exit 2
      ;;
  esac
  mkdir -p "$tmp/$(dirname "$path")"
  git -C "$PUMP19_WORKSPACE" show "$ref:$path" >"$tmp/$path"
}

# Brief files are selected from the base tree. A brief introduced by the head
# is intentionally absent, because a change never governs its own review.
git -C "$PUMP19_WORKSPACE" ls-tree -r --name-only "$ref" -- "$PUMP19_BRIEFS" |
  while IFS= read -r path; do
    [ -n "$path" ] && copy_blob "$path"
  done

# Root and per-directory guidance use the same base-ref integrity rule.
git -C "$PUMP19_WORKSPACE" ls-tree -r --name-only "$ref" |
  while IFS= read -r path; do
    case "$path" in
      AGENTS.md|CLAUDE.md|*/AGENTS.md|*/CLAUDE.md) copy_blob "$path" ;;
    esac
  done

if [ -e "$target" ]; then
  chmod -R u+w "$target"
  rm -rf "$target"
fi
mv "$tmp" "$target"
trap - EXIT HUP INT TERM
find "$target" -type f -exec chmod 0444 {} +
find "$target" -type d -exec chmod 0555 {} +
printf '%s\n' "$target"
