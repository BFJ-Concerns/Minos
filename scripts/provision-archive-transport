#!/usr/bin/env sh
set -eu

usage() {
  echo "usage: provision-archive-transport client KNOWN_HOSTS_SOURCE CONFIG_DIR OWNER | destination PUBLIC_KEY DESTINATION AUTHORIZED_KEYS CLIENT_ADDRESS RECEIVER" >&2
  exit 2
}

mode="${1:-}"
case "$mode" in
  client)
    [ "$#" -eq 4 ] || usage
    known_hosts_source="$2"
    config_dir="$3"
    owner="$4"
    [ -s "$known_hosts_source" ] || {
      echo "provision-archive-transport: known-hosts source is missing or empty" >&2
      exit 1
    }
    install -d -m 0700 "$config_dir"
    install -m 0600 "$known_hosts_source" "$config_dir/known_hosts"
    if [ ! -f "$config_dir/id_ed25519" ]; then
      ssh-keygen -q -t ed25519 -N '' -f "$config_dir/id_ed25519"
    fi
    chmod 0600 "$config_dir/id_ed25519"
    chmod 0644 "$config_dir/id_ed25519.pub"
    chown -R "$owner" "$config_dir"
    ;;
  destination)
    # The key line is restricted at the server: no shell, no forwarding, one
    # source address, and a forced command that reaches only the archive
    # write and the sidecar listing over this destination (archive-receiver).
    # An earlier unrestricted line for the same key is replaced, so the key
    # never keeps a shell it once had.
    [ "$#" -eq 6 ] || usage
    public_key="$2"
    destination="$3"
    authorised_keys="$4"
    client_address="$5"
    receiver="$6"
    [ -s "$public_key" ] || {
      echo "provision-archive-transport: public key is missing or empty" >&2
      exit 1
    }
    case "$client_address$destination$receiver" in
      *'"'* | *"'"* | *'
'*)
        echo "provision-archive-transport: client address, destination and receiver must carry no quotes or newlines" >&2
        exit 1
        ;;
    esac
    install -d -m 0700 "$(dirname "$authorised_keys")"
    touch "$authorised_keys"
    chmod 0600 "$authorised_keys"
    key="$(sed -n '1p' "$public_key")"
    key_material="$(printf '%s\n' "$key" | awk '{print $1 " " $2}')"
    line="restrict,from=\"$client_address\",command=\"$receiver '$destination'\" $key"
    updated="$(grep -Fv -- "$key_material" "$authorised_keys" || true)"
    printf '%s\n' "$updated" | sed '/^$/d' >"$authorised_keys.next"
    printf '%s\n' "$line" >>"$authorised_keys.next"
    chmod 0600 "$authorised_keys.next"
    mv "$authorised_keys.next" "$authorised_keys"
    install -d -m 0700 "$destination"
    ;;
  *) usage ;;
esac
