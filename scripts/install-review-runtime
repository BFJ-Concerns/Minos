#!/usr/bin/env sh
set -eu

destination_root="${1:?usage: install-review-runtime DESTINATION_ROOT}"
script_dir="$(CDPATH= cd -- "$(dirname "$0")" && pwd)"
source_root="$(dirname "$script_dir")"

# Preflight: the box's tool versions are checked against the declared set
# before anything is installed, so a deploy cannot quietly land onto a box
# whose tools differ from the ones the gate ran against. The declared set
# is data (scripts/expected-tool-versions), one tab-separated line per
# tool: name, version command, expected token. `any` marks an accepted
# divergence — reported, never fatal — though a tool that is missing
# outright fails whatever the expectation says. Every mismatch is
# reported before the stop, naming the tool with both versions.
# MINOS_EXPECTED_TOOLS points a non-deploy invocation (the repository's
# own tests, which install for reasons other than deploying) at a fixture
# set; a deploy leaves it unset and gets the shipped declarations.
declared_tools="${MINOS_EXPECTED_TOOLS:-$source_root/scripts/expected-tool-versions}"
if [ ! -f "$declared_tools" ]; then
  echo "preflight: declared tool set missing: $declared_tools" >&2
  exit 1
fi
preflight_mismatches=0
while IFS="	" read -r tool version_command expected; do
  case "$tool" in ''|\#*) continue ;; esac
  if observed="$($version_command 2>&1)"; then
    observed="$(printf '%s\n' "$observed" | head -n 1)"
  else
    echo "preflight: $tool: mismatch — expected $expected, observed missing (${version_command%% *} not runnable)" >&2
    preflight_mismatches=$((preflight_mismatches + 1))
    continue
  fi
  if [ "$expected" = "any" ]; then
    echo "preflight: $tool: accepted divergence ($observed)"
    continue
  fi
  case "$observed" in
    *"$expected"*)
      echo "preflight: $tool: parity ($observed)"
      ;;
    *)
      echo "preflight: $tool: mismatch — expected $expected, observed $observed" >&2
      preflight_mismatches=$((preflight_mismatches + 1))
      ;;
  esac
done < "$declared_tools"
if [ "$preflight_mismatches" -gt 0 ]; then
  echo "preflight: $preflight_mismatches tool version mismatch(es); nothing installed" >&2
  exit 1
fi

install -d -m 755 "$destination_root/runtime"
install -m 644 "$source_root/runtime/ensemble.mjs" "$destination_root/runtime/ensemble.mjs"
install -m 644 "$source_root/runtime/ensemble.mjs.sha256" "$destination_root/runtime/ensemble.mjs.sha256"
install -m 644 "$source_root/runtime/ensemble.source-version" "$destination_root/runtime/ensemble.source-version"

(
  cd "$destination_root/runtime"
  sha256sum -c ensemble.mjs.sha256
)

# The workflow tree is built fresh and swapped into place, so a workflow
# deleted from the source tree is gone from the destination after the next
# install — copying over the old tree would leave orphans behind, and an
# orphaned workflow is live code on the box that no source file governs.
staging="$destination_root/workflows.next"
previous="$destination_root/workflows.previous"
rm -rf "$staging" "$staging.listing" "$previous"
install -d -m 755 "$staging"

# The source listing is written to a file first so a failing find stops
# the install under `set -e`: piped into the loop, its failure would be
# masked by the pipeline and an incomplete staging tree would replace
# the previous deployment.
listing="$staging.listing"
find "$source_root/workflows" -type f ! -name '*_test.mjs' -print > "$listing"

while IFS= read -r source; do
  relative_path="${source#"$source_root/workflows/"}"
  destination="$staging/$relative_path"
  install -d -m 755 "$(dirname "$destination")"
  if [ -x "$source" ]; then
    mode=755
  else
    mode=644
  fi
  install -m "$mode" "$source" "$destination"
done < "$listing"
rm -f "$listing"

if [ -d "$destination_root/workflows" ]; then
  mv "$destination_root/workflows" "$previous"
fi
mv "$staging" "$destination_root/workflows"
rm -rf "$previous"
