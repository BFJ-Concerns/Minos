#!/usr/bin/env sh
set -eu

destination_root="${1:?usage: install-review-runtime DESTINATION_ROOT}"
script_dir="$(CDPATH= cd -- "$(dirname "$0")" && pwd)"
source_root="$(dirname "$script_dir")"

# Preflight: every tool a run needs must be runnable before anything is
# installed. The declared set is data (scripts/expected-tool-versions), one
# tab-separated line per tool: name, version command, the version the
# repository gate tested against (`any` where none is pinned), and the
# tool's need — `required`, or `engine` for an engine CLI. A missing
# required tool stops the install; of the engine CLIs only one need be
# present, because a deployment may provision a single engine. A version
# other than the tested one is reported as a warning and installed over:
# the box's tools update on their own schedule, and the tested version is
# a reference point for diagnosing a drift, not a requirement. Version
# commands run from the repository root, so a declaration can name a file
# in the tree: the review runtime is declared that way, because it refuses
# to start on a Node below the floor it was built for and its refusal, not
# a version pin here, is what stops the install. Every problem is reported
# before the stop.
# MINOS_EXPECTED_TOOLS points a non-deploy invocation (the repository's
# own tests, which install for reasons other than deploying) at a fixture
# set; a deploy leaves it unset and gets the shipped declarations.
declared_tools="${MINOS_EXPECTED_TOOLS:-$source_root/scripts/expected-tool-versions}"
if [ ! -f "$declared_tools" ]; then
  echo "preflight: declared tool set missing: $declared_tools" >&2
  exit 1
fi
blockers=0
engine_names=""
engines_present=0
while IFS="	" read -r tool version_command tested need; do
  case "$tool" in ''|\#*) continue ;; esac
  case "$need" in
    required) ;;
    engine) engine_names="${engine_names:+$engine_names, }$tool" ;;
    *)
      echo "preflight: $declared_tools: $tool declares need '$need'; expected required or engine" >&2
      exit 1
      ;;
  esac
  # </dev/null keeps a stdin-reading version command from swallowing the
  # remaining declaration lines the loop is still reading.
  if ! observed="$(cd "$source_root" && $version_command < /dev/null 2>&1)"; then
    if [ "$need" = engine ]; then
      echo "preflight: $tool: not installed"
    else
      # The failing command's first line says why: the shell's own
      # not-found message for an absent tool, or the tool's refusal.
      echo "preflight: $tool: missing — $(printf '%s\n' "$observed" | head -n 1)" >&2
      blockers=$((blockers + 1))
    fi
    continue
  fi
  observed="$(printf '%s\n' "$observed" | head -n 1)"
  if [ "$need" = engine ]; then
    engines_present=$((engines_present + 1))
  fi
  if [ "$tested" = any ]; then
    echo "preflight: $tool: $observed"
    continue
  fi
  case "$observed" in
    *"$tested"*)
      echo "preflight: $tool: $observed (the tested version)"
      ;;
    *)
      echo "preflight: $tool: $observed — warning: the repository gate tested $tested" >&2
      ;;
  esac
done < "$declared_tools"
if [ -n "$engine_names" ] && [ "$engines_present" -eq 0 ]; then
  echo "preflight: no engine CLI installed; install at least one of: $engine_names" >&2
  blockers=$((blockers + 1))
fi
if [ "$blockers" -gt 0 ]; then
  echo "preflight: $blockers blocking problem(s); nothing installed" >&2
  exit 1
fi

install -d -m 755 "$destination_root/runtime"
install -m 644 "$source_root/runtime/ensemble.mjs" "$destination_root/runtime/ensemble.mjs"
install -m 644 "$source_root/runtime/ensemble.mjs.sha256" "$destination_root/runtime/ensemble.mjs.sha256"
install -m 644 "$source_root/runtime/ensemble.source-version" "$destination_root/runtime/ensemble.source-version"

(
  cd "$destination_root/runtime"
  sha256sum -c ensemble.mjs.sha256
)

# The workflow tree is built fresh and swapped into place, so a workflow
# deleted from the source tree is gone from the destination after the next
# install — copying over the old tree would leave orphans behind, and an
# orphaned workflow is live code on the box that no source file governs.
staging="$destination_root/workflows.next"
previous="$destination_root/workflows.previous"
rm -rf "$staging" "$staging.listing" "$previous"
install -d -m 755 "$staging"

# The source listing is written to a file first so a failing find stops
# the install under `set -e`: piped into the loop, its failure would be
# masked by the pipeline and an incomplete staging tree would replace
# the previous deployment.
listing="$staging.listing"
find "$source_root/workflows" -type f ! -name '*_test.mjs' -print > "$listing"

while IFS= read -r source; do
  relative_path="${source#"$source_root/workflows/"}"
  destination="$staging/$relative_path"
  install -d -m 755 "$(dirname "$destination")"
  if [ -x "$source" ]; then
    mode=755
  else
    mode=644
  fi
  install -m "$mode" "$source" "$destination"
done < "$listing"
rm -f "$listing"

if [ -d "$destination_root/workflows" ]; then
  mv "$destination_root/workflows" "$previous"
fi
mv "$staging" "$destination_root/workflows"
rm -rf "$previous"
