#!/usr/bin/env sh
set -eu
# Deterministic stand-in for the fix lead session. It walks the fix mission's
# mechanical tail — claim, read facts, land or decline, record the outcome — at
# zero model cost and authors no fix method. The scenario flag chooses landed vs
# fruitless for a writable head; writability itself is read honestly from the
# forge facts, so a fork fixture drives the unwritable path on its own.

: "${MINOS_BIN:=minos}"
: "${MINOS_CONFIG:?MINOS_CONFIG is required}"
: "${MINOS_RUN_DIR:?MINOS_RUN_DIR is required}"

standin_model=${MINOS_STANDIN_LEAD_MODEL:-claude-opus-pinned}
printf '{"type":"system","subtype":"init","model":"%s"}\n' "$standin_model"
cat >"$MINOS_RUN_DIR/mission.received.md"

claim=$("$MINOS_BIN" run-guard --config "$MINOS_CONFIG" begin)
case "$claim" in
  claimed) ;;
  yield-terminal|yield-head) printf '{"result":"%s"}\n' "$claim"; exit 0 ;;
  *) echo "unexpected run claim result: $claim" >&2; exit 2 ;;
esac
release() {
  "$MINOS_BIN" run-guard --config "$MINOS_CONFIG" release >/dev/null
}
trap release EXIT HUP INT TERM

require_current() {
  current=$("$MINOS_BIN" run-guard --config "$MINOS_CONFIG" current)
  case "$current" in
    current) ;;
    stale) exit 0 ;;
    *) echo "unexpected current guard result: $current" >&2; exit 2 ;;
  esac
}

# The capture wrapper validates the served model against the lead pin and writes
# this file; a fix that reaches here serves the pinned model.
while [ ! -s "$MINOS_RUN_DIR/resolved-lead.json" ]; do
  sleep 1
done
model=$(jq -r '.[0].resolved_model' "$MINOS_RUN_DIR/resolved-lead.json")

facts="$MINOS_RUN_DIR/pr-facts.txt"
"$MINOS_BIN" adapt get-pr-facts "$MINOS_OWNER" "$MINOS_REPO_NAME" "$MINOS_PR" >"$facts"
head_branch=$(sed -n 's/^HEAD_BRANCH=//p' "$facts")
head_repo=$(sed -n 's/^HEAD_REPO=//p' "$facts")
base_repo=$(sed -n 's/^BASE_REPO=//p' "$facts")

# The fix session reads its findings from the PR record; a stand-in only proves
# the seam, so it reads and discards them.
"$MINOS_BIN" adapt list-review-comments "$MINOS_OWNER" "$MINOS_REPO_NAME" "$MINOS_PR" >"$MINOS_RUN_DIR/findings.json"

outcome=unwritable
if [ -n "$head_branch" ] && [ "$head_repo" = "$base_repo" ]; then
  outcome=${MINOS_STANDIN_FIX_OUTCOME:-landed}
fi

if [ "$outcome" = landed ]; then
  # Edit the prepared workspace, then land through the credentialled adaptation —
  # never a push from inside the workspace. The adaptation reports the real
  # outcome as a stdout token: a protected head reports unwritable.
  printf 'fix applied by stand-in\n' >>"$MINOS_WORKSPACE/file.txt"
  printf 'Answer the standing finding.\n' >"$MINOS_RUN_DIR/fix-message.txt"
  require_current
  landed=$("$MINOS_BIN" adapt commit-push \
    "$MINOS_OWNER" "$MINOS_REPO_NAME" "$MINOS_PR" \
    "$head_branch" "$MINOS_FIX_AUTHOR_NAME" "$MINOS_FIX_AUTHOR_EMAIL" \
    "$model" "$MINOS_RUN_DIR/fix-message.txt")
  printf '%s\n' "$landed" >"$MINOS_RUN_DIR/commit-push.out"
  case $(printf '%s' "$landed" | awk 'NR==1{print $1}') in
    landed) outcome=landed ;;
    fruitless) outcome=fruitless ;;
    unwritable) outcome=unwritable ;;
    *) echo "unexpected commit-push token: $landed" >&2; exit 2 ;;
  esac
fi

marker=$("$MINOS_BIN" marker format head="$MINOS_HEAD_SHA" outcome="$outcome" run=fix)
{
  printf 'Minos fix stand-in. Outcome: %s.\n\n' "$outcome"
  printf '%s\n' "$marker"
} >"$MINOS_RUN_DIR/fix-summary.md"

# A landed fix has moved the head; its record binds to the head the fix acted
# against and needs no further current check. The other outcomes moved no head.
case "$outcome" in
  landed) ;;
  *) require_current ;;
esac
"$MINOS_BIN" adapt post-comment \
  "$MINOS_OWNER" "$MINOS_REPO_NAME" "$MINOS_PR" "$MINOS_RUN_DIR/fix-summary.md" >/dev/null
"$MINOS_BIN" adapt set-status \
  "$MINOS_OWNER" "$MINOS_REPO_NAME" "$MINOS_HEAD_SHA" \
  minos/fix success "Minos fix completed: $outcome" >/dev/null
release
trap - EXIT HUP INT TERM

# Per-finding acknowledgements are reader-facing follow-up, not outcome state.
# Stale anchors or transient forge failures are retained in run.log without
# turning an already-landed and recorded fix into a failed run.
if [ "$outcome" = landed ]; then
  landed_sha=$(printf '%s' "$landed" | awk 'NR==1{print $2}')
  jq -c '.[] | select(.body | contains("finding=F-FIXED"))' "$MINOS_RUN_DIR/findings.json" |
    while IFS= read -r finding; do
      review_id=$(printf '%s' "$finding" | jq -r '.review_id')
      path=$(printf '%s' "$finding" | jq -r '.path')
      new_position=$(printf '%s' "$finding" | jq -r '.new_position')
      old_position=$(printf '%s' "$finding" | jq -r '.old_position')
      body="$MINOS_RUN_DIR/fixed-$review_id.md"
      printf 'fixed in `%s`\n' "$landed_sha" >"$body"
      if ! "$MINOS_BIN" adapt post-review-comment \
        "$MINOS_OWNER" "$MINOS_REPO_NAME" "$MINOS_PR" \
        "$review_id" "$path" "$new_position" "$old_position" "$body" >/dev/null; then
        printf 'per-finding acknowledgement failed for review %s\n' "$review_id" >>"$MINOS_RUN_DIR/run.log"
      fi
    done
fi

printf '{"type":"assistant","message":{"model":"%s"}}\n' "$standin_model"
printf '{"type":"result","subtype":"success","modelUsage":{"%s":{}}}\n' "$standin_model"
