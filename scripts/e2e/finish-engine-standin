#!/usr/bin/env sh
set -eu
# Deterministic stand-in for the finish lead session. It walks the finish
# mission's gate in order — build, test, maintenance, current, forge-mergeable,
# merge — and records merged or the first refusal as machine state. It authors
# no finish method; the gate is honest to the fixture's build/test commands and
# the forge's mergeable fact, so a scenario is chosen by the fixture, not faked.

: "${PUMP19_BIN:=pump19}"
: "${PUMP19_CONFIG:?PUMP19_CONFIG is required}"
: "${PUMP19_RUN_DIR:?PUMP19_RUN_DIR is required}"

standin_model=${PUMP19_STANDIN_LEAD_MODEL:-claude-opus-pinned}
printf '{"type":"system","subtype":"init","model":"%s"}\n' "$standin_model"
cat >"$PUMP19_RUN_DIR/mission.received.md"

claim=$("$PUMP19_BIN" run-guard --config "$PUMP19_CONFIG" begin)
case "$claim" in
  claimed) ;;
  yield-terminal|yield-head) printf '{"result":"%s"}\n' "$claim"; exit 0 ;;
  *) echo "unexpected run claim result: $claim" >&2; exit 2 ;;
esac
release() {
  "$PUMP19_BIN" run-guard --config "$PUMP19_CONFIG" release >/dev/null
}
trap release EXIT HUP INT TERM

while [ ! -s "$PUMP19_RUN_DIR/resolved-lead.json" ]; do
  sleep 1
done
model=$(jq -r '.[0].resolved_model' "$PUMP19_RUN_DIR/resolved-lead.json")

facts="$PUMP19_RUN_DIR/pr-facts.txt"
"$PUMP19_BIN" adapt get-pr-facts "$PUMP19_OWNER" "$PUMP19_REPO_NAME" "$PUMP19_PR" >"$facts"
head_branch=$(sed -n 's/^HEAD_BRANCH=//p' "$facts")
mergeable=$(sed -n 's/^MERGEABLE=//p' "$facts")

# Eligibility: the latest review on the *current* head. APPROVED is clean,
# REQUEST_CHANGES is a standing-findings verdict the finish label overrides
# (flagged); anything else — partial coverage, no review, errored — is not a
# state the finish label may override.
"$PUMP19_BIN" adapt list-reviews "$PUMP19_OWNER" "$PUMP19_REPO_NAME" "$PUMP19_PR" >"$PUMP19_RUN_DIR/reviews.json"
head_state=$(jq -r --arg head "$PUMP19_HEAD_SHA" \
  '[.[] | select(.commit_id == $head)] | last | .state // "none"' \
  "$PUMP19_RUN_DIR/reviews.json")

outcome=merged
reason=""
finish() {
  outcome="$1"
  reason="${2:-}"
}

# The gate, in order. Stop at the first failure.
case "$head_state" in
  APPROVED|REQUEST_CHANGES) ;;
  *) finish refused not-eligible ;;
esac
if [ "$outcome" != merged ]; then
  :
elif ! "$PUMP19_BIN" ws-exec --config "$PUMP19_CONFIG" -- sh -c "$PUMP19_BUILD_CMD"; then
  finish refused build-failed
elif ! "$PUMP19_BIN" ws-exec --config "$PUMP19_CONFIG" -- sh -c "$PUMP19_TEST_CMD"; then
  finish refused test-failed
elif [ "${PUMP19_STANDIN_MAINTENANCE:-0}" = 1 ]; then
  # Maintenance changed the tree; it must be reviewed before it can merge.
  printf 'maintenance by stand-in\n' >>"$PUMP19_WORKSPACE/file.txt"
  printf 'Occasion maintenance.\n' >"$PUMP19_RUN_DIR/maint-message.txt"
  "$PUMP19_BIN" adapt commit-push \
    "$PUMP19_OWNER" "$PUMP19_REPO_NAME" "$PUMP19_PR" \
    "$head_branch" "$PUMP19_FIX_AUTHOR_NAME" "$PUMP19_FIX_AUTHOR_EMAIL" \
    "$model" "$PUMP19_RUN_DIR/maint-message.txt" >/dev/null
  finish refused review-pending
else
  current=$("$PUMP19_BIN" run-guard --config "$PUMP19_CONFIG" current)
  if [ "$current" != current ]; then
    finish refused not-current
  elif [ "$mergeable" != true ]; then
    finish refused not-mergeable
  elif ! "$PUMP19_BIN" adapt merge "$PUMP19_OWNER" "$PUMP19_REPO_NAME" "$PUMP19_PR" merge >/dev/null 2>&1; then
    finish refused not-mergeable
  fi
fi

if [ "$outcome" = merged ]; then
  marker=$("$PUMP19_BIN" marker format head="$PUMP19_HEAD_SHA" outcome=merged run=finish)
  status_state=success
else
  marker=$("$PUMP19_BIN" marker format head="$PUMP19_HEAD_SHA" outcome=refused reason="$reason" run=finish)
  status_state=failure
fi
{
  printf 'Pump-19 finish stand-in. Outcome: %s%s. Model: %s.\n\n' \
    "$outcome" "${reason:+ ($reason)}" "$model"
  printf '%s\n' "$marker"
} >"$PUMP19_RUN_DIR/finish-summary.md"

if [ "$outcome" = merged ]; then
  # The finish label is consumed by the merge; a refused finish leaves it sticky
  # for the next attempt.
  "$PUMP19_BIN" adapt remove-label "$PUMP19_OWNER" "$PUMP19_REPO_NAME" "$PUMP19_PR" Ready >/dev/null
fi
"$PUMP19_BIN" adapt post-comment \
  "$PUMP19_OWNER" "$PUMP19_REPO_NAME" "$PUMP19_PR" "$PUMP19_RUN_DIR/finish-summary.md" >/dev/null
"$PUMP19_BIN" adapt set-status \
  "$PUMP19_OWNER" "$PUMP19_REPO_NAME" "$PUMP19_HEAD_SHA" \
  pump19/finish "$status_state" "Pump-19 finish: $outcome" >/dev/null

printf '{"type":"assistant","message":{"model":"%s"}}\n' "$standin_model"
printf '{"type":"result","subtype":"success","modelUsage":{"%s":{}}}\n' "$standin_model"
