#!/usr/bin/env sh
set -eu
# Deterministic stand-in for the flaky-repair lead. It proves the mission's
# service mechanics at zero model cost; the synced root-cause skill owns the
# quality of a real diagnosis.

: "${MINOS_BIN:=minos}"
: "${MINOS_CONFIG:?MINOS_CONFIG is required}"
: "${MINOS_RUN_DIR:?MINOS_RUN_DIR is required}"

standin_model=${MINOS_STANDIN_LEAD_MODEL:-claude-opus-pinned}
printf '{"type":"system","subtype":"init","model":"%s"}\n' "$standin_model"
cat >"$MINOS_RUN_DIR/mission.received.md"
printf '%s\n' "$MINOS_SKILL" >"$MINOS_RUN_DIR/skill.path"

claim=$("$MINOS_BIN" run-guard --config "$MINOS_CONFIG" begin)
case "$claim" in
  claimed) ;;
  yield-terminal|yield-head) printf '{"result":"%s"}\n' "$claim"; exit 0 ;;
  *) echo "unexpected run claim result: $claim" >&2; exit 2 ;;
esac
released=0
release() {
  if [ "$released" = 0 ]; then
    "$MINOS_BIN" run-guard --config "$MINOS_CONFIG" release >/dev/null
  fi
}
trap release EXIT HUP INT TERM

while [ ! -s "$MINOS_RUN_DIR/resolved-lead.json" ]; do
  sleep 1
done
model=$(jq -r '.[0].resolved_model' "$MINOS_RUN_DIR/resolved-lead.json")

facts="$MINOS_RUN_DIR/pr-facts.txt"
"$MINOS_BIN" adapt get-pr-facts "$MINOS_OWNER" "$MINOS_REPO_NAME" "$MINOS_PR" >"$facts"
head_branch=$(sed -n 's/^HEAD_BRANCH=//p' "$facts")
head_repo=$(sed -n 's/^HEAD_REPO=//p' "$facts")
base_repo=$(sed -n 's/^BASE_REPO=//p' "$facts")
labels=$(sed -n 's/^LABELS=//p' "$facts")
case ",$labels," in
  *,"Flaky Tests",*) ;;
  *)
    printf 'Minos flaky outcome: withdrawn; standing label is absent\n' >>"$MINOS_RUN_DIR/run.log"
    exit 0
    ;;
esac

outcome=${MINOS_STANDIN_FLAKY_OUTCOME:-landed}
if [ -z "$head_branch" ] || [ "$head_repo" != "$base_repo" ]; then
  outcome=unwritable
fi

if [ "$outcome" = failed ]; then
  printf 'Minos flaky outcome: failed; evidence remains private\n' >>"$MINOS_RUN_DIR/run.log"
  exit 9
fi

if [ "$outcome" = landed ] || [ "$outcome" = fruitless ]; then
  if [ "$outcome" = landed ]; then
    printf 'flaky repair applied by stand-in\n' >>"$MINOS_WORKSPACE/file.txt"
  fi
  printf 'Repair the proven flaky-test cause.\n' >"$MINOS_RUN_DIR/flaky-message.txt"
  current=$("$MINOS_BIN" run-guard --config "$MINOS_CONFIG" current)
  [ "$current" = current ] || exit 0
  result=$("$MINOS_BIN" adapt commit-push \
    "$MINOS_OWNER" "$MINOS_REPO_NAME" "$MINOS_PR" \
    "$head_branch" "$MINOS_FIX_AUTHOR_NAME" "$MINOS_FIX_AUTHOR_EMAIL" \
    "$model" "$MINOS_RUN_DIR/flaky-message.txt")
  printf '%s\n' "$result" >"$MINOS_RUN_DIR/commit-push.out"
  outcome=$(printf '%s' "$result" | awk 'NR==1{print $1}')
  case "$outcome" in
    landed|fruitless|unwritable) ;;
    *) echo "unexpected commit-push token: $result" >&2; exit 2 ;;
  esac
fi

marker=$("$MINOS_BIN" marker format head="$MINOS_HEAD_SHA" outcome="$outcome" run=flaky)
{
  printf 'Minos flaky stand-in. Test: fixture::intermittent. Outcome: %s.\n\n' "$outcome"
  printf '%s\n' "$marker"
} >"$MINOS_RUN_DIR/flaky-summary.md"
printf 'Minos flaky outcome: %s; evidence recorded in %s\n' "$outcome" "$MINOS_RUN_DIR/flaky-summary.md" >>"$MINOS_RUN_DIR/run.log"

if [ "$outcome" != landed ]; then
  printf '{"type":"assistant","message":{"model":"%s"}}\n' "$standin_model"
  printf '{"type":"result","subtype":"success","modelUsage":{"%s":{}}}\n' "$standin_model"
  exit 0
fi

"$MINOS_BIN" adapt post-comment \
  "$MINOS_OWNER" "$MINOS_REPO_NAME" "$MINOS_PR" "$MINOS_RUN_DIR/flaky-summary.md" >/dev/null
"$MINOS_BIN" adapt set-status \
  "$MINOS_OWNER" "$MINOS_REPO_NAME" "$MINOS_HEAD_SHA" \
  minos/flaky success "Minos flaky-test repair landed" >/dev/null

# Release the liveness claim before removing the standing pause. There is no
# forge write after Flaky Tests: its removal is observably the terminal act.
"$MINOS_BIN" run-guard --config "$MINOS_CONFIG" release >/dev/null
released=1
"$MINOS_BIN" adapt remove-label \
  "$MINOS_OWNER" "$MINOS_REPO_NAME" "$MINOS_PR" "Flaky Tests" >/dev/null

printf '{"type":"assistant","message":{"model":"%s"}}\n' "$standin_model"
printf '{"type":"result","subtype":"success","modelUsage":{"%s":{}}}\n' "$standin_model"
