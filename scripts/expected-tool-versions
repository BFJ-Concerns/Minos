# Tools checked by install-review-runtime before it installs anything.
# Tab-separated fields: name, version command, recommended version range,
# and need (`required` or `engine`). Ranges are open-ended minimums
# (`>=MAJOR.MINOR.PATCH`); `any` accepts every version. An older or
# unrecognised version draws a warning, never a stop. Required tools must
# run; at least one engine CLI must run. Commands run from the source root.
# The review runtime enforces its own Node minimum. Capability probes such
# as jq --argjson check the options the run actually needs.
jq	jq --version	>=1.8.2	required
jq --argjson	jq --argjson probe 1 -n $probe	any	required
node	node --version	>=26.12.0	required
review-runtime	node runtime/ensemble.mjs --version	any	required
git	git --version	any	required
bash	bash --version	any	required
curl	curl --version	any	required
openssl	openssl version	any	required
ssh	ssh -V	any	required
tar	tar --version	any	required
zstd	zstd --version	any	required
sha256sum	sha256sum --version	any	required
find	find --version	any	required
claude	claude --version	>=2.1.300	engine
codex	codex --version	>=0.162.1	engine
