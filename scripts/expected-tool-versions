# The tools a run needs on the box, checked by install-review-runtime
# before it installs anything. One tab-separated line per tool: name, the
# command that reports its version, the version the repository gate tested
# against (a token that appears in the first line of that command's
# output, or `any` where none is pinned), and the tool's need. `required`
# tools must be present; of the `engine` CLIs, at least one must be. A
# version other than the tested one draws a warning, never a stop. Update
# a tested version when the gate's own toolchain moves.
jq	jq --version	jq-1.8.2	required
node	node --version	v24.14.0	required
git	git --version	any	required
bash	bash --version	any	required
curl	curl --version	any	required
openssl	openssl version	any	required
ssh	ssh -V	any	required
tar	tar --version	any	required
zstd	zstd --version	any	required
sha256sum	sha256sum --version	any	required
find	find --version	any	required
claude	claude --version	2.1.251	engine
codex	codex --version	codex-cli 0.151.0	engine
