#!/usr/bin/env sh
set -eu

if [ "$#" -ne 1 ]; then
  echo "usage: memory-telemetry OUTPUT_FILE" >&2
  exit 2
fi
output="$1"

# shellcheck source=scripts/run-body/cgroup-memory.sh
. "$(CDPATH= cd -- "$(dirname "$0")" && pwd)/cgroup-memory.sh"

# One honest memory snapshot of the calling process's own cgroup: anonymous
# footprint and swap, PSI stall totals, and workingset refaults. memory.current
# is deliberately absent — it counts page cache, which builds inflate to any
# ceiling and the kernel reclaims on demand (see AGENTS.md, memory accounting).
# Written at run start and again before the timing record is assembled, so the
# record can carry the run's stall and thrash deltas. Best-effort residue: an
# unreadable cgroup writes nothing and exits clean.
resolve_cgroup_dir
for counter_file in memory.stat memory.pressure; do
  [ -r "$cgroup_dir/$counter_file" ] || exit 0
done

sampled_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
read_cgroup_memory_counters

jq -n \
  --arg sampled_at "$sampled_at" \
  --arg anon "$cgroup_anon" --arg swap "$cgroup_swap" \
  --arg stall_some_us "$cgroup_stall_some_us" --arg stall_full_us "$cgroup_stall_full_us" \
  --arg refault_anon "$cgroup_refault_anon" --arg refault_file "$cgroup_refault_file" \
  '{kind: "minos-memory-snapshot-v1", sampled_at: $sampled_at}
   + ([["anon", $anon], ["swap", $swap],
       ["stall_some_us", $stall_some_us], ["stall_full_us", $stall_full_us],
       ["refault_anon", $refault_anon], ["refault_file", $refault_file]]
      | map(select(.[1] | test("^[0-9]+$")) | {(.[0]): (.[1] | tonumber)})
      | add // {})' >"${output}.tmp"
mv "${output}.tmp" "$output"
