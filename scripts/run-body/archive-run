#!/usr/bin/env bash
set -uo pipefail

run_dir="${1:-}"
label="${2:-run}"
config="${MINOS_ARCHIVE_CONFIG:-/etc/minos/archive.env}"

archive_failed() {
  printf 'minos: could not archive run evidence for %s\n' "$label" >&2
  exit 1
}

[ -d "$run_dir" ] || archive_failed
[ -r "$config" ] || archive_failed

set -a
# shellcheck source=/dev/null
. "$config" 2>/dev/null || archive_failed
set +a

[ -n "${MINOS_ARCHIVE_HOST:-}" ] || archive_failed
[ -r "${MINOS_ARCHIVE_IDENTITY_FILE:-}" ] || archive_failed
[ -r "${MINOS_ARCHIVE_KNOWN_HOSTS:-}" ] || archive_failed

safe_label="$(printf '%s' "$label" | tr -c 'A-Za-z0-9_.-' '-')"
run_name="$(basename "$run_dir")"
safe_run_name="$(printf '%s' "$run_name" | tr -c 'A-Za-z0-9_.-' '-')"
timestamp="$(date -u '+%Y%m%dT%H%M%SZ' 2>/dev/null)" || archive_failed
archive_name="${timestamp}-${safe_label}-${safe_run_name}.tar.zst"

# shellcheck source=scripts/run-body/archive-transport.sh
. "$(CDPATH= cd -- "$(dirname "$0")" && pwd)/archive-transport.sh"

# Delivering one run costs four calls — the archive stream and its commit,
# then the sidecar's — seconds apart. They share a connection under this
# run's own tag, and the persistence is short because nothing follows them.
# The archive host's receiver lands a stream beside the final name and
# promotes it only on this side's explicit commit, sent once the pipeline
# feeding it has succeeded: a stream cut short by a failure here is never
# promoted by the far side's reading of end-of-file.
archive_transport_open "run-$$" 30

# The timing record is presentation-class telemetry: assemble it from the
# run's event log and Ensemble records before the tarball is built, so the
# archive carries it too, but never let its failure fail the archive. The
# closing memory snapshot lands first so the record can carry the run's
# stall and thrash deltas against the baseline run-body took at start.
"$(CDPATH= cd -- "$(dirname "$0")" && pwd)/memory-telemetry" \
  "$run_dir/memory-final.json" || true
"$(CDPATH= cd -- "$(dirname "$0")" && pwd)/collect-timings" \
  "$run_dir" "$run_dir/timing-record.json" || true

# The breakdown belongs in the static sidecar, not on the status request that
# reads it.  A malformed or unavailable transcript leaves the ordinary timing
# record intact: archive delivery remains best-effort telemetry.
if [ -r "$run_dir/timing-record.json" ]; then
  analysed_record="$run_dir/timing-record.analysed.json"
  if "$(CDPATH= cd -- "$(dirname "$0")" && pwd)/analyse-archived-spans" \
    "$run_dir/timing-record.json" "$run_dir" >"$analysed_record" 2>/dev/null; then
    mv "$analysed_record" "$run_dir/timing-record.json"
  else
    rm -f "$analysed_record"
  fi
fi

(
  cd "$run_dir" || exit 1
  find . -type f \( \
    -path './run-report.md' -o -path './report.md' -o -path './failure.log' -o -path './failures.log' -o \
    -path './home/.claude/projects/*' -o -path './home/.codex/sessions/*.jsonl' -o \
    -path './ensemble-records/*' -o -path './loop-record.json' -o \
    -path './timings.ndjson' -o -path './timing-record.json' -o -path './cgroup-death-evidence' \
  \) -print0 2>/dev/null |
    tar --null --files-from=- -cf - 2>/dev/null |
    zstd -q -T0 -c 2>/dev/null |
    archive_ssh "receive $archive_name" >/dev/null 2>&1 || exit 1
  archive_ssh "commit $archive_name" >/dev/null 2>&1 || exit 1
) || archive_failed

# Deliver the timing record as a sidecar beside the tarball, readable
# without extracting the archive. Best-effort: a failed sidecar warns and
# never fails an archive that has already been promoted.
if [ -r "$run_dir/timing-record.json" ]; then
  sidecar_name="${archive_name%.tar.zst}.timings.json"
  if archive_ssh "receive $sidecar_name" <"$run_dir/timing-record.json" >/dev/null 2>&1 &&
    archive_ssh "commit $sidecar_name" >/dev/null 2>&1; then
    :
  else
    printf 'minos: could not deliver the timing sidecar for %s\n' "$label" >&2
  fi
fi
