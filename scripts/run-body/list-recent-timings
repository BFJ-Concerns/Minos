#!/usr/bin/env sh
# List the timing sidecars archive-run has delivered since a cutoff, newest
# first, as one line per record: the sidecar's filename, a tab, and its
# contents base64-encoded.
#
# The encoding is what makes the framing unambiguous — a timing record is
# pretty-printed JSON spanning many lines, and an agent's label or model is
# free text, so no plain delimiter can be trusted not to appear inside one.
#
# The archive host's receiver owns the listing: archive names begin with a
# UTC timestamp in ISO basic form, which sorts lexically in time order, so
# the cutoff travels as a string and no date arithmetic happens anywhere.
set -eu

cutoff="${1:-}"
limit="${2:-60}"
config="${MINOS_ARCHIVE_CONFIG:-/etc/minos/archive.env}"

fail() {
  printf 'minos: could not list archived timing records: %s\n' "$1" >&2
  exit 1
}

[ -n "$cutoff" ] || fail "no cutoff given"
[ -r "$config" ] || fail "archive configuration is unreadable"

set -a
# shellcheck source=/dev/null
. "$config" 2>/dev/null || fail "archive configuration could not be read"
set +a

[ -n "${MINOS_ARCHIVE_HOST:-}" ] || fail "no archive host configured"
[ -r "${MINOS_ARCHIVE_IDENTITY_FILE:-}" ] || fail "archive identity is unreadable"
[ -r "${MINOS_ARCHIVE_KNOWN_HOSTS:-}" ] || fail "archive known-hosts file is unreadable"

# The cutoff and limit travel as words of the receiver's request, which
# admits alphanumerics only; anything else is refused here before a call.
case "$cutoff$limit" in
  *[!0-9A-Za-z]*) fail "cutoff and limit must be alphanumeric" ;;
esac

# shellcheck source=scripts/run-body/archive-transport.sh
. "$(CDPATH= cd -- "$(dirname "$0")" && pwd)/archive-transport.sh"

# A listing is short and repeats: the operator surface asks again every few
# minutes. Persistence outlasts that gap, so a steady caller holds one session
# open instead of announcing itself to the archive host on every poll.
archive_transport_open listing 600

archive_ssh "list $cutoff $limit" || fail "the archive host could not be reached"
