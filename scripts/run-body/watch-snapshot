#!/usr/bin/env sh
set -eu

: "${MINOS_BIN:?MINOS_BIN is required}"

baseline="$1"
timeout_seconds="${2:-600}"
interval_seconds="${3:-5}"

case "$timeout_seconds" in *[!0-9]*|'') echo "watch-snapshot: timeout must be whole seconds" >&2; exit 1 ;; esac
case "$interval_seconds" in *[!0-9]*|'') echo "watch-snapshot: interval must be whole seconds" >&2; exit 1 ;; esac

if ! jq -e 'type == "object"' "$baseline" >/dev/null 2>&1; then
  echo "watch-snapshot: baseline is not a snapshot object" >&2
  exit 1
fi

current="$(mktemp)"
trap 'rm -f "$current"' 0
trap 'exit 129' 1
trap 'exit 130' 2
trap 'exit 143' 15
started="$(date +%s)"

snapshot_key() {
  jq -cS '{head_sha,target_sha,statuses,labels}' "$1"
}
baseline_key="$(snapshot_key "$baseline")"

while :; do
  "$MINOS_BIN" forge snapshot >"$current"
  if ! jq -e 'type == "object"' "$current" >/dev/null 2>&1; then
    echo "watch-snapshot: fresh snapshot is not an object" >&2
    exit 1
  fi
  if [ "$(snapshot_key "$current")" != "$baseline_key" ]; then
    jq -nc --slurpfile snapshot "$current" '{outcome:"changed",snapshot:$snapshot[0]}'
    exit 0
  fi
  now="$(date +%s)"
  if [ $((now - started)) -ge "$timeout_seconds" ]; then
    jq -nc --slurpfile snapshot "$current" '{outcome:"timeout",snapshot:$snapshot[0]}'
    exit 0
  fi
  sleep "$interval_seconds"
done
