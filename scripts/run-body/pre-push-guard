#!/usr/bin/env sh
set -eu

common_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
common_dir_resolved="$(CDPATH= cd -P -- "$common_dir" && pwd -P)"
unpushable_file="${common_dir}/minos-unpushable"
protected_ref_file="${common_dir}/minos-protected-ref"
protected_ref=""
controlled_permit=""
expected_permitted_update=""

permit_is_in_common_dir() {
  permit_path="$1"
  permit_parent="$(dirname "$permit_path")"
  permit_parent_resolved="$(CDPATH= cd -P -- "$permit_parent" 2>/dev/null && pwd -P)" || return 1
  [ "$permit_parent_resolved" = "$common_dir_resolved" ] && [ ! -L "$permit_path" ]
}

if [ -e "$protected_ref_file" ]; then
  if [ ! -f "$protected_ref_file" ] || [ ! -r "$protected_ref_file" ]; then
    echo "pre-push-guard: protected-ref record is present but unreadable: $protected_ref_file" >&2
    exit 1
  fi
  protected_ref="$(cat "$protected_ref_file")"
  case "$protected_ref" in
    refs/heads/?*) ;;
    *)
      echo "pre-push-guard: protected-ref record is invalid: ${protected_ref:-<empty>}" >&2
      exit 1
      ;;
  esac
  if ! git check-ref-format "$protected_ref"; then
    echo "pre-push-guard: protected-ref record is invalid: $protected_ref" >&2
    exit 1
  fi
fi

if [ -e "$unpushable_file" ]; then
  if [ ! -f "$unpushable_file" ] || [ ! -r "$unpushable_file" ]; then
    echo "pre-push-guard: reconciliation record is present but unreadable: $unpushable_file" >&2
    exit 1
  fi
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    0000000000000000000000000000000000000000) ;;
    *)
      if [ -e "$unpushable_file" ]; then
        while IFS= read -r recorded_sha || [ -n "$recorded_sha" ]; do
          if ! printf '%s\n' "$recorded_sha" | grep -Eq '^[0-9a-fA-F]{40}$'; then
            echo "pre-push-guard: reconciliation record contains an invalid commit: ${recorded_sha:-<empty>}" >&2
            exit 1
          fi
          if ! git cat-file -e "${recorded_sha}^{commit}" 2>/dev/null; then
            echo "pre-push-guard: reconciliation record names an unavailable commit: $recorded_sha" >&2
            exit 1
          fi
          if git merge-base --is-ancestor "$recorded_sha" "$local_sha"; then
            echo "pre-push-guard: refusing to push $local_ref ($local_sha): it contains local reconciliation commit $recorded_sha; local reconciliation commits and their ancestry must never be pushed" >&2
            exit 1
          else
            ancestor_status=$?
            if [ "$ancestor_status" -ne 1 ]; then
              echo "pre-push-guard: could not compare reconciliation commit $recorded_sha with $local_sha" >&2
              exit 1
            fi
          fi
        done <"$unpushable_file"
      fi
      ;;
  esac

  if [ -n "$protected_ref" ] && [ "$remote_ref" = "$protected_ref" ]; then
    integrate_permit="${MINOS_INTEGRATE_WAVE_PUSH_PERMIT:-}"
    sync_permit="${MINOS_SYNC_TARGET_PUSH_PERMIT:-}"
    if [ -n "$integrate_permit" ] && [ -n "$sync_permit" ]; then
      echo "pre-push-guard: refusing to update $remote_ref to $local_sha: multiple controlled-push permits were supplied" >&2
      exit 1
    elif [ -n "$integrate_permit" ]; then
      permit="$integrate_permit"
      expected_permitted_update="$remote_ref $local_sha"
      case "$permit" in
        "$common_dir"/minos-integrate-wave-push.*)
          permit_is_in_common_dir "$permit" || {
            echo "pre-push-guard: refusing to update $remote_ref to $local_sha: the integrate-wave push permit is outside the shared Git directory" >&2
            exit 1
          }
          ;;
        *)
          echo "pre-push-guard: refusing to update $remote_ref to $local_sha: the integrate-wave push permit is outside the shared Git directory" >&2
          exit 1
          ;;
      esac
    elif [ -n "$sync_permit" ]; then
      permit="$sync_permit"
      expected_permitted_update="$remote_ref $local_sha $remote_sha"
      case "$permit" in
        "$common_dir"/minos-sync-target-push.*)
          permit_is_in_common_dir "$permit" || {
            echo "pre-push-guard: refusing to update $remote_ref to $local_sha: the sync-target push permit is outside the shared Git directory" >&2
            exit 1
          }
          ;;
        *)
          echo "pre-push-guard: refusing to update $remote_ref to $local_sha: the sync-target push permit is outside the shared Git directory" >&2
          exit 1
          ;;
      esac
    else
      echo "pre-push-guard: refusing to update $remote_ref to $local_sha: worker fixes must be routed through workflows/integrate-wave; finishing syncs must use scripts/run-body/sync-target" >&2
      exit 1
    fi

    if [ ! -e "$permit" ]; then
      echo "pre-push-guard: refusing to update $remote_ref to $local_sha: the controlled-push permit is absent or already used" >&2
      exit 1
    fi
    if [ ! -f "$permit" ] || [ ! -r "$permit" ]; then
      echo "pre-push-guard: refusing to update $remote_ref to $local_sha: the controlled-push permit is unreadable" >&2
      exit 1
    fi
    if ! recorded_permitted_update="$(cat "$permit")"; then
      echo "pre-push-guard: refusing to update $remote_ref to $local_sha: the controlled-push permit could not be read" >&2
      exit 1
    fi
    if [ "$recorded_permitted_update" != "$expected_permitted_update" ]; then
      echo "pre-push-guard: refusing to update $remote_ref to $local_sha: the controlled-push permit authorises a different ref update" >&2
      exit 1
    fi
    controlled_permit="$permit"
  fi
done

if [ -n "$controlled_permit" ]; then
  claimed_permit="${controlled_permit}.claimed.$$"
  if ! mv "$controlled_permit" "$claimed_permit" 2>/dev/null; then
    echo "pre-push-guard: refusing controlled update: the controlled-push permit is absent or already used" >&2
    exit 1
  fi
  trap 'rm -f "$claimed_permit"' 0 1 2 3 15
  if ! recorded_permitted_update="$(cat "$claimed_permit")" ||
    [ "$recorded_permitted_update" != "$expected_permitted_update" ]; then
    echo "pre-push-guard: refusing controlled update: the claimed controlled-push permit no longer matches the validated ref update" >&2
    exit 1
  fi
fi
