#!/usr/bin/env sh
set -eu

# Installed by setup-workspace as the run clone's pre-push hook. Minos is
# review-only: no publisher exists that may update the pull-request branch,
# so every update to a protected ref is refused outright — there is no
# permit, environment variable, or override that lifts the refusal (C33).
# The record fails closed: an unreadable or malformed protected-ref record
# refuses the whole push rather than guessing what it protected.

common_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
protected_refs=""

for protected_ref_file in "${common_dir}/minos-protected-ref"; do
  [ -e "$protected_ref_file" ] || continue
  if [ ! -f "$protected_ref_file" ] || [ ! -r "$protected_ref_file" ]; then
    echo "pre-push-guard: protected-ref record is present but unreadable: $protected_ref_file" >&2
    exit 1
  fi
  record="$(cat "$protected_ref_file")"
  [ -n "$record" ] || {
    echo "pre-push-guard: protected-ref record is invalid: <empty>" >&2
    exit 1
  }
  while IFS= read -r protected_ref; do
    case "$protected_ref" in
      refs/heads/?*) ;;
      *)
        echo "pre-push-guard: protected-ref record is invalid: ${protected_ref:-<empty>}" >&2
        exit 1
        ;;
    esac
    if ! git check-ref-format "$protected_ref"; then
      echo "pre-push-guard: protected-ref record is invalid: $protected_ref" >&2
      exit 1
    fi
    protected_refs="${protected_refs}${protected_ref}
"
  done <<EOF
$record
EOF
done

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ -n "$protected_refs" ] && printf '%s' "$protected_refs" | grep -Fqx "$remote_ref"; then
    echo "pre-push-guard: refusing to update $remote_ref to $local_sha: Minos never writes to the pull-request branch" >&2
    exit 1
  fi
done

exit 0
