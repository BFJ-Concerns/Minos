#!/usr/bin/env sh
set -eu

workspace="$1"
source_branch="$2"
target_branch="$3"
expected_head="$4"
expected_target="$5"
method="$6"

case "$method" in merge|rebase) ;; *) echo "sync-target: method must be merge or rebase" >&2; exit 1 ;; esac
if [ -z "$source_branch" ] || [ -z "$target_branch" ]; then
  echo "sync-target: named source and target branches are required" >&2
  exit 1
fi

common_dir="$(git -C "$workspace" rev-parse --path-format=absolute --git-common-dir)"

source_ref="refs/minos/source"
target_ref="refs/minos/target"
git -C "$workspace" fetch --no-tags origin \
  "+refs/heads/${source_branch}:${source_ref}" \
  "+refs/heads/${target_branch}:${target_ref}"

observed_head="$(git -C "$workspace" rev-parse "$source_ref")"
observed_target="$(git -C "$workspace" rev-parse "$target_ref")"
if [ "$observed_head" != "$expected_head" ]; then
  echo "sync-target: source moved from $expected_head to $observed_head" >&2
  exit 1
fi
if [ "$observed_target" != "$expected_target" ]; then
  echo "sync-target: target moved from $expected_target to $observed_target" >&2
  exit 1
fi

local_head="$(git -C "$workspace" rev-parse HEAD)"
git_dir="$(git -C "$workspace" rev-parse --git-dir)"
case "$git_dir" in /*) ;; *) git_dir="${workspace%/}/${git_dir}" ;; esac
if [ -f "${git_dir}/MERGE_HEAD" ] || [ -d "${git_dir}/rebase-merge" ] || [ -d "${git_dir}/rebase-apply" ]; then
  echo "sync-target: finish the current merge or rebase before resuming" >&2
  exit 1
fi
if [ "$local_head" = "$expected_head" ] && git -C "$workspace" merge-base --is-ancestor "$target_ref" HEAD; then
  jq -nc --arg head "$local_head" '{outcome:"unchanged",head:$head}'
  exit 0
fi

if ! git -C "$workspace" merge-base --is-ancestor "$target_ref" HEAD; then
  if [ "$local_head" != "$expected_head" ]; then
    echo "sync-target: workspace has unintegrated local commits" >&2
    exit 1
  fi
  if [ "$method" = "rebase" ]; then
    if ! git -C "$workspace" rebase "$target_ref" >&2; then
      jq -nc '{outcome:"conflict",operation:"rebase"}'
      exit 2
    fi
  elif ! git -C "$workspace" merge --no-edit "$target_ref" >&2; then
    jq -nc '{outcome:"conflict",operation:"merge"}'
    exit 2
  fi
fi

synced_head="$(git -C "$workspace" rev-parse HEAD)"
if [ "$method" = "merge" ] && ! git -C "$workspace" merge-base --is-ancestor "$expected_head" "$synced_head"; then
  echo "sync-target: merged result lost the reviewed head" >&2
  exit 1
fi
if ! git -C "$workspace" merge-base --is-ancestor "$target_ref" "$synced_head"; then
  echo "sync-target: result does not contain the target" >&2
  exit 1
fi

push_ref="refs/heads/${source_branch}"
if [ -n "${MINOS_RUN_DIR:-}" ] && [ -f "${MINOS_RUN_DIR}/reconciliation.json" ] &&
  [ "$(jq -r '.publish // false' "${MINOS_RUN_DIR}/reconciliation.json")" != true ]; then
  jq -nc --arg head "$synced_head" --arg method "$method" '{outcome:"local-only",head:$head,method:$method}'
  exit 0
fi
push_permit="$(mktemp "${common_dir}/minos-sync-target-push.XXXXXX")"
trap 'rm -f "$push_permit"' 0 1 2 3 15
printf '%s %s %s\n' "$push_ref" "$synced_head" "$expected_head" >"$push_permit"
MINOS_SYNC_TARGET_PUSH_PERMIT="$push_permit" git -C "$workspace" push \
  "--force-with-lease=refs/heads/${source_branch}:${expected_head}" \
  origin "HEAD:${push_ref}"
jq -nc --arg head "$synced_head" --arg method "$method" '{outcome:"synced",head:$head,method:$method}'
