#!/usr/bin/env sh
set -eu

: "${MINOS_API_BASE:?MINOS_API_BASE is required}"
: "${MINOS_CREDENTIAL_FILE:?MINOS_CREDENTIAL_FILE is required}"
: "${MINOS_OWNER:?MINOS_OWNER is required}"
: "${MINOS_REPO_NAME:?MINOS_REPO_NAME is required}"
: "${MINOS_PR:?MINOS_PR is required}"
: "${MINOS_HEAD_SHA:?MINOS_HEAD_SHA is required}"
: "${MINOS_TARGET_SHA:?MINOS_TARGET_SHA is required}"
: "${MINOS_HEAD_BRANCH:?MINOS_HEAD_BRANCH is required}"
: "${MINOS_RUN_DIR:?MINOS_RUN_DIR is required}"
: "${MINOS_WORKSPACE:?MINOS_WORKSPACE is required}"
: "${MINOS_ORIENTATION:?MINOS_ORIENTATION is required}"

resume=false
if [ -n "${MINOS_RESUME:-}" ]; then
  resume=true
elif [ -e "$MINOS_WORKSPACE" ]; then
  echo "setup-workspace: workspace already exists: $MINOS_WORKSPACE" >&2
  exit 1
fi

if ! IFS= read -r forge_token <"$MINOS_CREDENTIAL_FILE" || [ -z "$forge_token" ]; then
  echo "setup-workspace: forge credential file is empty" >&2
  exit 1
fi

response_file="${MINOS_ORIENTATION}.response"
protected_refs_tmp=""
trap 'rm -f "$response_file" ${protected_refs_tmp:+"$protected_refs_tmp"}' 0

forge_get() {
  api_path="$1"
  if ! response_status="$(curl -sS -o "$response_file" -w '%{http_code}' \
    -H "Authorization: token ${forge_token}" \
    -H "Accept: application/json" \
    "${MINOS_API_BASE%/}${api_path}")"; then
    echo "setup-workspace: forge request failed: $api_path" >&2
    exit 1
  fi
}

guidance_has_content() {
  [ -f "$1" ] && grep -q '[^[:space:]]' "$1"
}

workspace_is_git_repository() {
  git -C "$MINOS_WORKSPACE" rev-parse --is-inside-work-tree >/dev/null 2>&1
}

forge_get "/api/v1/repos/${MINOS_OWNER}/${MINOS_REPO_NAME}/pulls/${MINOS_PR}"
if [ "$response_status" != "200" ]; then
  echo "setup-workspace: pull request lookup returned HTTP $response_status" >&2
  exit 1
fi

# Minos authors no commits, so every head movement is the author's: the
# admitted head no longer exists as the thing to review, and the sweep will
# claim the new head fresh.
observed_head="$(jq -r '.head.sha // ""' "$response_file")"
if [ "$observed_head" != "$MINOS_HEAD_SHA" ]; then
  echo "setup-workspace: pull-request head moved from $MINOS_HEAD_SHA to ${observed_head:-unknown}" >&2
  exit 1
fi
repository_url="$(jq -r '.head.repo.clone_url // ""' "$response_file")"
if [ -z "$repository_url" ]; then
  echo "setup-workspace: pull request omitted the source repository clone URL" >&2
  exit 1
fi
target_repository_url="$(jq -r '.base.repo.clone_url // ""' "$response_file")"
if [ -z "$target_repository_url" ]; then
  echo "setup-workspace: pull request omitted the target repository clone URL" >&2
  exit 1
fi
# The author's declared intent and scope travel with the run so the review
# workflow can weigh explicit out-of-scope declarations.
pull_request_record="${MINOS_RUN_DIR}/pull-request.json"
jq '{number: (.number // null), title: (.title // ""), body: (.body // "")}' \
  "$response_file" >"$pull_request_record"

reuse_workspace="$resume"
if [ "$reuse_workspace" = true ]; then
  if ! workspace_is_git_repository; then
    echo "setup-workspace: preserved workspace is not a Git repository; cloning fresh" >&2
    rm -rf -- "$MINOS_WORKSPACE"
    reuse_workspace=false
  else
    git -C "$MINOS_WORKSPACE" reset --hard
    git -C "$MINOS_WORKSPACE" checkout --detach "$MINOS_HEAD_SHA"
  fi
fi
if [ "$reuse_workspace" = false ]; then
  git -c "http.extraHeader=Authorization: token ${forge_token}" clone --no-checkout "$repository_url" "$MINOS_WORKSPACE"
  git -C "$MINOS_WORKSPACE" checkout --detach "$MINOS_HEAD_SHA"
fi
checked_out_head="$(git -C "$MINOS_WORKSPACE" rev-parse HEAD)"
if [ "$checked_out_head" != "$MINOS_HEAD_SHA" ]; then
  echo "setup-workspace: checked out $checked_out_head, expected $MINOS_HEAD_SHA" >&2
  exit 1
fi
# The review computes the target-to-head diff locally. Fetching the admitted
# target SHA by object name makes that operand available without recording a
# remote, refspec, FETCH_HEAD, or workspace state transition.
git -C "$MINOS_WORKSPACE" -c "http.extraHeader=Authorization: token ${forge_token}" \
  fetch --no-write-fetch-head --no-tags "$target_repository_url" "$MINOS_TARGET_SHA"
git -C "$MINOS_WORKSPACE" cat-file -e "${MINOS_TARGET_SHA}^{commit}"
script_dir="$(CDPATH= cd -- "$(dirname "$0")" && pwd)"
run_date="$(date -u '+%Y-%m-%d')"
common_dir="$(git -C "$MINOS_WORKSPACE" rev-parse --path-format=absolute --git-common-dir)"
mkdir -p "$common_dir/hooks"
protected_refs="$common_dir/minos-protected-ref"
protected_refs_tmp="$(mktemp "${common_dir}/minos-protected-ref.XXXXXX")"

append_protected_ref() {
  protected_ref="$1"
  case "$protected_ref" in
    refs/heads/?*) ;;
    *)
      echo "setup-workspace: invalid protected ref ${protected_ref:-<empty>}" >&2
      exit 1
      ;;
  esac
  if ! git -C "$MINOS_WORKSPACE" check-ref-format "$protected_ref"; then
    echo "setup-workspace: invalid protected ref $protected_ref" >&2
    exit 1
  fi
  if ! grep -Fqx "$protected_ref" "$protected_refs_tmp"; then
    printf '%s\n' "$protected_ref" >>"$protected_refs_tmp"
  fi
}

append_protected_ref "refs/heads/${MINOS_HEAD_BRANCH}"
chmod 0600 "$protected_refs_tmp"
mv "$protected_refs_tmp" "$protected_refs"
protected_refs_tmp=""
# This hook binds every checkout sharing the common Git directory and refuses
# every update to the pull-request branch: no publisher exists that could
# authorise one (C33). A separate clone inherits neither protection.
install -m 0755 "$script_dir/pre-push-guard" "$common_dir/hooks/pre-push"

annexe_name="${MINOS_REPO_NAME}-Annexe"
annexe_path="$(dirname "$MINOS_WORKSPACE")/${annexe_name}"
forge_get "/api/v1/repos/${MINOS_OWNER}/${annexe_name}"
case "$response_status" in
  200)
    annexe_url="$(jq -r '.clone_url // ""' "$response_file")"
    if [ -z "$annexe_url" ]; then
      echo "setup-workspace: annexe metadata omitted its clone URL" >&2
      exit 1
    fi
    if [ "$resume" = true ]; then
      if [ ! -d "$annexe_path/.git" ]; then
        echo "setup-workspace: preserved annexe is missing or not a Git repository: $annexe_path" >&2
        exit 1
      fi
    else
      git -c "http.extraHeader=Authorization: token ${forge_token}" clone "$annexe_url" "$annexe_path"
    fi
    annexe_guidance="$annexe_path/README.md"
    if ! guidance_has_content "$annexe_guidance"; then
      echo "setup-workspace: annexe README.md guidance is missing or empty" >&2
      exit 1
    fi
    jq -n \
      --arg repository "$MINOS_WORKSPACE" \
      --arg head "$checked_out_head" \
      --arg annexe "$annexe_path" \
      --arg guidance "$annexe_guidance" \
      --arg pull_request "$pull_request_record" \
      --arg owner "$MINOS_OWNER" \
      --arg repo "$MINOS_REPO_NAME" \
      --arg pr "$MINOS_PR" \
      --arg date "$run_date" \
      '{repository:$repository,head:$head,grounding:"annexe",annexe:$annexe,guidance:$guidance,pullRequest:$pull_request,source:{owner:$owner,repo:$repo,pr:$pr,date:$date}}' \
      >"$MINOS_ORIENTATION"
    ;;
  404)
    repository_guidance=""
    for candidate in AGENTS.md CLAUDE.md README.md; do
      if guidance_has_content "$MINOS_WORKSPACE/$candidate"; then
        repository_guidance="$MINOS_WORKSPACE/$candidate"
        break
      fi
    done
    if [ -z "$repository_guidance" ]; then
      echo "setup-workspace: repository fallback has no non-empty checked-in guidance" >&2
      exit 1
    fi
    jq -n \
      --arg repository "$MINOS_WORKSPACE" \
      --arg head "$checked_out_head" \
      --arg guidance "$repository_guidance" \
      --arg pull_request "$pull_request_record" \
      --arg owner "$MINOS_OWNER" \
      --arg repo "$MINOS_REPO_NAME" \
      --arg pr "$MINOS_PR" \
      --arg date "$run_date" \
      '{repository:$repository,head:$head,grounding:"repository",guidance:$guidance,pullRequest:$pull_request,reason:"annexe-not-found",source:{owner:$owner,repo:$repo,pr:$pr,date:$date}}' \
      >"$MINOS_ORIENTATION"
    ;;
  *)
    echo "setup-workspace: annexe lookup returned HTTP $response_status" >&2
    exit 1
    ;;
esac
