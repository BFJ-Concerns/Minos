#!/usr/bin/env sh
set -eu

: "${MINOS_BIN:?MINOS_BIN is required}"
: "${MINOS_OWNER:?MINOS_OWNER is required}"
: "${MINOS_REPO_NAME:?MINOS_REPO_NAME is required}"
: "${MINOS_PR:?MINOS_PR is required}"
: "${MINOS_HEAD_SHA:?MINOS_HEAD_SHA is required}"
: "${MINOS_TARGET_SHA:?MINOS_TARGET_SHA is required}"
: "${MINOS_HEAD_BRANCH:?MINOS_HEAD_BRANCH is required}"
: "${MINOS_RUN_DIR:?MINOS_RUN_DIR is required}"
: "${MINOS_WORKSPACE:?MINOS_WORKSPACE is required}"
: "${MINOS_ORIENTATION:?MINOS_ORIENTATION is required}"

resume=false
if [ -n "${MINOS_RESUME:-}" ]; then
  resume=true
elif [ -e "$MINOS_WORKSPACE" ]; then
  echo "setup-workspace: workspace already exists: $MINOS_WORKSPACE" >&2
  exit 1
fi

snapshot_file="${MINOS_ORIENTATION}.snapshot"
protected_refs_tmp=""
trap 'rm -f "$snapshot_file" ${protected_refs_tmp:+"$protected_refs_tmp"}' 0

guidance_has_content() {
  [ -f "$1" ] && grep -q '[^[:space:]]' "$1"
}

workspace_is_git_repository() {
  git -C "$MINOS_WORKSPACE" rev-parse --is-inside-work-tree >/dev/null 2>&1
}

# The forge's adaptation answers every forge question, so nothing here names
# a forge's routes or reads its credential file.
# clone_url prints the clone URL the forge reports for owner/name.
clone_url() {
  "$MINOS_BIN" forge repository-metadata "${1%%/*}" "${1#*/}" | jq -er '.clone_url'
}

# The adaptation turns its credential into an HTTPS git username and secret.
# The secret reaches git only as a preemptive Basic authorisation header in
# the GIT_CONFIG_* environment: never an argument, never a file, never output.
if ! clone_credential="$("$MINOS_BIN" forge clone-credential)"; then
  echo "setup-workspace: the forge supplied no clone credential" >&2
  exit 1
fi
if ! git_authorisation="$(printf '%s' "$clone_credential" | jq -er '
  if (.username | type) == "string" and .username != "" and (.password | type) == "string" and .password != ""
  then "Authorization: Basic " + ((.username + ":" + .password) | @base64) else error("malformed") end' 2>/dev/null)"; then
  echo "setup-workspace: the forge's clone credential is malformed" >&2
  exit 1
fi
clone_credential=""
export GIT_TERMINAL_PROMPT=0
# Appended after any configuration the environment already carries.
git_config_index="${GIT_CONFIG_COUNT:-0}"
export "GIT_CONFIG_KEY_${git_config_index}=http.extraHeader"
export "GIT_CONFIG_VALUE_${git_config_index}=${git_authorisation}"
export GIT_CONFIG_COUNT="$((git_config_index + 1))"
git_authorisation=""

if ! "$MINOS_BIN" forge snapshot >"$snapshot_file"; then
  echo "setup-workspace: pull request snapshot failed" >&2
  exit 1
fi

# Minos authors no commits, so every head movement is the author's: the
# admitted head no longer exists as the thing to review, and the sweep will
# claim the new head fresh.
observed_head="$(jq -r '.head_sha // ""' "$snapshot_file")"
if [ "$observed_head" != "$MINOS_HEAD_SHA" ]; then
  echo "setup-workspace: pull-request head moved from $MINOS_HEAD_SHA to ${observed_head:-unknown}" >&2
  exit 1
fi
head_repository="$(jq -r '.head_repository // ""' "$snapshot_file")"
if [ -z "$head_repository" ] || ! repository_url="$(clone_url "$head_repository")"; then
  echo "setup-workspace: the forge named no clone URL for the source repository ${head_repository:-<unknown>}" >&2
  exit 1
fi
target_repository="$(jq -r '.target_repository // ""' "$snapshot_file")"
if [ -z "$target_repository" ] || ! target_repository_url="$(clone_url "$target_repository")"; then
  echo "setup-workspace: the forge named no clone URL for the target repository ${target_repository:-<unknown>}" >&2
  exit 1
fi
# The author's declared intent and scope travel with the run so the review
# workflow can weigh explicit out-of-scope declarations.
pull_request_record="${MINOS_RUN_DIR}/pull-request.json"
jq '{number: (.pull_request // null), title: (.title // ""), body: (.body // "")}' \
  "$snapshot_file" >"$pull_request_record"

reuse_workspace="$resume"
if [ "$reuse_workspace" = true ]; then
  if ! workspace_is_git_repository; then
    echo "setup-workspace: preserved workspace is not a Git repository; cloning fresh" >&2
    rm -rf -- "$MINOS_WORKSPACE"
    reuse_workspace=false
  else
    git -C "$MINOS_WORKSPACE" reset --hard
    git -C "$MINOS_WORKSPACE" checkout --detach "$MINOS_HEAD_SHA"
  fi
fi
if [ "$reuse_workspace" = false ]; then
  git clone --no-checkout "$repository_url" "$MINOS_WORKSPACE"
  git -C "$MINOS_WORKSPACE" checkout --detach "$MINOS_HEAD_SHA"
fi
checked_out_head="$(git -C "$MINOS_WORKSPACE" rev-parse HEAD)"
if [ "$checked_out_head" != "$MINOS_HEAD_SHA" ]; then
  echo "setup-workspace: checked out $checked_out_head, expected $MINOS_HEAD_SHA" >&2
  exit 1
fi
# The review computes the target-to-head diff locally. Fetching the admitted
# target SHA by object name makes that operand available without recording a
# remote, refspec, FETCH_HEAD, or workspace state transition.
target_fetch_status=0
# Match Git's refusal text in a stable locale; other failures stay unchanged.
target_fetch_output="$(LC_ALL=C git -C "$MINOS_WORKSPACE" \
  fetch --no-write-fetch-head --no-tags "$target_repository_url" "$MINOS_TARGET_SHA" 2>&1)" || target_fetch_status=$?
if [ -n "$target_fetch_output" ]; then
  printf '%s\n' "$target_fetch_output" >&2
fi
if [ "$target_fetch_status" -ne 0 ]; then
  case "$target_fetch_output" in
    *"not our ref $MINOS_TARGET_SHA"*|*"unadvertised object $MINOS_TARGET_SHA"*)
      echo "setup-workspace: target fetch refused: the forge would not serve target sha $MINOS_TARGET_SHA; it is no longer advertised, likely because the base branch moved; the next sweep re-derives from current forge state" >&2
      ;;
  esac
  exit "$target_fetch_status"
fi
git -C "$MINOS_WORKSPACE" cat-file -e "${MINOS_TARGET_SHA}^{commit}"
script_dir="$(CDPATH= cd -- "$(dirname "$0")" && pwd)"
run_date="$(date -u '+%Y-%m-%d')"
common_dir="$(git -C "$MINOS_WORKSPACE" rev-parse --path-format=absolute --git-common-dir)"
mkdir -p "$common_dir/hooks"
protected_refs="$common_dir/minos-protected-ref"
protected_refs_tmp="$(mktemp "${common_dir}/minos-protected-ref.XXXXXX")"

append_protected_ref() {
  protected_ref="$1"
  case "$protected_ref" in
    refs/heads/?*) ;;
    *)
      echo "setup-workspace: invalid protected ref ${protected_ref:-<empty>}" >&2
      exit 1
      ;;
  esac
  if ! git -C "$MINOS_WORKSPACE" check-ref-format "$protected_ref"; then
    echo "setup-workspace: invalid protected ref $protected_ref" >&2
    exit 1
  fi
  if ! grep -Fqx "$protected_ref" "$protected_refs_tmp"; then
    printf '%s\n' "$protected_ref" >>"$protected_refs_tmp"
  fi
}

append_protected_ref "refs/heads/${MINOS_HEAD_BRANCH}"
chmod 0600 "$protected_refs_tmp"
mv "$protected_refs_tmp" "$protected_refs"
protected_refs_tmp=""
# This hook binds every checkout sharing the common Git directory and refuses
# every update to the pull-request branch: no publisher exists that could
# authorise one. A separate clone inherits neither protection.
install -m 0755 "$script_dir/pre-push-guard" "$common_dir/hooks/pre-push"

# Guidance sources are the resolved per-repository knob, exported by
# the service as one JSON array: each entry names a path in the reviewed
# repository or a path in a named secondary repository on the same forge.
# An empty array grounds the run on the reviewed repository's own checked-in
# guidance. Structure is validated here because the environment is the
# contract; a malformed value is a setup failure, never a silent default.
: "${MINOS_GUIDANCE_SOURCES:?MINOS_GUIDANCE_SOURCES is required}"
if ! printf '%s' "$MINOS_GUIDANCE_SOURCES" | jq -e '
  type == "array" and all(.[];
    type == "object"
    and (.path | type) == "string" and .path != ""
    and (.path | startswith("/") | not)
    and ((.path | split("/") | index("..")) == null)
    and (.repository == null
      or ((.repository | type) == "string" and (.repository | test("^[^/[:space:]]+/[^/[:space:]]+$")))))
' >/dev/null 2>&1; then
  echo "setup-workspace: MINOS_GUIDANCE_SOURCES must be a JSON array of {repository?, path} entries with relative paths" >&2
  exit 1
fi

guidance_root="$(dirname "$MINOS_WORKSPACE")/guidance"
guidance_entries='[]'
misconfigurations='[]'
clone_failures='{}'

# owner/name maps to guidance/<owner>/<name>: nested directories, so two
# distinct names can never share a clone path.
guidance_clone_path() {
  printf '%s/%s' "$guidance_root" "$1"
}

# A configured source that cannot be read is recorded in the orientation,
# never passed over silently; the lead carries the record into the run report.
record_guidance_misconfiguration() {
  misconfigurations="$(printf '%s' "$misconfigurations" | jq -c --argjson source "$1" --arg reason "$2" \
    '. + [{kind: "guidance-source", source: $source, reason: $reason}]')"
  echo "setup-workspace: guidance source $(printf '%s' "$1" | jq -r '(.repository // "the reviewed repository") + ":" + .path') $2" >&2
}

# Each named secondary repository is cloned once, read-only: its push URL is
# unusable, so no path exists from a run to that repository.
for guidance_repository in $(printf '%s' "$MINOS_GUIDANCE_SOURCES" | jq -r '[.[].repository // empty] | unique | .[]'); do
  clone_path="$(guidance_clone_path "$guidance_repository")"
  if [ "$resume" = true ] && [ -d "$clone_path/.git" ]; then
    continue
  fi
  rm -rf -- "$clone_path"
  guidance_metadata=""
  if ! guidance_metadata="$("$MINOS_BIN" forge repository-metadata "${guidance_repository%%/*}" "${guidance_repository#*/}")" \
    || ! guidance_url="$(printf '%s' "$guidance_metadata" | jq -er '.clone_url')"; then
    # The forge's own answer, when it gave one, is the reason recorded.
    lookup_status="$(printf '%s' "${guidance_metadata:-}" | jq -r '.lookup_status // empty' 2>/dev/null)" || lookup_status=""
    clone_failure="the forge could not report the repository's clone URL"
    [ -z "$lookup_status" ] || clone_failure="repository lookup returned HTTP $lookup_status"
    clone_failures="$(printf '%s' "$clone_failures" | jq -c --arg name "$guidance_repository" --arg reason "$clone_failure" '.[$name] = $reason')"
    continue
  fi
  mkdir -p "$(dirname "$clone_path")"
  if ! git clone --quiet "$guidance_url" "$clone_path"; then
    rm -rf -- "$clone_path"
    clone_failures="$(printf '%s' "$clone_failures" | jq -c --arg name "$guidance_repository" --arg reason "repository could not be cloned" '.[$name] = $reason')"
    continue
  fi
  git -C "$clone_path" remote set-url --push origin "no-push://minos-guidance-clone"
done

source_count="$(printf '%s' "$MINOS_GUIDANCE_SOURCES" | jq 'length')"
source_index=0
while [ "$source_index" -lt "$source_count" ]; do
  guidance_source="$(printf '%s' "$MINOS_GUIDANCE_SOURCES" | jq -c ".[$source_index]")"
  source_index=$((source_index + 1))
  source_repository="$(printf '%s' "$guidance_source" | jq -r '.repository // empty')"
  source_path="$(printf '%s' "$guidance_source" | jq -r '.path')"
  if [ -n "$source_repository" ]; then
    clone_failure="$(printf '%s' "$clone_failures" | jq -r --arg name "$source_repository" '.[$name] // empty')"
    if [ -n "$clone_failure" ]; then
      record_guidance_misconfiguration "$guidance_source" "$clone_failure"
      continue
    fi
    guidance_location="$(guidance_clone_path "$source_repository")/$source_path"
  else
    guidance_location="$MINOS_WORKSPACE/$source_path"
  fi
  if ! guidance_has_content "$guidance_location"; then
    record_guidance_misconfiguration "$guidance_source" "is missing or empty"
    continue
  fi
  guidance_entries="$(printf '%s' "$guidance_entries" | jq -c --argjson source "$guidance_source" --arg location "$guidance_location" \
    '. + [{source: $source, location: $location, origin: "configured"}]')"
done

if [ "$source_count" -eq 0 ]; then
  for candidate in AGENTS.md CLAUDE.md README.md; do
    if guidance_has_content "$MINOS_WORKSPACE/$candidate"; then
      guidance_entries="$(jq -nc --arg path "$candidate" --arg location "$MINOS_WORKSPACE/$candidate" \
        '[{source: {path: $path}, location: $location, origin: "checked-in"}]')"
      break
    fi
  done
  if [ "$guidance_entries" = '[]' ]; then
    echo "setup-workspace: no guidance source is configured and the repository has no non-empty checked-in guidance (AGENTS.md, CLAUDE.md or README.md)" >&2
    exit 1
  fi
elif [ "$guidance_entries" = '[]' ]; then
  echo "setup-workspace: no configured guidance source is readable" >&2
  exit 1
fi

jq -n \
  --arg repository "$MINOS_WORKSPACE" \
  --arg head "$checked_out_head" \
  --argjson guidance "$guidance_entries" \
  --argjson misconfigurations "$misconfigurations" \
  --arg pull_request "$pull_request_record" \
  --arg owner "$MINOS_OWNER" \
  --arg repo "$MINOS_REPO_NAME" \
  --arg pr "$MINOS_PR" \
  --arg date "$run_date" \
  '{repository: $repository, head: $head, guidance: $guidance, misconfigurations: $misconfigurations, pullRequest: $pull_request, source: {owner: $owner, repo: $repo, pr: $pr, date: $date}}' \
  >"$MINOS_ORIENTATION"
