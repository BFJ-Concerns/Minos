#!/usr/bin/env sh
set -eu

: "${MINOS_BIN:=minos}"
: "${MINOS_CLAUDE:?MINOS_CLAUDE is required}"
: "${MINOS_PINS:?MINOS_PINS is required}"
: "${MINOS_WORKSPACE:?MINOS_WORKSPACE is required}"

model=$("$MINOS_BIN" provenance lead-pin "$MINOS_PINS")
exec "$MINOS_CLAUDE" -p \
  --output-format stream-json \
  --verbose \
  --include-partial-messages \
  --no-session-persistence \
  --permission-mode bypassPermissions \
  --model "$model" \
  --add-dir "$MINOS_WORKSPACE"
