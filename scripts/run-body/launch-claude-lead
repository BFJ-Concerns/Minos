#!/usr/bin/env sh
set -eu

: "${PUMP19_BIN:=pump19}"
: "${PUMP19_CLAUDE:?PUMP19_CLAUDE is required}"
: "${PUMP19_PINS:?PUMP19_PINS is required}"
: "${PUMP19_WORKSPACE:?PUMP19_WORKSPACE is required}"

model=$("$PUMP19_BIN" provenance lead-pin "$PUMP19_PINS")
exec "$PUMP19_CLAUDE" -p \
  --output-format stream-json \
  --verbose \
  --include-partial-messages \
  --no-session-persistence \
  --permission-mode bypassPermissions \
  --model "$model" \
  --add-dir "$PUMP19_WORKSPACE"
