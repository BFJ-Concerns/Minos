#!/usr/bin/env sh
set -eu

: "${MINOS_RUN_DIR:?MINOS_RUN_DIR is required}"
: "${MINOS_WORKSPACE:?MINOS_WORKSPACE is required}"
state_file="${MINOS_RUN_DIR}/reconciliation.json"

if [ ! -f "$state_file" ]; then
  echo "show-resolutions: reconciliation state is missing: $state_file" >&2
  exit 1
fi
preimage_dir="$(jq -r '.preimageDir // ""' "$state_file")"
if [ -z "$preimage_dir" ]; then
  echo "show-resolutions: reconciliation state has no conflict preimages" >&2
  exit 1
fi
auto_merge_tree="$(jq -r '.autoMergeTree // ""' "$state_file")"
if [ -z "$auto_merge_tree" ] ||
  ! git -C "$MINOS_WORKSPACE" cat-file -e "${auto_merge_tree}^{tree}" 2>/dev/null; then
  echo "show-resolutions: reconciliation state omitted a valid autoMergeTree" >&2
  exit 1
fi

jq -r '.conflicts[]' "$state_file" |
  while IFS= read -r conflict_path; do
    if [ ! -f "$preimage_dir/$conflict_path" ]; then
      echo "show-resolutions: missing preimage for $conflict_path" >&2
      exit 1
    fi
    staged_file="$(mktemp)"
    if ! git -C "$MINOS_WORKSPACE" show ":$conflict_path" >"$staged_file"; then
      if ! git -C "$MINOS_WORKSPACE" diff --cached --name-only -- "$conflict_path" |
        grep -Fxq "$conflict_path"; then
        rm -f "$staged_file"
        echo "show-resolutions: $conflict_path is not staged" >&2
        exit 1
      fi
      : >"$staged_file"
    fi
    printf '=== %s\n' "$conflict_path"
    diff -u \
      --label "preimage/$conflict_path" \
      --label "staged/$conflict_path" \
      "$preimage_dir/$conflict_path" "$staged_file" || diff_status=$?
    rm -f "$staged_file"
    if [ "${diff_status:-0}" -gt 1 ]; then
      exit "$diff_status"
    fi
    unset diff_status
  done

index_path="$(git -C "$MINOS_WORKSPACE" rev-parse --path-format=absolute --git-path index)"
normalised_index="$(mktemp)"
cleanup_index() {
  rm -f "$normalised_index"
}
trap cleanup_index EXIT HUP INT TERM
cp "$index_path" "$normalised_index"
jq -r '.conflicts[]' "$state_file" |
  while IFS= read -r conflict_path; do
    GIT_INDEX_FILE="$normalised_index" \
      git -C "$MINOS_WORKSPACE" update-index --force-remove -- "$conflict_path"
  done
staged_outside_conflicts="$(
  GIT_INDEX_FILE="$normalised_index" git -C "$MINOS_WORKSPACE" write-tree
)"
cleanup_index
trap - EXIT HUP INT TERM
if [ "$staged_outside_conflicts" != "$auto_merge_tree" ]; then
  printf '%s\n' "=== staged outside recorded conflicts"
  git -C "$MINOS_WORKSPACE" diff \
    --no-ext-diff \
    --no-renames \
    --src-prefix=auto-merge/ \
    --dst-prefix=staged/ \
    "$auto_merge_tree" "$staged_outside_conflicts"
fi
