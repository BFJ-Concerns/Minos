#!/usr/bin/env sh
set -eu

: "${MINOS_CONFIG:?MINOS_CONFIG is required}"
: "${MINOS_RUN_DIR:?MINOS_RUN_DIR is required}"

set -a
# shellcheck source=/dev/null
. "${MINOS_CONFIG%/}/run-body.env"
set +a

: "${MINOS_CODEX:?MINOS_CODEX is required}"
: "${MINOS_LIFECYCLE_INSTRUCTION:?MINOS_LIFECYCLE_INSTRUCTION is required}"

mkdir -p "$MINOS_RUN_DIR"
cd "$MINOS_RUN_DIR"
exec "$MINOS_CODEX" exec \
  --dangerously-bypass-approvals-and-sandbox \
  --ephemeral \
  -m "${MINOS_LEAD_MODEL:-gpt-5.6-sol}" \
  -C "$MINOS_RUN_DIR" \
  - <"$MINOS_LIFECYCLE_INSTRUCTION"
