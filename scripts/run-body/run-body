#!/usr/bin/env sh
set -eu

: "${PUMP19_CONFIG:?PUMP19_CONFIG is required}"
: "${PUMP19_RUN_DIR:?PUMP19_RUN_DIR is required}"
: "${PUMP19_RUN_KIND:?PUMP19_RUN_KIND is required}"

config_file="${PUMP19_CONFIG%/}/run-body.env"
if [ ! -r "$config_file" ]; then
  echo "run-body configuration is not readable: $config_file" >&2
  exit 2
fi

# These values are deployment configuration and must reach the accountable
# session unchanged. Export while sourcing rather than maintaining a second
# list of fields here.
set -a
# shellcheck source=/dev/null
. "$config_file"
set +a

: "${PUMP19_ENGINE_LAUNCH_LEAD:?PUMP19_ENGINE_LAUNCH_LEAD is required}"
: "${PUMP19_ENSEMBLE_LAUNCH:?PUMP19_ENSEMBLE_LAUNCH is required}"
: "${PUMP19_PINS:?PUMP19_PINS is required}"
: "${PUMP19_REVIEW_SCRIPTS:?PUMP19_REVIEW_SCRIPTS is required}"
: "${PUMP19_BIN:?PUMP19_BIN is required}"

script_dir=$(unset CDPATH; cd "$(dirname "$0")" && pwd)

# Every run kind launches the same way: one accountable Claude session with its
# mission on stdin, captured for model provenance and the loud pin check. Only
# the mission file — and, for fix and flaky repair, the procedure skill —
# differ by kind.
launch_session() {
  mission="${script_dir%/run-body}/missions/$1"
  if [ ! -r "$mission" ]; then
    echo "mission is not readable: $mission" >&2
    exit 2
  fi
  mkdir -p "$PUMP19_RUN_DIR/sessions"
  cd "$PUMP19_RUN_DIR"
  exec "$PUMP19_BIN" capture-claude \
    --pins "$PUMP19_PINS" \
    --output "$PUMP19_RUN_DIR/sessions/lead.jsonl" \
    --resolved "$PUMP19_RUN_DIR/resolved-lead.json" \
    "$PUMP19_ENGINE_LAUNCH_LEAD" <"$mission"
}

case "$PUMP19_RUN_KIND" in
  review)
    launch_session review.md
    ;;
  fix)
    # The fix run's procedure is the one service-authored skill. It is fixed by
    # the deployment, not selectable per repository, so it rides run-body.env —
    # unlike the review skill, which a repository points at through its config.
    : "${PUMP19_FIX_SKILL:?PUMP19_FIX_SKILL is required for fix runs}"
    PUMP19_SKILL="$PUMP19_FIX_SKILL"
    export PUMP19_SKILL
    launch_session fix.md
    ;;
  finish)
    # Finish composes over the session's general skills; it has no bespoke skill
    # and reads no PUMP19_SKILL.
    launch_session finish.md
    ;;
  flaky)
    # Flaky repair composes over the Foundry's synced general debugging skill.
    # The service-owned mission supplies every flaky-specific instruction.
    : "${PUMP19_FLAKY_SKILL:?PUMP19_FLAKY_SKILL is required for flaky runs}"
    PUMP19_SKILL="$PUMP19_FLAKY_SKILL"
    export PUMP19_SKILL
    launch_session flaky.md
    ;;
  *)
    echo "unknown run kind '$PUMP19_RUN_KIND'" >&2
    exit 2
    ;;
esac
