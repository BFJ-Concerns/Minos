#!/usr/bin/env sh
set -eu

# Sourced before anything changes directory: $0 is the only handle on the
# script's own directory and the run moves out of it.
# shellcheck source=scripts/run-body/cgroup-memory.sh
. "$(CDPATH= cd -- "$(dirname "$0")" && pwd)/cgroup-memory.sh"

prelaunch=true
supervisor_failure=false
failure_stage="configuration"
failure_cause="run-body exited before loading its configuration"
session_id=""
run_tmpdir=""

stop_session() {
  if [ -n "$session_id" ]; then
    "$MINOS_CLAUDE" stop "$session_id" >/dev/null 2>&1 || true
  fi
}

remove_run_tmpdir() {
  [ -n "$run_tmpdir" ] || return 0
  rm -rf -- "$run_tmpdir"
}

archive_run() {
  [ -n "${MINOS_RUN_DIR:-}" ] || return 0
  archive_command="${MINOS_ARCHIVE_RUN:-}"
  if [ -z "$archive_command" ] && [ -n "${MINOS_CONFIG:-}" ]; then
    archive_config="${MINOS_ARCHIVE_CONFIG:-${MINOS_CONFIG%/}/archive.env}"
    if [ -r "$archive_config" ]; then
      archive_command="$(CDPATH= cd -- "$(dirname "$0")" && pwd)/archive-run"
      MINOS_ARCHIVE_CONFIG="$archive_config"
      export MINOS_ARCHIVE_CONFIG
    fi
  fi
  [ -n "$archive_command" ] || return 0
  "$archive_command" "$MINOS_RUN_DIR" \
    "${MINOS_OWNER:-unknown}-${MINOS_REPO_NAME:-unknown}-pr${MINOS_PR:-unknown}" || true
}

append_failure() {
  [ -n "${MINOS_FAILURE_LOG:-}" ] || return 0

  failure_directory="$(dirname "$MINOS_FAILURE_LOG")"
  mkdir -p "$failure_directory" 2>/dev/null || true
  timestamp="$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null)" || timestamp="unknown"
  pull_request="${MINOS_OWNER:-unknown}/${MINOS_REPO_NAME:-unknown}#${MINOS_PR:-unknown}"
  if ! printf 'timestamp=%s pull_request=%s head=%s stage=%s cause=%s\n' \
    "$timestamp" "$pull_request" "${MINOS_HEAD_SHA:-unknown}" \
    "$failure_stage" "$failure_cause" >>"$MINOS_FAILURE_LOG"; then
    echo "run-body: MINOS_FAILURE_LOG ($MINOS_FAILURE_LOG) is not writable" >&2
  fi
}

capture_cgroup_death_evidence() {
  # A terminal lead state is the last point at which this run's cgroup still
  # describes the failure. Keep the raw kernel counters in the run directory
  # for the archive and postmortem; this is evidence, not another memory
  # judgement or lifecycle store.
  evidence="$MINOS_RUN_DIR/cgroup-death-evidence"
  evidence_tmp="${evidence}.tmp"
  {
    printf 'captured_at=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || printf 'unknown')"
    for counter_file in memory.events memory.peak memory.pressure; do
      printf '[%s]\n' "$counter_file"
      if [ -r "$cgroup_dir/$counter_file" ]; then
        cat "$cgroup_dir/$counter_file"
      else
        printf 'unavailable\n'
      fi
    done
  } >"$evidence_tmp" && mv "$evidence_tmp" "$evidence"
}

on_exit() {
  status="$1"
  trap - 0
  set +e
  if [ "$status" -ne 0 ] &&
    { [ "$prelaunch" = true ] || [ "$supervisor_failure" = true ]; }; then
    append_failure
  fi
  stop_session
  archive_run
  remove_run_tmpdir
  exit "$status"
}
trap 'on_exit $?' 0

failure_cause="MINOS_CONFIG is required"
: "${MINOS_CONFIG:?MINOS_CONFIG is required}"
failure_cause="MINOS_RUN_DIR is required"
: "${MINOS_RUN_DIR:?MINOS_RUN_DIR is required}"

unset_gateway_environment() {
  unset ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL ANTHROPIC_DEFAULT_HAIKU_MODEL
  unset CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY CLAUDE_CODE_MAX_CONTEXT_TOKENS
  unset CLAUDE_CODE_AUTO_COMPACT_WINDOW MINOS_ANTHROPIC_CREDENTIAL_FILE
}

unset_gateway_environment

set -a
# shellcheck source=/dev/null
failure_cause="could not load ${MINOS_CONFIG%/}/run-body.env"
. "${MINOS_CONFIG%/}/run-body.env"
set +a

if [ -n "${MINOS_ANTHROPIC_CREDENTIAL_FILE:-}" ]; then
  failure_cause="ANTHROPIC_BASE_URL is required in gateway mode"
  : "${ANTHROPIC_BASE_URL:?ANTHROPIC_BASE_URL is required in gateway mode}"
  if [ ! -f "$MINOS_ANTHROPIC_CREDENTIAL_FILE" ] ||
    [ ! -r "$MINOS_ANTHROPIC_CREDENTIAL_FILE" ]; then
    failure_cause="gateway credential file ($MINOS_ANTHROPIC_CREDENTIAL_FILE) is missing or unreadable"
    echo "run-body: gateway credential file ($MINOS_ANTHROPIC_CREDENTIAL_FILE) is missing or unreadable" >&2
    exit 1
  fi
  ANTHROPIC_AUTH_TOKEN=""
  IFS= read -r ANTHROPIC_AUTH_TOKEN <"$MINOS_ANTHROPIC_CREDENTIAL_FILE" || true
  if [ -z "$ANTHROPIC_AUTH_TOKEN" ]; then
    failure_cause="gateway credential file ($MINOS_ANTHROPIC_CREDENTIAL_FILE) is empty"
    echo "run-body: gateway credential file ($MINOS_ANTHROPIC_CREDENTIAL_FILE) is empty" >&2
    exit 1
  fi
  export ANTHROPIC_AUTH_TOKEN
else
  unset_gateway_environment
fi

failure_cause="MINOS_CLAUDE is required"
: "${MINOS_CLAUDE:?MINOS_CLAUDE is required}"
failure_cause="MINOS_CLAUDE_CONFIG_SEED is required"
: "${MINOS_CLAUDE_CONFIG_SEED:?MINOS_CLAUDE_CONFIG_SEED is required}"
failure_cause="MINOS_CODEX_CONFIG_SEED is required"
: "${MINOS_CODEX_CONFIG_SEED:?MINOS_CODEX_CONFIG_SEED is required}"
failure_cause="MINOS_LIFECYCLE_INSTRUCTION is required"
: "${MINOS_LIFECYCLE_INSTRUCTION:?MINOS_LIFECYCLE_INSTRUCTION is required}"
instruction_path="$MINOS_LIFECYCLE_INSTRUCTION"
failure_cause="MINOS_SKILLS_DIR is required"
: "${MINOS_SKILLS_DIR:?MINOS_SKILLS_DIR is required}"
failure_cause="MINOS_SETUP_WORKSPACE is required"
: "${MINOS_SETUP_WORKSPACE:?MINOS_SETUP_WORKSPACE is required}"
failure_cause="MINOS_ORIENTATION is required"
: "${MINOS_ORIENTATION:?MINOS_ORIENTATION is required}"

FORCE_COLOR=0
export FORCE_COLOR
# The harness reaps background shells under memory pressure, which on a run
# unit reads as pressure whenever the workspace's build output fills the page
# cache — a long setup or review stage is then killed mid-flight and reported
# as an interrupted dispatch rather than a verdict. The run unit's own
# MemoryMax ceiling and the continuation path are the backstop this removes.
CLAUDE_CODE_DISABLE_BG_SHELL_PRESSURE_REAP=1
export CLAUDE_CODE_DISABLE_BG_SHELL_PRESSURE_REAP

failure_stage="run-directory"
failure_cause="could not create run directory $MINOS_RUN_DIR"
mkdir -p "$MINOS_RUN_DIR"
failure_cause="could not enter run directory $MINOS_RUN_DIR"
cd "$MINOS_RUN_DIR"

if [ -n "${MINOS_FAILURE_LOG:-}" ]; then
  failure_stage="failure-log"
  failure_cause="MINOS_FAILURE_LOG ($MINOS_FAILURE_LOG) is not writable"
  mkdir -p "$(dirname "$MINOS_FAILURE_LOG")" 2>/dev/null || true
  : >>"$MINOS_FAILURE_LOG" || {
    echo "run-body: MINOS_FAILURE_LOG ($MINOS_FAILURE_LOG) is not writable" >&2
    exit 1
  }
fi

HOME="${MINOS_RUN_DIR%/}/home"
CLAUDE_CONFIG_DIR="$HOME/.claude"
CODEX_HOME="$HOME/.codex"
XDG_STATE_HOME="${MINOS_RUN_DIR%/}/state"
# Pin the data home to the run-private HOME's default: an ambient
# XDG_DATA_HOME in the service environment would silently relocate the
# Ensemble launcher's direct-launch run records outside the run directory,
# emptying the timing record's worker rows and dodging the archive.
XDG_DATA_HOME="$HOME/.local/share"
failure_stage="runtime-home"
MINOS_RUNS_DIR="$(dirname "${MINOS_RUN_DIR%/}")"
# Workers write large artefacts to temp; the box's shared tmpfs /tmp cannot
# hold concurrent runs' output. Keep a short, private temp path on the same
# disk-backed Minos storage and remove it with the run.
MINOS_RUN_TMP_ROOT="$(dirname "$MINOS_RUNS_DIR")/tmp"
failure_cause="could not create run temp directory root $MINOS_RUN_TMP_ROOT"
mkdir -p "$MINOS_RUN_TMP_ROOT"
failure_cause="could not secure run temp directory root $MINOS_RUN_TMP_ROOT"
chmod 700 "$MINOS_RUN_TMP_ROOT"
failure_cause="could not create isolated run temp directory in $MINOS_RUN_TMP_ROOT"
run_tmpdir="$(mktemp -d "$MINOS_RUN_TMP_ROOT/t.XXXXXXXXXX")"
TMPDIR="$run_tmpdir"
export HOME CLAUDE_CONFIG_DIR CODEX_HOME XDG_STATE_HOME XDG_DATA_HOME \
  TMPDIR
failure_stage="runtime-home"
failure_cause="could not create isolated runtime home and state directories"
mkdir -p "$CLAUDE_CONFIG_DIR" "$CLAUDE_CONFIG_DIR/projects" "$CODEX_HOME" "$XDG_STATE_HOME"
failure_cause="could not secure isolated runtime home and state directories"
chmod 700 "$HOME" "$CLAUDE_CONFIG_DIR" "$CLAUDE_CONFIG_DIR/projects" "$CODEX_HOME" "$XDG_STATE_HOME" "$TMPDIR"
failure_stage="claude-seed"
failure_cause="could not copy Claude configuration seed from $MINOS_CLAUDE_CONFIG_SEED"
cp -R "${MINOS_CLAUDE_CONFIG_SEED%/}/." "$CLAUDE_CONFIG_DIR/"
failure_stage="codex-seed"
failure_cause="could not copy Codex configuration seed from $MINOS_CODEX_CONFIG_SEED"
cp -R "${MINOS_CODEX_CONFIG_SEED%/}/." "$CODEX_HOME/"
failure_stage="runtime-home"
failure_cause="could not secure copied Claude and Codex configuration"
chmod -R go-rwx "$CLAUDE_CONFIG_DIR" "$CODEX_HOME"
failure_stage="claude-seed"
failure_cause="could not write Claude onboarding acceptance"
printf '%s\n' '{"hasCompletedOnboarding":true,"bypassPermissionsModeAccepted":true}' \
  >"$CLAUDE_CONFIG_DIR/.claude.json"
failure_cause="could not secure Claude onboarding acceptance"
chmod 600 "$CLAUDE_CONFIG_DIR/.claude.json"
# The vendored skill tree holds one copy per agent tool; each session gets
# the casting made for the tool it runs on.
failure_stage="vendored-skills"
failure_cause="could not create the vendored skill directories"
mkdir -p "$CLAUDE_CONFIG_DIR/skills" "$CODEX_HOME/skills"
failure_cause="could not copy the vendored Claude Code skills from $MINOS_SKILLS_DIR/claude-code"
cp -R "${MINOS_SKILLS_DIR%/}/claude-code/." "$CLAUDE_CONFIG_DIR/skills/"
failure_cause="could not copy the vendored Codex skills from $MINOS_SKILLS_DIR/codex"
cp -R "${MINOS_SKILLS_DIR%/}/codex/." "$CODEX_HOME/skills/"

failure_stage="workspace-setup"
failure_cause="workspace setup failed"
"$MINOS_SETUP_WORKSPACE"
setup_head="$(jq -r '.head // empty' "$MINOS_ORIENTATION" 2>/dev/null || true)"
if [ -n "$setup_head" ]; then
  MINOS_HEAD_SHA="$setup_head"
  export MINOS_HEAD_SHA
fi

trap 'exit 129' 1
trap 'exit 130' 2
trap 'exit 143' 15

failure_stage="lifecycle-instruction"
failure_cause="could not read lifecycle instruction $instruction_path"
instruction="$(cat "$instruction_path")"
session_name="minos-${MINOS_OWNER:-run}-${MINOS_REPO_NAME:-lead}-pr${MINOS_PR:-unknown}"
completion_marker="$MINOS_RUN_DIR/lead-complete"
pressure_signal="$MINOS_RUN_DIR/memory-pressure"
# During review the run tree may write only at phase transitions, measured
# roughly 19–21 minutes apart on 2026-07-27. Do not tune this below about an
# hour or a healthy review can hit the silence backstop.
silence_timeout="${MINOS_LEAD_SILENCE_TIMEOUT:-3600}"
failure_stage="configuration"
failure_cause="MINOS_LEAD_SILENCE_TIMEOUT must be whole seconds"
case "$silence_timeout" in
  *[!0-9]*|'')
    echo "run-body: MINOS_LEAD_SILENCE_TIMEOUT must be whole seconds" >&2
    exit 1
    ;;
esac
# A digit string too large for shell integer arithmetic makes the backstop
# comparison error out on every poll, silently removing the backstop rather
# than lengthening it. Cap it at a week, which is far beyond the systemd unit's
# own 12-hour bound.
if [ "$silence_timeout" -gt 604800 ] 2>/dev/null; then
  echo "run-body: MINOS_LEAD_SILENCE_TIMEOUT must not exceed 604800 seconds" >&2
  exit 1
elif ! [ "$silence_timeout" -ge 0 ] 2>/dev/null; then
  echo "run-body: MINOS_LEAD_SILENCE_TIMEOUT is out of range" >&2
  exit 1
fi

pressure_enabled=true
pressure_latched=false
pressure_samples=0
resolve_cgroup_dir

disable_pressure_watch() {
  echo "run-body: memory-pressure watch disabled: $1" >&2
  pressure_enabled=false
}

sample_memory_pressure() {
  [ "$pressure_enabled" = true ] || return 0
  # Use memory.current as a cheap probe that this is a readable cgroup before
  # attempting the counters that make up the pressure metric.
  if [ ! -r "$cgroup_dir/memory.current" ]; then
    disable_pressure_watch "memory.current is unavailable in $cgroup_dir"
    return 0
  fi
  IFS= read -r memory_max <"$cgroup_dir/memory.max" || memory_max=""
  if [ "$memory_max" = "max" ]; then
    disable_pressure_watch "memory.max has no ceiling"
    return 0
  fi
  read_cgroup_memory_counters
  for memory_counter in "$memory_max" "$cgroup_anon" "$cgroup_swap"; do
    case "$memory_counter" in
      *[!0-9]*|'')
        disable_pressure_watch "cgroup memory counters are unavailable or malformed"
        return 0
        ;;
    esac
  done
  memory_pressure=$((cgroup_anon + cgroup_swap))
  # The running peak of genuine footprint is the capacity number the timing
  # record carries: what this run actually needed at its hungriest, sampled
  # every poll, ceilings and admission judgements read it later. Tracked past
  # the latch — the hungriest moment often follows the signal.
  if [ "$memory_pressure" -gt "${peak_anon_swap:-0}" ]; then
    peak_anon_swap=$memory_pressure
    printf '%s\n' "$peak_anon_swap" >"$MINOS_RUN_DIR/memory-peak" || true
  fi
  [ "$pressure_latched" = false ] || return 0
  pressure_threshold=$((memory_max / 100 * 85))
  if [ "$memory_pressure" -ge "$pressure_threshold" ]; then
    pressure_samples=$((pressure_samples + 1))
  else
    pressure_samples=0
  fi
  [ "$pressure_samples" -ge 2 ] || return 0

  pressure_gib="$(awk -v bytes="$memory_pressure" 'BEGIN { printf "%.1f", bytes / 1073741824 }')"
  maximum_gib="$(awk -v bytes="$memory_max" 'BEGIN { printf "%.1f", bytes / 1073741824 }')"
  swap_gib="$(awk -v bytes="$cgroup_swap" 'BEGIN { printf "%.1f", bytes / 1073741824 }')"
  if ! printf 'memory approaching the run ceiling: %s GiB of %s GiB in anonymous memory plus swap, %s GiB swap in use — finish this stage and hand off\n' \
    "$pressure_gib" "$maximum_gib" "$swap_gib" >"$pressure_signal"; then
    supervisor_failure=true
    failure_stage="memory-pressure-watch"
    failure_cause="could not write memory-pressure signal $pressure_signal"
    return 1
  fi
  pressure_latched=true
}

# Baseline memory snapshot for the timing record's stall and thrash deltas.
# Presentation-class residue: its absence never blocks the run.
"$(dirname "$0")/memory-telemetry" "$MINOS_RUN_DIR/memory-baseline.json" || true

failure_stage="lead-launch"
failure_cause="Claude lead launch failed"
last_activity_signature="$(
  find "$MINOS_RUN_DIR" -mindepth 1 \( -path "$HOME" -o -path "$pressure_signal" -o -path "$MINOS_RUN_DIR/memory-peak" \) -prune \
    -o -printf '%T@:%i:%s\n' 2>/dev/null |
    LC_ALL=C sort -rn |
    head -n 1
)"
MINOS_LEAD_MODEL="${MINOS_LEAD_MODEL:-claude-opus-5-5}"
export MINOS_LEAD_MODEL
launch_output="$("$MINOS_CLAUDE" \
  --bg \
  --name "$session_name" \
  --dangerously-skip-permissions \
  --model "$MINOS_LEAD_MODEL" \
  "$instruction" 2>&1)"
failure_cause="could not write Claude lead launch output"
printf '%s\n' "$launch_output"

failure_cause="could not parse Claude background session ID"
session_id="$(printf '%s\n' "$launch_output" | sed -nE 's/.*[Bb]ackgrounded[^[:xdigit:]]*([[:xdigit:]]{6,}).*/\1/p' | head -n 1)"
if [ -z "$session_id" ]; then
  failure_cause="Claude did not report a background session ID"
  echo "run-body: Claude did not report a background session ID" >&2
  exit 1
fi
prelaunch=false
lead_activity_seen=false
last_activity_at="$(date +%s)"

while :; do
  agent_state=""
  if agents="$("$MINOS_CLAUDE" agents --json --all)"; then
    agent_state="$(printf '%s' "$agents" | jq -r --arg id "$session_id" '
      (if type == "array" then . else .agents end)[] |
      select(.id == $id) |
      .state // empty
    ' 2>/dev/null)" || agent_state=""
  fi

  # 1. The lead has declared that all terminal obligations are complete. The
  #    result is scratch; the forge and failure log carry the durable outcome.
  if [ -f "$completion_marker" ] &&
    grep -Eqx 'clean|non-clean|continuation' "$completion_marker" 2>/dev/null; then
    if grep -Eqx 'continuation' "$completion_marker" 2>/dev/null; then
      echo "run-body: lead ended this run as a continuation"
    fi
    break
  fi

  sample_memory_pressure

  # 2. Work by the lead and its subprocesses changes the run tree outside the
  #    isolated home. Exclude home because both this supervisor's roster poll
  #    and Claude's daemon can update config, job state, caches and updater
  #    downloads there without useful lead work.
  activity_signature="$(
    find "$MINOS_RUN_DIR" -mindepth 1 \( -path "$HOME" -o -path "$pressure_signal" -o -path "$MINOS_RUN_DIR/memory-peak" \) -prune \
      -o -printf '%T@:%i:%s\n' 2>/dev/null |
      LC_ALL=C sort -rn |
      head -n 1
  )"
  if [ "$activity_signature" != "$last_activity_signature" ]; then
    last_activity_signature="$activity_signature"
    lead_activity_seen=true
    last_activity_at="$(date +%s)"
  fi

  # Claude also uses blocked for resumable waits after a turn, so it is not
  # terminal once useful work has begun. Before the lead changes the run tree,
  # however, blocked means the first turn cannot make progress and no lifecycle
  # code exists yet to record or recover the failure.
  if [ "$agent_state" = "blocked" ] && [ "$lead_activity_seen" = false ]; then
    supervisor_failure=true
    failure_stage="lead-supervision"
    failure_cause="Claude lead entered blocked state before producing run activity"
    exit 1
  fi

  # 3. Claude has reported an unrecoverable terminal state.
  if [ "$agent_state" = "failed" ] || [ "$agent_state" = "stopped" ]; then
    if ! capture_cgroup_death_evidence; then
      supervisor_failure=true
      failure_stage="cgroup-death-evidence"
      failure_cause="could not write cgroup death evidence $MINOS_RUN_DIR/cgroup-death-evidence"
      exit 1
    fi
    break
  fi

  now="$(date +%s)"
  if [ $((now - last_activity_at)) -ge "$silence_timeout" ]; then
    supervisor_failure=true
    failure_stage="lead-supervision"
    failure_cause="Claude lead produced no run activity for ${silence_timeout} seconds (last state: ${agent_state:-unknown})"
    exit 1
  fi
  sleep "${MINOS_CLAUDE_POLL_SECONDS:-3}"
done

stop_session
session_id=""
