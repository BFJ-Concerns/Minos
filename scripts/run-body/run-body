#!/usr/bin/env sh
set -eu

: "${PUMP19_CONFIG:?PUMP19_CONFIG is required}"
: "${PUMP19_RUN_DIR:?PUMP19_RUN_DIR is required}"
: "${PUMP19_RUN_KIND:?PUMP19_RUN_KIND is required}"

config_file="${PUMP19_CONFIG%/}/run-body.env"
if [ ! -r "$config_file" ]; then
  echo "run-body configuration is not readable: $config_file" >&2
  exit 2
fi

# These values are deployment configuration and must reach the accountable
# session unchanged. Export while sourcing rather than maintaining a second
# list of fields here.
set -a
# shellcheck source=/dev/null
. "$config_file"
set +a

: "${PUMP19_ENGINE_LAUNCH_LEAD:?PUMP19_ENGINE_LAUNCH_LEAD is required}"
: "${PUMP19_ENSEMBLE_LAUNCH:?PUMP19_ENSEMBLE_LAUNCH is required}"
: "${PUMP19_PINS:?PUMP19_PINS is required}"
: "${PUMP19_REVIEW_SCRIPTS:?PUMP19_REVIEW_SCRIPTS is required}"
: "${PUMP19_BIN:?PUMP19_BIN is required}"

case "$PUMP19_RUN_KIND" in
  review)
    script_dir=$(unset CDPATH; cd "$(dirname "$0")" && pwd)
    mission="${script_dir%/run-body}/missions/review.md"
    if [ ! -r "$mission" ]; then
      echo "review mission is not readable: $mission" >&2
      exit 2
    fi
    mkdir -p "$PUMP19_RUN_DIR/sessions"
    cd "$PUMP19_RUN_DIR"
    exec "$PUMP19_BIN" capture-claude \
      --pins "$PUMP19_PINS" \
      --output "$PUMP19_RUN_DIR/sessions/lead.jsonl" \
      --resolved "$PUMP19_RUN_DIR/resolved-lead.json" \
      "$PUMP19_ENGINE_LAUNCH_LEAD" <"$mission"
    ;;
  fix|finish)
    echo "run kind '$PUMP19_RUN_KIND' is recognised but not yet implemented" >&2
    exit 3
    ;;
  *)
    echo "unknown run kind '$PUMP19_RUN_KIND'" >&2
    exit 2
    ;;
esac
