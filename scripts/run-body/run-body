#!/usr/bin/env sh
set -eu

prelaunch=true
failure_stage="configuration"
failure_cause="run-body exited before loading its configuration"
session_id=""

stop_session() {
  if [ -n "$session_id" ]; then
    "$MINOS_CLAUDE" stop "$session_id" >/dev/null 2>&1 || true
  fi
}

append_prelaunch_failure() {
  [ -n "${MINOS_FAILURE_LOG:-}" ] || return 0

  failure_directory="$(dirname "$MINOS_FAILURE_LOG")"
  mkdir -p "$failure_directory" 2>/dev/null || true
  timestamp="$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null)" || timestamp="unknown"
  pull_request="${MINOS_OWNER:-unknown}/${MINOS_REPO_NAME:-unknown}#${MINOS_PR:-unknown}"
  if ! printf 'timestamp=%s pull_request=%s head=%s stage=%s cause=%s\n' \
    "$timestamp" "$pull_request" "${MINOS_HEAD_SHA:-unknown}" \
    "$failure_stage" "$failure_cause" >>"$MINOS_FAILURE_LOG"; then
    echo "run-body: MINOS_FAILURE_LOG ($MINOS_FAILURE_LOG) is not writable" >&2
  fi
}

on_exit() {
  status="$1"
  trap - 0
  set +e
  if [ "$prelaunch" = true ] && [ "$status" -ne 0 ]; then
    append_prelaunch_failure
  fi
  stop_session
  exit "$status"
}
trap 'on_exit $?' 0

failure_cause="MINOS_CONFIG is required"
: "${MINOS_CONFIG:?MINOS_CONFIG is required}"
failure_cause="MINOS_RUN_DIR is required"
: "${MINOS_RUN_DIR:?MINOS_RUN_DIR is required}"

unset_gateway_environment() {
  unset ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL ANTHROPIC_DEFAULT_HAIKU_MODEL
  unset CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY CLAUDE_CODE_MAX_CONTEXT_TOKENS
  unset CLAUDE_CODE_AUTO_COMPACT_WINDOW MINOS_ANTHROPIC_CREDENTIAL_FILE
}

unset_gateway_environment

set -a
# shellcheck source=/dev/null
failure_cause="could not load ${MINOS_CONFIG%/}/run-body.env"
. "${MINOS_CONFIG%/}/run-body.env"
set +a

if [ -n "${MINOS_ANTHROPIC_CREDENTIAL_FILE:-}" ]; then
  failure_cause="ANTHROPIC_BASE_URL is required in gateway mode"
  : "${ANTHROPIC_BASE_URL:?ANTHROPIC_BASE_URL is required in gateway mode}"
  if [ ! -f "$MINOS_ANTHROPIC_CREDENTIAL_FILE" ] ||
    [ ! -r "$MINOS_ANTHROPIC_CREDENTIAL_FILE" ]; then
    failure_cause="gateway credential file ($MINOS_ANTHROPIC_CREDENTIAL_FILE) is missing or unreadable"
    echo "run-body: gateway credential file ($MINOS_ANTHROPIC_CREDENTIAL_FILE) is missing or unreadable" >&2
    exit 1
  fi
  ANTHROPIC_AUTH_TOKEN=""
  IFS= read -r ANTHROPIC_AUTH_TOKEN <"$MINOS_ANTHROPIC_CREDENTIAL_FILE" || true
  if [ -z "$ANTHROPIC_AUTH_TOKEN" ]; then
    failure_cause="gateway credential file ($MINOS_ANTHROPIC_CREDENTIAL_FILE) is empty"
    echo "run-body: gateway credential file ($MINOS_ANTHROPIC_CREDENTIAL_FILE) is empty" >&2
    exit 1
  fi
  export ANTHROPIC_AUTH_TOKEN
else
  unset_gateway_environment
fi

failure_cause="MINOS_CLAUDE is required"
: "${MINOS_CLAUDE:?MINOS_CLAUDE is required}"
failure_cause="MINOS_CLAUDE_CONFIG_SEED is required"
: "${MINOS_CLAUDE_CONFIG_SEED:?MINOS_CLAUDE_CONFIG_SEED is required}"
failure_cause="MINOS_CODEX_CONFIG_SEED is required"
: "${MINOS_CODEX_CONFIG_SEED:?MINOS_CODEX_CONFIG_SEED is required}"
failure_cause="MINOS_LIFECYCLE_INSTRUCTION is required"
: "${MINOS_LIFECYCLE_INSTRUCTION:?MINOS_LIFECYCLE_INSTRUCTION is required}"
failure_cause="MINOS_ROOT_CAUSE_SKILL is required"
: "${MINOS_ROOT_CAUSE_SKILL:?MINOS_ROOT_CAUSE_SKILL is required}"
failure_cause="MINOS_SETUP_WORKSPACE is required"
: "${MINOS_SETUP_WORKSPACE:?MINOS_SETUP_WORKSPACE is required}"
failure_cause="MINOS_ORIENTATION is required"
: "${MINOS_ORIENTATION:?MINOS_ORIENTATION is required}"
failure_cause="MINOS_GIT_AUTHOR_NAME is required"
: "${MINOS_GIT_AUTHOR_NAME:?MINOS_GIT_AUTHOR_NAME is required}"
failure_cause="MINOS_GIT_AUTHOR_EMAIL is required"
: "${MINOS_GIT_AUTHOR_EMAIL:?MINOS_GIT_AUTHOR_EMAIL is required}"

FORCE_COLOR=0
export FORCE_COLOR
GIT_AUTHOR_NAME="$MINOS_GIT_AUTHOR_NAME"
GIT_AUTHOR_EMAIL="$MINOS_GIT_AUTHOR_EMAIL"
GIT_COMMITTER_NAME="$MINOS_GIT_AUTHOR_NAME"
GIT_COMMITTER_EMAIL="$MINOS_GIT_AUTHOR_EMAIL"
export GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL

failure_stage="run-directory"
failure_cause="could not create run directory $MINOS_RUN_DIR"
mkdir -p "$MINOS_RUN_DIR"
failure_cause="could not enter run directory $MINOS_RUN_DIR"
cd "$MINOS_RUN_DIR"

if [ -n "${MINOS_FAILURE_LOG:-}" ]; then
  failure_stage="failure-log"
  failure_cause="MINOS_FAILURE_LOG ($MINOS_FAILURE_LOG) is not writable"
  mkdir -p "$(dirname "$MINOS_FAILURE_LOG")" 2>/dev/null || true
  : >>"$MINOS_FAILURE_LOG" || {
    echo "run-body: MINOS_FAILURE_LOG ($MINOS_FAILURE_LOG) is not writable" >&2
    exit 1
  }
fi

HOME="${MINOS_RUN_DIR%/}/home"
CLAUDE_CONFIG_DIR="$HOME/.claude"
CODEX_HOME="$HOME/.codex"
export HOME CLAUDE_CONFIG_DIR CODEX_HOME
failure_stage="runtime-home"
failure_cause="could not create isolated Claude and Codex configuration directories"
mkdir -p "$CLAUDE_CONFIG_DIR" "$CLAUDE_CONFIG_DIR/projects" "$CODEX_HOME"
failure_cause="could not secure isolated Claude and Codex configuration directories"
chmod 700 "$HOME" "$CLAUDE_CONFIG_DIR" "$CLAUDE_CONFIG_DIR/projects" "$CODEX_HOME"
failure_stage="claude-seed"
failure_cause="could not copy Claude configuration seed from $MINOS_CLAUDE_CONFIG_SEED"
cp -R "${MINOS_CLAUDE_CONFIG_SEED%/}/." "$CLAUDE_CONFIG_DIR/"
failure_stage="codex-seed"
failure_cause="could not copy Codex configuration seed from $MINOS_CODEX_CONFIG_SEED"
cp -R "${MINOS_CODEX_CONFIG_SEED%/}/." "$CODEX_HOME/"
failure_stage="runtime-home"
failure_cause="could not secure copied Claude and Codex configuration"
chmod -R go-rwx "$CLAUDE_CONFIG_DIR" "$CODEX_HOME"
failure_stage="claude-seed"
failure_cause="could not write Claude onboarding acceptance"
printf '%s\n' '{"hasCompletedOnboarding":true,"bypassPermissionsModeAccepted":true}' \
  >"$CLAUDE_CONFIG_DIR/.claude.json"
failure_cause="could not secure Claude onboarding acceptance"
chmod 600 "$CLAUDE_CONFIG_DIR/.claude.json"
failure_stage="root-cause-skill"
failure_cause="could not create the vendored root-cause skill directory"
mkdir -p "$CLAUDE_CONFIG_DIR/skills/root-cause"
failure_cause="could not copy the vendored root-cause skill from $MINOS_ROOT_CAUSE_SKILL"
cp -R "${MINOS_ROOT_CAUSE_SKILL%/}/." "$CLAUDE_CONFIG_DIR/skills/root-cause/"

failure_stage="workspace-setup"
failure_cause="workspace setup failed"
"$MINOS_SETUP_WORKSPACE"

trap 'exit 129' 1
trap 'exit 130' 2
trap 'exit 143' 15

failure_stage="lifecycle-instruction"
failure_cause="could not read lifecycle instruction $MINOS_LIFECYCLE_INSTRUCTION"
instruction="$(cat "$MINOS_LIFECYCLE_INSTRUCTION")"
session_name="minos-${MINOS_OWNER:-run}-${MINOS_REPO_NAME:-lead}-pr${MINOS_PR:-unknown}"
completion_marker="$MINOS_RUN_DIR/lead-complete"
# During review the run tree may write only at phase transitions, measured
# roughly 19–21 minutes apart on 2026-07-27. Do not tune this below about an
# hour or a healthy review can hit the silence backstop.
silence_timeout="${MINOS_LEAD_SILENCE_TIMEOUT:-3600}"
failure_stage="configuration"
failure_cause="MINOS_LEAD_SILENCE_TIMEOUT must be whole seconds"
case "$silence_timeout" in
  *[!0-9]*|'')
    echo "run-body: MINOS_LEAD_SILENCE_TIMEOUT must be whole seconds" >&2
    exit 1
    ;;
esac
# A digit string too large for shell integer arithmetic makes the backstop
# comparison error out on every poll, silently removing the backstop rather
# than lengthening it. Cap it at a week, which is far beyond the systemd unit's
# own 12-hour bound.
if [ "$silence_timeout" -gt 604800 ] 2>/dev/null; then
  echo "run-body: MINOS_LEAD_SILENCE_TIMEOUT must not exceed 604800 seconds" >&2
  exit 1
elif ! [ "$silence_timeout" -ge 0 ] 2>/dev/null; then
  echo "run-body: MINOS_LEAD_SILENCE_TIMEOUT is out of range" >&2
  exit 1
fi
failure_stage="lead-launch"
failure_cause="Claude lead launch failed"
launch_output="$("$MINOS_CLAUDE" \
  --bg \
  --name "$session_name" \
  --dangerously-skip-permissions \
  --model "${MINOS_LEAD_MODEL:-claude-opus-5}" \
  "$instruction" 2>&1)"
failure_cause="could not write Claude lead launch output"
printf '%s\n' "$launch_output"

failure_cause="could not parse Claude background session ID"
session_id="$(printf '%s\n' "$launch_output" | sed -nE 's/.*[Bb]ackgrounded[^[:xdigit:]]*([[:xdigit:]]{6,}).*/\1/p' | head -n 1)"
if [ -z "$session_id" ]; then
  failure_cause="Claude did not report a background session ID"
  echo "run-body: Claude did not report a background session ID" >&2
  exit 1
fi
prelaunch=false
last_activity_signature=""
last_activity_at="$(date +%s)"

while :; do
  agent_state=""
  if agents="$("$MINOS_CLAUDE" agents --json --all)"; then
    agent_state="$(printf '%s' "$agents" | jq -r --arg id "$session_id" '
      (if type == "array" then . else .agents end)[] |
      select(.id == $id) |
      .state // empty
    ' 2>/dev/null)" || agent_state=""
  fi

  # 1. Claude has reported an unrecoverable terminal state.
  if [ "$agent_state" = "failed" ] || [ "$agent_state" = "stopped" ]; then
    break
  fi

  # 2. The lead has declared that all terminal obligations are complete. The
  #    result is scratch; the forge and failure log carry the durable outcome.
  if [ -f "$completion_marker" ] &&
    grep -Eqx 'clean|non-clean' "$completion_marker" 2>/dev/null; then
    break
  fi

  # 3. Work by the lead and its subprocesses changes the run tree outside the
  #    isolated home. Exclude home because both this supervisor's roster poll
  #    and Claude's daemon can update config, job state, caches and updater
  #    downloads there without useful lead work.
  activity_signature="$(
    find "$MINOS_RUN_DIR" -path "$HOME" -prune -o -printf '%T@:%i:%s\n' 2>/dev/null |
      LC_ALL=C sort -rn |
      head -n 1
  )"
  if [ -n "$activity_signature" ] &&
    [ "$activity_signature" != "$last_activity_signature" ]; then
    last_activity_signature="$activity_signature"
    last_activity_at="$(date +%s)"
  fi
  now="$(date +%s)"
  if [ $((now - last_activity_at)) -ge "$silence_timeout" ]; then
    break
  fi
  sleep "${MINOS_CLAUDE_POLL_SECONDS:-3}"
done

stop_session
session_id=""
