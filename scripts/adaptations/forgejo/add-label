#!/usr/bin/env sh
set -eu
. "$(dirname "$0")/common.sh"

owner="$1"
repo="$2"
pr="$3"
label="$4"

api POST "/api/v1/repos/${owner}/${repo}/issues/${pr}/labels" \
  -H "Content-Type: application/json" \
  --data "$(jq -nc --arg label "$label" '{labels: [$label]}')" >/dev/null

# Forgejo returns success even when a requested label does not exist in the
# repository vocabulary. Read the PR back so that false success is operationally
# loud rather than leaving the loop looking mysteriously idle.
issue="$(api GET "/api/v1/repos/${owner}/${repo}/issues/${pr}")"
if ! printf '%s\n' "$issue" | jq -e --arg label "$label" \
  'any(.labels[]?; .name == $label)' >/dev/null; then
  printf 'label "%s" is absent after Forgejo accepted the write\n' "$label" >&2
  exit 1
fi
