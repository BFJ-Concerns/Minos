#!/usr/bin/env sh
set -eu
. "$(dirname "$0")/common.sh"

owner="$1"
repo="$2"
sha="$3"

api GET "/api/v1/repos/${owner}/${repo}/commits/${sha}/statuses" |
  jq 'map(if (.id | type) == "number" and .id > 0 then {id: .id, context: .context, state: (.status // .state), creator: (.creator.login // .creator.username // "")} else error("Forgejo status is missing a positive id") end) | sort_by(.id) | reverse'
