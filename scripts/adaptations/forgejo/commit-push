#!/usr/bin/env sh
set -eu
# shellcheck source-path=SCRIPTDIR
. "$(dirname "$0")/common.sh"

# Land a fix as an ordinary attributed commit on the PR's head branch. The fix
# session edits the workspace; this script — holding the service credential the
# session never sees — commits and pushes. The credential reaches git only
# through GIT_ASKPASS (a temp file outside the workspace), never written into
# the workspace's own git config. The push is a plain fast-forward: a fix is
# never force-pushed, so a non-fast-forward is a loud failure, not a rewrite.

owner="$1"
repo="$2"
# Argument 3 is the PR number, part of the mission's uniform adaptation call
# shape; the push targets the branch, so it is not read here.
head_branch="$4"
author_name="$5"
author_email="$6"
model="$7"
message_file="$8"

: "${PUMP19_WORKSPACE:?PUMP19_WORKSPACE is required}"

if [ -z "$head_branch" ]; then
  echo "commit-push: head branch is empty (unwritable head has no fix path)" >&2
  exit 2
fi
if [ ! -s "$message_file" ]; then
  echo "commit-push: commit message file is empty: $message_file" >&2
  exit 2
fi

# The session gates fruitlessness upstream; a genuinely empty tree here is a
# contract breach, not a silent no-op.
if [ -z "$(git -C "$PUMP19_WORKSPACE" status --porcelain)" ]; then
  echo "commit-push: workspace has no changes to commit" >&2
  exit 3
fi

tmp_askpass="$(mktemp)"
cleanup() {
  rm -f "$tmp_askpass"
}
trap cleanup EXIT
cat >"$tmp_askpass" <<EOF
#!/usr/bin/env sh
case "\$1" in
  *Username*) printf '%s\n' x-access-token ;;
  *Password*) printf '%s\n' "${PUMP19_FORGE_TOKEN}" ;;
  *) printf '\n' ;;
esac
EOF
chmod 700 "$tmp_askpass"

repo_url="${PUMP19_API_BASE%/}/${owner}/${repo}.git"

# Build the commit message: the session's prose plus the model-provenance
# trailer, so the branch history records which model authored the fix.
commit_message="$(mktemp)"
trap 'rm -f "$tmp_askpass" "$commit_message"' EXIT
{
  cat "$message_file"
  printf '\n'
  printf 'Pump-19-Model: %s\n' "$model"
} >"$commit_message"

(
  cd "$PUMP19_WORKSPACE"
  git remote set-url origin "$repo_url"
  git add -A
  GIT_AUTHOR_NAME="$author_name" GIT_AUTHOR_EMAIL="$author_email" \
    GIT_COMMITTER_NAME="$author_name" GIT_COMMITTER_EMAIL="$author_email" \
    git commit -q -F "$commit_message"
  # Fast-forward only. HEAD is the detached head checkout plus the fix commit;
  # pushing it to the branch ref advances the branch without rewriting it.
  GIT_ASKPASS="$tmp_askpass" git push origin "HEAD:refs/heads/${head_branch}" >/dev/null 2>&1
  if grep -R "${PUMP19_FORGE_TOKEN}" .git/config >/dev/null 2>&1; then
    echo "credential leaked into .git/config" >&2
    exit 1
  fi
  # The pushed head SHA is the fix's landing identity; report it for the record.
  git rev-parse HEAD
)
