#!/usr/bin/env sh
set -eu
. "$(dirname "$0")/common.sh"

owner="$1"
repo="$2"
pr="$3"
login="$4"

pull_request="$(api GET "/api/v1/repos/${owner}/${repo}/pulls/${pr}")"
if printf '%s' "$pull_request" | jq -e --arg login "$login" \
  'any(.assignees[]?; ((.login // .username // "") | ascii_downcase) == ($login | ascii_downcase))' >/dev/null; then
  exit 0
fi

api PATCH "/api/v1/repos/${owner}/${repo}/issues/${pr}" \
  -H "Content-Type: application/json" \
  --data "$(jq -nc --arg login "$login" '{assignees: [$login]}')" >/dev/null
