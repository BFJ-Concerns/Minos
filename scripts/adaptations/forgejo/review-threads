#!/usr/bin/env sh
set -eu
# shellcheck source-path=SCRIPTDIR
. "$(dirname "$0")/common.sh"

# Forgejo stores a conversation's replies in the opening review, at
# the same path and signed line. Only the opening comment carries the
# conversation's resolution.
owner="$1"
repo="$2"
pr="$3"

reviews="$(pull_request_reviews "$owner" "$repo" "$pr")"
threads='[]'
for review_id in $(printf '%s' "$reviews" | jq -r '.[] | select((.comments_count // 1) > 0) | .id'); do
  review_comments="$(api GET "/api/v1/repos/${owner}/${repo}/pulls/${pr}/reviews/${review_id}/comments")"
  # A review with no inline comments may answer null.
  review_threads="$(printf '%s' "$review_comments" | jq -ce '
    def site: if (.position // 0) > 0 then .position else -(.original_position // 0) end;
    if . == null then [] elif type == "array" and all(.[]; type == "object") then .
    else error("expected a review-comment array") end |
    group_by([(.path // ""), site]) | map(sort_by((.created_at // ""), (.id // 0)) | {
      path: (.[0].path // ""),
      line: (.[0] | site | if . < 0 then -. else . end),
      resolved: (.[0].resolver != null),
      outdated: false,
      comments: map({
        user: (.user.login // .user.username // ""),
        body: (.body // ""),
        commit_id: (.original_commit_id // .commit_id // ""),
        review_id: (.pull_request_review_id // 0)
      })
    })')"
  threads="$(json_concat "$threads" "$review_threads")"
done
printf '%s\n' "$threads"
