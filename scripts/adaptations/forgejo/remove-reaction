#!/usr/bin/env sh
set -eu
. "$(dirname "$0")/common.sh"

owner="$1"
repo="$2"
pr="$3"
reaction="$4"

if ! api_with_status DELETE "/api/v1/repos/${owner}/${repo}/issues/${pr}/reactions" \
  -H "Content-Type: application/json" \
  --data "$(jq -nc --arg content "$reaction" '{content: $content}')"; then
  echo "remove-reaction: forge response could not be read" >&2
  exit 1
fi

# Forgejo may report an already-absent reaction as 404. Removal is a desired-
# state operation, so confirmed absence is success and remains safe to repeat.
case "$api_status_code" in
  200|201|204|404) ;;
  *) echo "remove-reaction: Forgejo returned HTTP ${api_status_code}" >&2; exit 1 ;;
esac
