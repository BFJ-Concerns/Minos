#!/usr/bin/env sh
set -eu
. "$(dirname "$0")/common.sh"

owner="$1"
repo="$2"
sha="$3"

# Forgejo's combined endpoint applies the forge's own cross-context precedence.
# The sweep must not invent a subtly different idea of green from individual
# statuses (in particular, Forgejo renders an individual error as failure here).
api GET "/api/v1/repos/${owner}/${repo}/commits/${sha}/status" |
  jq -c '{state: (.state // .status // "")}'
