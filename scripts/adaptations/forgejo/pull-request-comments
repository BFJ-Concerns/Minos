#!/usr/bin/env sh
set -eu
# shellcheck source-path=SCRIPTDIR
. "$(dirname "$0")/common.sh"

# The pull request's conversation comments as one JSON array, oldest first,
# each with its id, its author's login, its body and the time it was
# written.
owner="$1"
repo="$2"
pr="$3"

comments="$(conversation_comments "$owner" "$repo" "$pr")"
printf '%s' "$comments" | jq -c 'sort_by((.created_at // ""), (.id // 0)) | map({
  id: (.id // 0),
  user: (.user.login // .user.username // ""),
  body: (.body // ""),
  created_at: (.created_at // "")
})'
