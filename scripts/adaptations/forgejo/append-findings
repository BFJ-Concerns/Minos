#!/usr/bin/env sh
set -eu
# shellcheck source-path=SCRIPTDIR
. "$(dirname "$0")/common.sh"

# Append review finds to a trusted second repository without exposing the bot
# credential to the review workspace. The destination comes only from strict
# service-side repository configuration; the accountable session supplies the
# evidence file and source PR identity.
: "${PUMP19_FIND_INGEST_REPOSITORY:?PUMP19_FIND_INGEST_REPOSITORY is required}"
: "${PUMP19_FIND_INGEST_PATH:?PUMP19_FIND_INGEST_PATH is required}"
: "${PUMP19_FIX_AUTHOR_NAME:?PUMP19_FIX_AUTHOR_NAME is required}"
: "${PUMP19_FIX_AUTHOR_EMAIL:?PUMP19_FIX_AUTHOR_EMAIL is required}"

source_repo="$1"
source_pr="$2"
findings_file="$3"

if [ ! -s "$findings_file" ]; then
  echo "append-findings: findings file is empty: $findings_file" >&2
  exit 2
fi
if ! jq -e 'type == "array" and length > 0 and all(.[]; (.title | type == "string" and length > 0) and (.message | type == "string" and length > 0))' "$findings_file" >/dev/null; then
  echo "append-findings: findings file is not a valid non-empty finding array" >&2
  exit 2
fi

owner=${PUMP19_FIND_INGEST_REPOSITORY%%/*}
repo=${PUMP19_FIND_INGEST_REPOSITORY#*/}
trusted=$(mktemp -d)
askpass=$(mktemp)
cleanup() {
  rm -rf "$trusted"
  rm -f "$askpass"
}
trap cleanup EXIT

cat >"$askpass" <<EOF
#!/usr/bin/env sh
case "\$1" in
  *Username*) printf '%s\n' x-access-token ;;
  *Password*) printf '%s\n' "${PUMP19_FORGE_TOKEN}" ;;
  *) printf '\n' ;;
esac
EOF
chmod 700 "$askpass"

repo_url="${PUMP19_API_BASE%/}/${owner}/${repo}.git"
GIT_ASKPASS="$askpass" GIT_TERMINAL_PROMPT=0 \
  git -c core.hooksPath=/dev/null clone -q "$repo_url" "$trusted/repo"

log="$trusted/repo/$PUMP19_FIND_INGEST_PATH"
mkdir -p "$(dirname "$log")"
touch "$log"
date=$(date -u +%F)
jq -r --arg source "Pump-19 review of ${source_repo}#${source_pr}, ${date}" \
  '.[] | "- **\(.title | gsub("[\\r\\n]+"; " "))** — \(.message | gsub("[\\r\\n]+"; " ")) Source: \($source)."' \
  "$findings_file" >>"$log"

git -C "$trusted/repo" -c core.hooksPath=/dev/null add -- "$PUMP19_FIND_INGEST_PATH"
GIT_AUTHOR_NAME="$PUMP19_FIX_AUTHOR_NAME" \
GIT_AUTHOR_EMAIL="$PUMP19_FIX_AUTHOR_EMAIL" \
GIT_COMMITTER_NAME="$PUMP19_FIX_AUTHOR_NAME" \
GIT_COMMITTER_EMAIL="$PUMP19_FIX_AUTHOR_EMAIL" \
  git -C "$trusted/repo" -c core.hooksPath=/dev/null \
    commit -qm "chore: record Pump-19 review finds"
GIT_ASKPASS="$askpass" GIT_TERMINAL_PROMPT=0 \
  git -C "$trusted/repo" -c core.hooksPath=/dev/null push -q

printf 'landed %s\n' "$(git -C "$trusted/repo" rev-parse HEAD)"
