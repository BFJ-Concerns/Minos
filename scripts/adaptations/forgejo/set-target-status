#!/usr/bin/env sh
set -eu
# shellcheck source-path=SCRIPTDIR
. "$(dirname "$0")/common.sh"

# Marks a target commit as broken, so every pull request reconciling with it
# defers instead of each one spending a full run to re-prove the same
# breakage. The status lands on the target commit rather than a pull-request
# head, under its own context: that commit is usually a merged pull request's
# head and already carries that pull request's own Minos status.
#
# The guard binds the target, not the head. A marker states something about
# the target branch, which the pull-request head moving does not invalidate,
# and the head may well have moved by the time a run reaches its held stop.
# What would invalidate it is the target having advanced past the commit the
# breakage was proven against — a marker written onto a superseded target is
# stale on arrival and would defer siblings for a state nobody observed.

owner="$1"; repo="$2"; pr="$3"; target="$4"; login="$5"; description="$6"

if [ -z "$target" ] || [ -z "$description" ]; then
  write_result rejected "target status needs a target commit and a reason"
  exit 0
fi

user_json="$(api GET "/api/v1/user")" || { write_result uncertain "forge identity could not be read"; exit 0; }
actual_login="$(printf '%s' "$user_json" | jq -r '.login // .username // ""')"
if [ "$actual_login" != "$login" ]; then
  write_result rejected "authenticated forge identity is ${actual_login:-missing}, expected ${login}"
  exit 0
fi

pr_json="$(api GET "/api/v1/repos/${owner}/${repo}/pulls/${pr}")" || { write_result uncertain "pull request could not be read"; exit 0; }
if ! printf '%s' "$pr_json" | jq -e --arg repository "${owner}/${repo}" --argjson pr "$pr" \
  '.number == $pr and .base.repo.full_name == $repository' >/dev/null; then
  write_result rejected "pull request identity no longer matches"
  exit 0
fi

base_ref="$(printf '%s' "$pr_json" | jq -r '.base.ref // ""')"
base_json="$(api GET "/api/v1/repos/${owner}/${repo}/branches/$(urlencode "$base_ref")")" || { write_result uncertain "target branch could not be read"; exit 0; }
actual_target="$(printf '%s' "$base_json" | jq -r '.commit.id // .commit.sha // ""')"
if [ "$actual_target" != "$target" ]; then
  write_result rejected "target branch has advanced past the proven commit"
  exit 0
fi

web_base="${MINOS_API_BASE%/api/v1}"
# The proving pull request rides the target URL so a deferral can name it.
target_url="${web_base%/}/${owner}/${repo}/pulls/${pr}"
payload="$(jq -nc --arg state failure --arg context "Minos / target" --arg description "$description" --arg target_url "$target_url" \
  '{state:$state,context:$context,description:$description,target_url:$target_url}')"

status_present() {
  statuses="$(api GET "/api/v1/repos/${owner}/${repo}/commits/${target}/statuses" 2>/dev/null)" || return 2
  printf '%s' "$statuses" | jq -e --arg context "Minos / target" --arg login "$login" '
    [.[] | select(.context == $context and (.creator.login // .creator.username // "") == $login)] | length > 0' >/dev/null
}

if status_present; then
  write_result applied "target already marked"
  exit 0
else
  presence=$?
  if [ "$presence" -eq 2 ]; then
    write_result uncertain "target status read-back could not be confirmed"
    exit 0
  fi
fi

api POST "/api/v1/repos/${owner}/${repo}/statuses/${target}" -H "Content-Type: application/json" --data "$payload" >/dev/null 2>&1 || true

if status_present; then
  write_result applied
else
  write_result uncertain "target status write could not be discovered"
fi
