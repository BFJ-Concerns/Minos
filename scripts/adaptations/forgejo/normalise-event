#!/usr/bin/env sh
set -eu

payload="$(cat)"
event="${MINOS_HEADER_X_FORGEJO_EVENT:-${MINOS_HEADER_X_GITEA_EVENT:-}}"

action="$(printf '%s' "$payload" | jq -r '.action // ""')"
owner="$(printf '%s' "$payload" | jq -r '.repository.owner.login // .repository.owner.username // .repository.owner.name // ""')"
repo="$(printf '%s' "$payload" | jq -r '.repository.name // ""')"
pr="$(printf '%s' "$payload" | jq -r '.pull_request.number // .pull_request.index // .issue.number // .issue.index // ""')"
head_sha="$(printf '%s' "$payload" | jq -r '.pull_request.head.sha // ""')"
base_ref="$(printf '%s' "$payload" | jq -r '.pull_request.base.ref // ""')"
occasion=""
case "$event:$action" in
  pull_request:opened) occasion="pr-opened" ;;
  pull_request:reopened) occasion="pr-reopened" ;;
  pull_request:synchronized) occasion="pr-synchronized" ;;
  pull_request:edited) occasion="pr-edited" ;;
  pull_request:closed) occasion="pr-closed" ;;
  pull_request:label_updated|pull_request_label:label_updated)
    occasion="label-updated"
    ;;
  pull_request_approved:*|pull_request_review_approved:*) occasion="review-approved" ;;
  pull_request_rejected:*|pull_request_review_rejected:*) occasion="review-rejected" ;;
  issue_comment:created) occasion="comment-created" ;;
esac

printf 'OCCASION=%s\n' "$occasion"
printf 'FORGE=%s\n' ""
printf 'OWNER=%s\n' "$owner"
printf 'REPO=%s\n' "$repo"
printf 'PR=%s\n' "$pr"
printf 'HEAD_SHA=%s\n' "$head_sha"
printf 'BASE_REF=%s\n' "$base_ref"
