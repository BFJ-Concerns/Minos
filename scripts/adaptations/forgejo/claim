#!/usr/bin/env sh
set -eu
# shellcheck source-path=SCRIPTDIR
. "$(dirname "$0")/common.sh"

owner="$1"
repo="$2"
pr="$3"
login="$4"

user_json="$(api GET "/api/v1/user")" || {
  write_result uncertain "authenticated forge identity could not be read"
  exit 0
}
actual_login="$(printf '%s' "$user_json" | jq -r '.login // .username // ""')"
if [ "$actual_login" != "$login" ]; then
  write_result rejected "authenticated forge identity is ${actual_login:-missing}, expected $login"
  exit 0
fi

pr_json="$(api GET "/api/v1/repos/${owner}/${repo}/pulls/${pr}")" || {
  write_result uncertain "pull request state could not be read"
  exit 0
}
if ! printf '%s' "$pr_json" | jq -e \
  --arg repository "${owner}/${repo}" \
  --argjson pr "$pr" '
  .number == $pr and
  .base.repo.full_name == $repository and
  .state == "open" and
  (.merged // false | not)
' >/dev/null; then
  write_result rejected "pull request is no longer open"
  exit 0
fi

pull_path="/api/v1/repos/${owner}/${repo}/pulls/${pr}"
if ! printf '%s' "$pr_json" | jq -e --arg login "$login" '
  [.requested_reviewers[]? | .login // .username // ""] | index($login) != null
' >/dev/null; then
  payload="$(jq -nc --arg login "$login" '{reviewers:[$login]}')"
  api POST "${pull_path}/requested_reviewers" -H "Content-Type: application/json" --data "$payload" >/dev/null || {
    write_result uncertain "pull request review request could not be written"
    exit 0
  }
fi

issue_path="/api/v1/repos/${owner}/${repo}/issues/${pr}"

# The in-flight marker takes the form the run's configuration exported:
# a reaction this account adds, or a label the repository defines.
in_flight_reaction="$(printf '%s' "${MINOS_MARKERS:-}" | jq -r '.["in-flight"].reaction // ""' 2>/dev/null)" || in_flight_reaction=""
in_flight_label="$(printf '%s' "${MINOS_MARKERS:-}" | jq -r '.["in-flight"].label // ""' 2>/dev/null)" || in_flight_label=""
if [ -z "$in_flight_reaction" ] && [ -z "$in_flight_label" ]; then
  write_result rejected "MINOS_MARKERS names no in-flight marker"
  exit 0
fi

reactions_path="${issue_path}/reactions"
in_flight_present() {
  if [ -n "$in_flight_label" ]; then
    issue_label_id "$owner" "$repo" "$pr" "$in_flight_label" >/dev/null
    return
  fi
  reaction_present "$owner" "$repo" "$pr" "$in_flight_reaction" "$login"
}

if in_flight_present; then
  :
else
  presence=$?
  if [ "$presence" -eq 2 ]; then
    write_result uncertain "in-flight marker could not be read"
    exit 0
  fi
  if [ -n "$in_flight_label" ]; then
    if label_id="$(defined_label_id "$owner" "$repo" "$in_flight_label")"; then
      :
    else
      definition=$?
      if [ "$definition" -eq 1 ]; then
        write_result rejected "$(missing_label_reason "$owner" "$repo" "$in_flight_label")"
      else
        write_result uncertain "in-flight label definition could not be read"
      fi
      exit 0
    fi
    payload="$(jq -nc --argjson id "$label_id" '{labels:[$id]}')"
    api POST "${issue_path}/labels" -H "Content-Type: application/json" --data "$payload" >/dev/null || {
      write_result uncertain "in-flight label could not be written"
      exit 0
    }
  else
    payload="$(jq -nc --arg content "$in_flight_reaction" '{content:$content}')"
    api POST "$reactions_path" -H "Content-Type: application/json" --data "$payload" >/dev/null || {
      write_result uncertain "in-flight reaction could not be written"
      exit 0
    }
  fi
fi

pr_json="$(api GET "$pull_path")" || {
  write_result uncertain "pull request review request could not be confirmed"
  exit 0
}
if ! printf '%s' "$pr_json" | jq -e --arg login "$login" '
  [.requested_reviewers[]? | .login // .username // ""] | index($login) != null
' >/dev/null; then
  write_result uncertain "pull request review request was not confirmed"
  exit 0
fi
if ! in_flight_present; then
  write_result uncertain "in-flight marker was not confirmed"
  exit 0
fi

write_result applied
