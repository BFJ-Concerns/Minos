#!/usr/bin/env sh
set -eu
# shellcheck source-path=SCRIPTDIR
. "$(dirname "$0")/common.sh"

# A single plain PR comment — the carrier for a fix or finish run's human-facing
# summary and its trailing machine marker. Fix and finish do not post reviews
# (their product is commits and a merge); this is how their run leaves a
# readable, marker-bearing record on the PR.

owner="$1"
repo="$2"
pr="$3"
body_file="$4"

: "${body_file:?body file is required}"

payload="$(jq -nc --arg body "$(cat "$body_file")" '{body:$body}')"

api POST "/api/v1/repos/${owner}/${repo}/issues/${pr}/comments" \
  -H "Content-Type: application/json" \
  --data "$payload"
