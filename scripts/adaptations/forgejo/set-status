#!/usr/bin/env sh
set -eu
. "$(dirname "$0")/common.sh"

owner="$1"
repo="$2"
sha="$3"
context="$4"
state="$5"
description="$6"

api POST "/api/v1/repos/${owner}/${repo}/statuses/${sha}" \
  -H "Content-Type: application/json" \
  --data "$(jq -nc --arg context "$context" --arg state "$state" --arg description "$description" '{context: $context, state: $state, description: $description}')" >/dev/null
