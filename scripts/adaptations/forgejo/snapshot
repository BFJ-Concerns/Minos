#!/usr/bin/env sh
set -eu
# shellcheck source-path=SCRIPTDIR
. "$(dirname "$0")/common.sh"

owner="$1"
repo="$2"
pr="$3"

user_json="$(api GET "/api/v1/user")"
repository_json="$(api GET "/api/v1/repos/${owner}/${repo}")"
pr_json="$(api GET "/api/v1/repos/${owner}/${repo}/pulls/${pr}")"
base_ref="$(printf '%s' "$pr_json" | jq -r '.base.ref')"
base_json="$(api GET "/api/v1/repos/${owner}/${repo}/branches/$(urlencode "$base_ref")")"

dependencies='[]'
dependency_error=''
previous=''
page=1
while :; do
  if ! api_with_status GET "/api/v1/repos/${owner}/${repo}/issues/${pr}/dependencies?limit=50&page=${page}"; then
    dependency_error='forge request failed'
    break
  fi
  if [ "$api_status_code" != "200" ]; then
    dependency_error="forge returned HTTP ${api_status_code}"
    break
  fi
  current="$api_status_body"
  if ! printf '%s' "$current" | jq -e '
    type == "array" and all(.[];
      (.number | type) == "number" and .number > 0 and
      (.state | type) == "string" and
      (.repository.full_name | type) == "string" and .repository.full_name != "")
  ' >/dev/null 2>&1; then
    dependency_error='forge returned an invalid dependencies response'
    break
  fi
  ! repeats_previous_page "$current" "$previous" || break
  [ "$(printf '%s' "$current" | jq 'length')" -gt 0 ] || break
  dependencies="$(jq -cn --argjson all "$dependencies" --argjson page "$current" '$all + $page')"
  previous="$current"
  page=$((page + 1))
done
if [ -n "$dependency_error" ]; then
  dependencies='[]'
fi

statuses="$(commit_statuses "$owner" "$repo" "$(printf '%s' "$pr_json" | jq -r '.head.sha')")"

reviews='[]'
previous=''
page=1
while :; do
  current="$(api GET "/api/v1/repos/${owner}/${repo}/pulls/${pr}/reviews?limit=50&page=${page}")"
  ! repeats_previous_page "$current" "$previous" || break
  [ "$(printf '%s' "$current" | jq 'length')" -gt 0 ] || break
  reviews="$(jq -cn --argjson all "$reviews" --argjson page "$current" '$all + $page')"
  previous="$current"
  page=$((page + 1))
done

head_branch="$(printf '%s' "$pr_json" | jq -r '.head.ref // ""')"
case "$head_branch" in
  refs/pull/*/head) head_branch="" ;;
esac
jq -nc \
  --argjson user "$user_json" \
  --argjson repository "$repository_json" \
  --argjson pr "$pr_json" \
  --argjson base "$base_json" \
  --argjson statuses "$statuses" \
  --argjson reviews "$reviews" \
  --argjson dependencies "$dependencies" \
  --arg dependency_error "$dependency_error" \
  --arg head_branch "$head_branch" '
  {
    authenticated_user: ($user.login // $user.username // ""),
    repository: $repository.full_name,
    pull_request: $pr.number,
    state: (if ($pr.merged // false) then "merged" else $pr.state end),
    merged: ($pr.merged // false),
    draft: ($pr.draft // false),
    author: ($pr.user.login // $pr.user.username // ""),
    head_sha: $pr.head.sha,
    head_branch: $head_branch,
    head_repository: ($pr.head.repo.full_name // ""),
    title: ($pr.title // ""),
    body: ($pr.body // ""),
    target_sha: ($base.commit.id // $base.commit.sha // ""),
    target_branch: $pr.base.ref,
    target_repository: $pr.base.repo.full_name,
    statuses: $statuses,
    labels: [($pr.labels // [])[] | .name] | sort,
    reviews: [$reviews[] | {id, state, commit_id, body:(.body // ""), user:(.user.login // .user.username // "")}],
    dependencies_available: ($dependency_error == ""),
    dependency_error: $dependency_error,
    open_dependencies: [$dependencies[] | select(.state == "open") |
      {repository:.repository.full_name, number:.number}] | sort_by(.repository, .number)
  }'
