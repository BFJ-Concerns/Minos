#!/usr/bin/env sh
set -eu
# shellcheck source-path=SCRIPTDIR
. "$(dirname "$0")/common.sh"

# Complete the merge. Firing a finish run is permissive; merging is gated — the
# finish session decides clean-or-flagged, current, and build/test before it
# calls this. The forge applies the final gate of its own (required checks,
# branch protection, up-to-date): a refusal here surfaces as a non-zero exit the
# session records as a refused outcome, never a silent stop.

owner="$1"
repo="$2"
pr="$3"
method="${4:-merge}"

case "$method" in
  merge|rebase|squash|rebase-merge|manually-merged) ;;
  *) echo "merge: unsupported method: $method" >&2; exit 2 ;;
esac

payload="$(jq -nc --arg method "$method" '{Do:$method}')"

api POST "/api/v1/repos/${owner}/${repo}/pulls/${pr}/merge" \
  -H "Content-Type: application/json" \
  --data "$payload"
