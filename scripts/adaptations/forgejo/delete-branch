#!/usr/bin/env sh
set -eu
# shellcheck source-path=SCRIPTDIR
. "$(dirname "$0")/common.sh"

owner="$1"; repo="$2"; pr="$3"; head="$4"; target="$5"; login="$6"
# target belongs to the clearance tuple. After merge the target ref normally
# points at the merge result, so cleanup is guarded by the merged PR and exact
# source head rather than requiring the pre-merge target SHA to remain current.
: "$target"

user_json="$(api GET "/api/v1/user")" || { write_result uncertain "forge identity could not be read"; exit 0; }
actual_login="$(printf '%s' "$user_json" | jq -r '.login // .username // ""')"
if [ "$actual_login" != "$login" ]; then write_result rejected "authenticated forge identity changed"; exit 0; fi

repository_json="$(api GET "/api/v1/repos/${owner}/${repo}")" || { write_result uncertain "repository could not be read"; exit 0; }
pr_json="$(api GET "/api/v1/repos/${owner}/${repo}/pulls/${pr}")" || { write_result uncertain "merged pull request could not be read"; exit 0; }
branch="$(printf '%s' "$pr_json" | jq -r '.head.ref // ""')"
head_repo="$(printf '%s' "$pr_json" | jq -r '.head.repo.full_name // ""')"
default_branch="$(printf '%s' "$repository_json" | jq -r '.default_branch // ""')"

if [ "$(printf '%s' "$pr_json" | jq -r '.merged // false')" != "true" ]; then
  write_result rejected "pull request is not a confirmed merge"; exit 0
fi
if [ "$head_repo" != "${owner}/${repo}" ]; then write_result rejected "fork source branches are outside service authority"; exit 0; fi
if [ -z "$branch" ] || [ "$branch" = "$default_branch" ]; then write_result rejected "default or missing source branch cannot be deleted"; exit 0; fi

if ! api_with_status GET "/api/v1/repos/${owner}/${repo}/branches/$(urlencode "$branch")" 2>/dev/null; then
  write_result uncertain "source branch could not be read"
  exit 0
fi
case "$api_status_code" in
  200) branch_json="$api_status_body" ;;
  404) write_result applied; exit 0 ;;
  *) write_result uncertain "source branch read returned HTTP ${api_status_code}"; exit 0 ;;
esac
if [ "$(printf '%s' "$branch_json" | jq -r '.protected // false')" = "true" ]; then write_result rejected "protected source branch cannot be deleted"; exit 0; fi
actual_head="$(printf '%s' "$branch_json" | jq -r '.commit.id // .commit.sha // ""')"
if [ "$actual_head" != "$head" ]; then write_result rejected "source branch advanced after merge"; exit 0; fi

askpass_dir="$(mktemp -d)"
trap 'rm -rf "$askpass_dir"' EXIT HUP INT TERM
cat >"$askpass_dir/askpass" <<'EOF'
#!/usr/bin/env sh
case "$1" in
  *sername*) printf '%s\n' 'x-access-token' ;;
  *) printf '%s\n' "$MINOS_FORGE_TOKEN" ;;
esac
EOF
chmod 700 "$askpass_dir/askpass"
clone_url="$(printf '%s' "$repository_json" | jq -r '.clone_url')"
if GIT_ASKPASS="$askpass_dir/askpass" GIT_TERMINAL_PROMPT=0 git push \
  --force-with-lease="refs/heads/${branch}:${head}" "$clone_url" ":refs/heads/${branch}" >/dev/null 2>&1; then
  write_result applied
else
  if remote_refs="$(GIT_ASKPASS="$askpass_dir/askpass" GIT_TERMINAL_PROMPT=0 git ls-remote "$clone_url" "refs/heads/${branch}" 2>/dev/null)"; then
    remote_head="$(printf '%s\n' "$remote_refs" | awk 'NR == 1 {print $1}')"
  else
    write_result uncertain "branch deletion outcome could not be read"
    exit 0
  fi
  if [ -z "$remote_head" ]; then
    write_result applied
  elif [ "$remote_head" != "$head" ]; then
    write_result rejected "source branch advanced after merge"
  else
    # The failed write has been discovered as a confirmed no-op: the branch
    # still names the expected head. This is retryable, not an uncertain write.
    write_result retryable "branch deletion should be retried"
  fi
fi
