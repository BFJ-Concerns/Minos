#!/usr/bin/env sh
set -eu
# shellcheck source-path=SCRIPTDIR
. "$(dirname "$0")/common.sh"

owner="$1"; repo="$2"; pr="$3"; head="$4"; target="$5"; login="$6"; label="$7"

if [ -z "$label" ]; then
  write_result rejected "label is required"
  exit 0
fi

if guard_open_pull_request "$owner" "$repo" "$pr" "$head" "$target" "$login"; then
  :
else
  status=$?
  if [ "$status" -eq 1 ]; then write_result rejected "$guard_reason"; else write_result uncertain "forge guard could not be confirmed"; fi
  exit 0
fi

labels_path="/api/v1/repos/${owner}/${repo}/issues/${pr}/labels"
label_present() {
  labels="$(api GET "$labels_path" 2>/dev/null)" || return 2
  if printf '%s' "$labels" | jq -e --arg label "$label" 'any(.[]?; .name == $label)' >/dev/null; then
    return 0
  fi
  return 1
}

if label_present; then
  :
else
  presence=$?
  if [ "$presence" -eq 1 ]; then write_result applied "label already absent"; else write_result uncertain "label read-back could not be confirmed"; fi
  exit 0
fi

api DELETE "${labels_path}/$(urlencode "$label")" >/dev/null 2>&1 || true
if label_present; then
  write_result uncertain "label removal could not be discovered"
else
  presence=$?
  if [ "$presence" -eq 1 ]; then write_result applied; else write_result uncertain "label read-back could not be confirmed"; fi
fi
