#!/usr/bin/env sh
set -eu
. "$(dirname "$0")/common.sh"

owner="$1"
repo="$2"

existing="$(mktemp)"
trap 'rm -f "$existing"' EXIT

# Fetch the whole vocabulary: established repositories can readily exceed one
# API page, and idempotency should not depend on a label happening to be early.
page=1
previous_labels='[]'
while :; do
  labels="$(api GET "/api/v1/repos/${owner}/${repo}/labels?limit=50&page=${page}")"
  count="$(printf '%s\n' "$labels" | jq 'length')"
  [ "$count" -gt 0 ] || break
  repeats_previous_page "$labels" "$previous_labels" && break
  previous_labels="$labels"
  printf '%s\n' "$labels" | jq -r '.[].name' >>"$existing"
  page=$((page + 1))
done

ensure_label() {
  name="$1"
  colour="$2"
  description="$3"
  if grep -Fqx "$name" "$existing"; then
    return
  fi
  api POST "/api/v1/repos/${owner}/${repo}/labels" \
    -H "Content-Type: application/json" \
    --data "$(jq -nc --arg name "$name" --arg color "$colour" --arg description "$description" \
      '{name: $name, color: $color, description: $description}')" >/dev/null
  printf '%s\n' "$name" >>"$existing"
}

ensure_label "Reviewing" "#1f6feb" "Pump-19 review run in progress"
ensure_label "Fixing" "#bf8700" "Pump-19 fix run in progress"
ensure_label "Finishing" "#8250df" "Pump-19 finish run in progress"
ensure_label "Repairing Flaky Tests" "#d4a72c" "Pump-19 flaky-test repair in progress"
ensure_label "Converged" "#2da44e" "Pump-19 review converged"
ensure_label "Standing Findings" "#cf222e" "Verified material findings remain"
ensure_label "Partial Coverage" "#fb8f44" "Review coverage is incomplete"
ensure_label "Flaky Tests" "#d4a72c" "Flaky tests pause review convergence"
ensure_label "Ready" "#2da44e" "Repository-approved finish trigger"

rm -f "$existing"
trap - EXIT
