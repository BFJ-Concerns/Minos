#!/usr/bin/env sh
set -eu
# shellcheck source-path=SCRIPTDIR
. "$(dirname "$0")/common.sh"

# Forgejo takes an access token as the HTTPS password whatever the username,
# so the credential file's token is the git credential as it stands. The
# secret leaves on stdout alone, for the caller to capture; jq reads it from
# the environment, so it is never a process argument.
export MINOS_FORGE_CREDENTIAL
jq -nc '{username: "minos", password: env.MINOS_FORGE_CREDENTIAL}'
