#!/usr/bin/env sh
set -eu
# shellcheck source-path=SCRIPTDIR
. "$(dirname "$0")/common.sh"

owner="$1"
repo="$2"
github_authenticate "$owner" "$repo" public
if [ -z "$github_authorisation" ]; then
  api_with_status GET "/repos/${owner}/${repo}"
  if [ "$api_status_code" = 200 ] && printf '%s' "$api_status_body" | jq -e '.private == false' >/dev/null; then
    printf '%s\n' '{"anonymous":true}'
    exit 0
  fi
  echo "github: no installation or public clone access for ${owner}/${repo}" >&2
  exit 1
fi

# GitHub HTTPS uses x-access-token as the username for installation tokens.
printf '%s' "$MINOS_GITHUB_TOKEN" | jq -Rsc '{username: "x-access-token", password: .}'
