#!/usr/bin/env sh
set -eu
# shellcheck source-path=SCRIPTDIR
. "$(dirname "$0")/common.sh"

# GitHub authenticates an App installation's HTTPS git traffic as the user
# x-access-token with the installation token as the password. The secret
# leaves on stdout alone, for the caller to capture; jq reads it from the
# environment, so it is never a process argument.
export MINOS_GITHUB_TOKEN
jq -nc '{username: "x-access-token", password: env.MINOS_GITHUB_TOKEN}'
