#!/usr/bin/env sh
set -eu

payload="$(cat)"
event="${MINOS_HEADER_X_GITHUB_EVENT:-}"

action="$(printf '%s' "$payload" | jq -r '.action // ""')"
owner="$(printf '%s' "$payload" | jq -r '.repository.owner.login // ""')"
repo="$(printf '%s' "$payload" | jq -r '.repository.name // ""')"
pr="$(printf '%s' "$payload" | jq -r '.pull_request.number // .issue.number // ""')"
head_sha="$(printf '%s' "$payload" | jq -r '.pull_request.head.sha // ""')"
base_ref="$(printf '%s' "$payload" | jq -r '.pull_request.base.ref // ""')"
review_state="$(printf '%s' "$payload" | jq -r '.review.state // ""')"
comment_on_pull_request="$(printf '%s' "$payload" | jq -r 'if .issue.pull_request != null then "yes" else "no" end')"
occasion=""
case "$event:$action" in
  pull_request:opened) occasion="pr-opened" ;;
  pull_request:reopened) occasion="pr-reopened" ;;
  pull_request:synchronize) occasion="pr-synchronized" ;;
  # A draft flag change is an eligibility change, which reconciliation
  # re-derives from the snapshot; the occasion only needs to arrive.
  pull_request:edited|pull_request:ready_for_review|pull_request:converted_to_draft) occasion="pr-edited" ;;
  pull_request:closed) occasion="pr-closed" ;;
  pull_request:labeled|pull_request:unlabeled) occasion="label-updated" ;;
  pull_request_review:submitted)
    case "$review_state" in
      approved) occasion="review-approved" ;;
      changes_requested) occasion="review-rejected" ;;
    esac
    ;;
  issue_comment:created)
    [ "$comment_on_pull_request" != "yes" ] || occasion="comment-created"
    ;;
esac

printf 'OCCASION=%s\n' "$occasion"
printf 'FORGE=%s\n' ""
printf 'OWNER=%s\n' "$owner"
printf 'REPO=%s\n' "$repo"
printf 'PR=%s\n' "$pr"
printf 'HEAD_SHA=%s\n' "$head_sha"
printf 'BASE_REF=%s\n' "$base_ref"
