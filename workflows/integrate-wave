#!/usr/bin/env sh
set -eu

if [ "$#" -ne 2 ] && [ "$#" -ne 4 ]; then
  echo "usage: workflows/integrate-wave WORKSPACE COMMITS_FILE [--member-branch BRANCH]" >&2
  exit 2
fi

workspace="$1"
commits_file="$2"
branch="${MINOS_HEAD_BRANCH:-}"
if [ "$#" -eq 4 ]; then
  if [ "$3" != "--member-branch" ] || [ -z "$4" ]; then
    echo "usage: workflows/integrate-wave WORKSPACE COMMITS_FILE [--member-branch BRANCH]" >&2
    exit 2
  fi
  branch="$4"
fi
: "${MINOS_HEAD_BRANCH:?MINOS_HEAD_BRANCH is required}"
expected_name="${MINOS_GIT_AUTHOR_NAME:-Minos}"
expected_email="${MINOS_GIT_AUTHOR_EMAIL:-minos@example.invalid}"

# Grouped integrations reuse one claimed workspace. A member invocation must
# not leave that workspace pointing at whichever member happened to run last:
# the later gate needs a defined tree. Restore the primary's published head on
# success and refusal alike; the commission separately decides what a grouped
# gate should judge.
restore_primary() {
  status="$1"
  trap - 0
  if ! git -C "$workspace" fetch origin "refs/heads/${MINOS_HEAD_BRANCH}" ||
     ! git -C "$workspace" checkout --detach --force "origin/${MINOS_HEAD_BRANCH}"; then
    echo "integrate-wave: failed to restore the primary workspace head" >&2
    exit 1
  fi
  exit "$status"
}
if [ "$branch" != "$MINOS_HEAD_BRANCH" ]; then
  trap 'restore_primary "$?"' 0
fi

if [ -n "${MINOS_RUN_DIR:-}" ] && [ -f "${MINOS_RUN_DIR}/reconciliation.json" ]; then
  if [ "$(jq -r '.publish // false' "${MINOS_RUN_DIR}/reconciliation.json")" != true ]; then
    echo "integrate-wave: this pull request has no pushable source branch" >&2
    exit 1
  fi
fi

if ! jq -e 'type == "array" and length > 0 and all(.[]; type == "string" and length > 0)' "$commits_file" >/dev/null; then
  echo "integrate-wave: commits file must contain a non-empty JSON string array" >&2
  exit 1
fi

# Every destination branch, including the primary's, starts from its own
# published head. Reusing the workspace without this reset would make the
# previous member's repair an ancestor of a later primary push.
git -C "$workspace" fetch origin "refs/heads/${branch}"
git -C "$workspace" checkout --detach "origin/${branch}"

for commit in $(jq -r '.[]' "$commits_file"); do
  if ! git -C "$workspace" cat-file -e "${commit}^{commit}"; then
    echo "integrate-wave: unknown commit $commit" >&2
    exit 1
  fi
  author_name="$(git -C "$workspace" show -s --format=%an "$commit")"
  author_email="$(git -C "$workspace" show -s --format=%ae "$commit")"
  if [ "$author_name" != "$expected_name" ] || [ "$author_email" != "$expected_email" ]; then
    echo "integrate-wave: commit $commit is authored by ${author_name} <${author_email}>" >&2
    exit 1
  fi
  git -C "$workspace" cherry-pick "$commit"
done

common_dir="$(git -C "$workspace" rev-parse --path-format=absolute --git-common-dir)"
push_ref="refs/heads/${branch}"
protected_refs="${common_dir}/minos-protected-ref"
if [ -f "$protected_refs" ] && ! grep -Fqx "$push_ref" "$protected_refs"; then
  printf '%s\n' "$push_ref" >>"$protected_refs"
fi
push_head="$(git -C "$workspace" rev-parse HEAD)"
push_permit="$(mktemp "${common_dir}/minos-integrate-wave-push.XXXXXX")"
if [ "$branch" != "$MINOS_HEAD_BRANCH" ]; then
  trap 'status=$?; rm -f "$push_permit"; restore_primary "$status"' 0 1 2 3 15
else
  trap 'rm -f "$push_permit"' 0 1 2 3 15
fi
printf '%s %s\n' "$push_ref" "$push_head" >"$push_permit"
MINOS_INTEGRATE_WAVE_PUSH_PERMIT="$push_permit" \
  git -C "$workspace" push origin "HEAD:${push_ref}"

# The wave's commits now live on the head branch; the worktrees that authored
# them are spent, and their build directories are the run's largest transient
# disk cost. Reap is best-effort: its failure never fails an integrated wave.
if [ -n "${MINOS_REAP_WORKTREES:-}" ] && [ -x "$MINOS_REAP_WORKTREES" ]; then
  "$MINOS_REAP_WORKTREES" "$workspace" || true
fi

jq -nc --arg head "$push_head" '{outcome:"integrated",head:$head}'
