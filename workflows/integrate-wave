#!/usr/bin/env sh
set -eu

if [ "$#" -ne 2 ] && [ "$#" -ne 3 ] && [ "$#" -ne 4 ]; then
  echo "usage: workflows/integrate-wave WORKSPACE COMMITS_FILE [--member-branch BRANCH] | WORKSPACE --protect-members MEMBERS_FILE" >&2
  exit 2
fi

workspace="$1"
mode=integrate
if [ "$#" -eq 3 ]; then
  if [ "$2" != "--protect-members" ] || [ -z "$3" ]; then
    echo "usage: workflows/integrate-wave WORKSPACE COMMITS_FILE [--member-branch BRANCH] | WORKSPACE --protect-members MEMBERS_FILE" >&2
    exit 2
  fi
  mode=protect
  members_file="$3"
else
  commits_file="$2"
fi
branch="${MINOS_HEAD_BRANCH:-}"
if [ "$#" -eq 4 ]; then
  if [ "$3" != "--member-branch" ] || [ -z "$4" ]; then
    echo "usage: workflows/integrate-wave WORKSPACE COMMITS_FILE [--member-branch BRANCH] | WORKSPACE --protect-members MEMBERS_FILE" >&2
    exit 2
  fi
  branch="$4"
fi
: "${MINOS_HEAD_BRANCH:?MINOS_HEAD_BRANCH is required}"
expected_name="${MINOS_GIT_AUTHOR_NAME:-Minos}"
expected_email="${MINOS_GIT_AUTHOR_EMAIL:-minos@example.invalid}"
primary_head="$(git -C "$workspace" rev-parse HEAD)"
common_dir="$(git -C "$workspace" rev-parse --path-format=absolute --git-common-dir)"
protected_refs="${common_dir}/minos-protected-ref"

protect_ref() {
  protected_ref="$1"
  case "$protected_ref" in
    refs/heads/?*) ;;
    *)
      echo "integrate-wave: invalid protected ref ${protected_ref:-<empty>}" >&2
      exit 1
      ;;
  esac
  if ! git -C "$workspace" check-ref-format "$protected_ref"; then
    echo "integrate-wave: invalid protected ref $protected_ref" >&2
    exit 1
  fi
  if ! grep -Fqx "$protected_ref" "$protected_refs"; then
    printf '%s\n' "$protected_ref" >>"$protected_refs"
  fi
}

protect_members() {
  member_record="$1"
  if ! jq -e '
    (if type == "array" then . else .members end) as $members |
    ($members | type == "array" and length > 0) and
    all($members[]; type == "object" and (.head_branch | type == "string" and length > 0))
  ' "$member_record" >/dev/null; then
    echo "integrate-wave: members record must contain non-empty head branches" >&2
    exit 1
  fi
  jq -r 'if type == "array" then .[] else .members[] end | .head_branch' "$member_record" |
    while IFS= read -r member_branch; do
      protect_ref "refs/heads/${member_branch}"
    done
}

if [ -e "$protected_refs" ]; then
  if [ ! -f "$protected_refs" ] || [ ! -r "$protected_refs" ] || [ ! -s "$protected_refs" ]; then
    echo "integrate-wave: protected-ref record is unreadable or empty" >&2
    exit 1
  fi
  if [ "$mode" = protect ]; then
    protect_members "$members_file"
  elif [ -n "${MINOS_RUN_DIR:-}" ] && [ -f "${MINOS_RUN_DIR}/members.json" ]; then
    protect_members "${MINOS_RUN_DIR}/members.json"
  else
    protect_ref "refs/heads/${branch}"
  fi
elif [ "$mode" = protect ]; then
  echo "integrate-wave: protected-ref record is absent" >&2
  exit 1
fi

if [ "$mode" = protect ]; then
  jq -nc --arg record "$members_file" '{outcome:"protected",record:$record}'
  exit 0
fi

# Grouped integrations reuse one claimed workspace. A member invocation must
# not leave that workspace pointing at whichever member happened to run last:
# the later gate needs a defined tree. Restore the primary's published head on
# success and refusal alike; the commission separately decides what a grouped
# gate should judge.
restore_primary() {
  status="$1"
  trap - 0
  if [ "$branch" = "$MINOS_HEAD_BRANCH" ] && [ "$status" -eq 0 ]; then
    exit 0
  fi
  git -C "$workspace" cherry-pick --abort 2>/dev/null || true
  if ! git -C "$workspace" checkout --detach --force "$primary_head"; then
    echo "integrate-wave: failed to restore the primary workspace head" >&2
    exit 1
  fi
  exit "$status"
}
trap 'restore_primary "$?"' 0

if [ -n "${MINOS_RUN_DIR:-}" ] && [ -f "${MINOS_RUN_DIR}/reconciliation.json" ]; then
  if [ "$(jq -r '.publish // false' "${MINOS_RUN_DIR}/reconciliation.json")" != true ]; then
    echo "integrate-wave: this pull request has no pushable source branch" >&2
    exit 1
  fi
fi

if ! jq -e 'type == "array" and length > 0 and all(.[]; type == "string" and length > 0)' "$commits_file" >/dev/null; then
  echo "integrate-wave: commits file must contain a non-empty JSON string array" >&2
  exit 1
fi

# Preserve the head the run accepted before fetching. A newly published head
# belongs to the run-wide foreign-movement discipline; integrating onto it
# here would silently accept unreviewed work. Member heads live in their
# remote-tracking refs because their integrations reuse the primary workspace.
if [ "$branch" = "$MINOS_HEAD_BRANCH" ]; then
  expected_head="$primary_head"
elif ! expected_head="$(git -C "$workspace" rev-parse --verify "refs/remotes/origin/${branch}" 2>/dev/null)"; then
  echo "integrate-wave: no accepted head is recorded for member branch $branch" >&2
  exit 1
fi
git -C "$workspace" fetch origin \
  "refs/heads/${branch}:refs/remotes/origin/${branch}"
observed_head="$(git -C "$workspace" rev-parse "refs/remotes/origin/${branch}")"
if [ "$observed_head" != "$expected_head" ]; then
  echo "integrate-wave: destination $branch moved from $expected_head to $observed_head; apply the run-wide foreign-movement discipline before integration" >&2
  exit 1
fi
git -C "$workspace" checkout --detach "$expected_head"

for commit in $(jq -r '.[]' "$commits_file"); do
  if ! git -C "$workspace" cat-file -e "${commit}^{commit}"; then
    echo "integrate-wave: unknown commit $commit" >&2
    exit 1
  fi
  author_name="$(git -C "$workspace" show -s --format=%an "$commit")"
  author_email="$(git -C "$workspace" show -s --format=%ae "$commit")"
  if [ "$author_name" != "$expected_name" ] || [ "$author_email" != "$expected_email" ]; then
    echo "integrate-wave: commit $commit is authored by ${author_name} <${author_email}>" >&2
    exit 1
  fi
  git -C "$workspace" cherry-pick "$commit"
done

push_ref="refs/heads/${branch}"
push_head="$(git -C "$workspace" rev-parse HEAD)"
push_permit="$(mktemp "${common_dir}/minos-integrate-wave-push.XXXXXX")"
trap 'status=$?; rm -f "$push_permit"; restore_primary "$status"' 0 1 2 3 15
printf '%s %s %s\n' "$push_ref" "$push_head" "$expected_head" >"$push_permit"
MINOS_INTEGRATE_WAVE_PUSH_PERMIT="$push_permit" \
  git -C "$workspace" push \
    "--force-with-lease=${push_ref}:${expected_head}" origin "HEAD:${push_ref}"

# The wave's commits now live on the head branch; the worktrees that authored
# them are spent, and their build directories are the run's largest transient
# disk cost. Reap is best-effort: its failure never fails an integrated wave.
if [ -n "${MINOS_REAP_WORKTREES:-}" ] && [ -x "$MINOS_REAP_WORKTREES" ]; then
  "$MINOS_REAP_WORKTREES" "$workspace" || true
fi

jq -nc --arg head "$push_head" '{outcome:"integrated",head:$head}'
