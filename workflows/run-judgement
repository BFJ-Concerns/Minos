#!/usr/bin/env node

// Runs one judgement stage's workflow and prints its answer. It is the
// runner a judgement stage takes under dispatch-stage and the whole of what
// replay-judgement.mjs runs, so a stage answers a recorded input through
// exactly the path it answers a live one. The Ensemble launcher is the one
// installed beside this tree, and the workflow's agent works in the
// caller's working directory: the clone the stage reads.
//
// A stage that gave no usable answer exits non-zero with nothing on
// standard output, so dispatch-stage leaves no result file and no caller
// mistakes a missing judgement for one.

import { spawn } from "node:child_process";
import { readFileSync, writeFileSync } from "node:fs";
import { dirname, isAbsolute, resolve } from "node:path";
import { fileURLToPath } from "node:url";

import { answerFrom, loadStage } from "./judgement-stage.mjs";

const LAUNCHER = resolve(dirname(fileURLToPath(import.meta.url)), "..", "runtime", "ensemble.mjs");

function launch(jsonArgs, workflowScript) {
  return new Promise((settle, reject) => {
    const child = spawn(process.execPath, [LAUNCHER, "--json-args", jsonArgs, workflowScript], {
      stdio: ["ignore", "pipe", "inherit"],
    });
    let stdout = "";
    child.stdout.setEncoding("utf8");
    child.stdout.on("data", (chunk) => { stdout += chunk; });
    child.once("error", reject);
    child.once("close", (code, signal) => {
      if (code === 0) settle(stdout);
      else reject(new Error(signal ? `ensemble launcher ended on ${signal}` : `ensemble launcher exited ${code}`));
    });
  });
}

const [workflowScript, flag, jsonArgs, ...extra] = process.argv.slice(2);
try {
  if (!workflowScript || flag !== "--json-args" || !jsonArgs || !jsonArgs.startsWith("@") || extra.length > 0)
    throw new Error("usage: run-judgement <workflow-script-abs-path> --json-args @<argsfile>");
  if (!isAbsolute(workflowScript)) throw new Error("workflow script path must be absolute");
  const args = JSON.parse(readFileSync(jsonArgs.slice(1), "utf8"));
  const stage = await loadStage(args.stage);
  const problem = stage.inputProblem(args.input);
  if (problem) throw new Error(`${stage.name} input: ${problem}`);
  const lines = (await launch(jsonArgs, workflowScript)).split(/\r?\n/).filter((line) => line !== "");
  if (lines.length !== 1) throw new Error(`ensemble launcher emitted ${lines.length} stdout lines; expected one result`);
  const result = JSON.parse(lines[0]);
  const answer = answerFrom(stage, args.input, result);
  process.stdout.write(`${JSON.stringify({ stage: stage.name, answer, answeredBy: result.answeredBy ?? null })}\n`);
} catch (error) {
  process.stderr.write(`run-judgement: ${error.message}\n`);
  const failurePath = process.env.MINOS_STAGE_FAILURE;
  if (failurePath) {
    try {
      writeFileSync(failurePath, error.message, { mode: 0o600 });
    } catch (writeError) {
      process.stderr.write(`run-judgement: could not keep the failure reason: ${writeError.message}\n`);
    }
  }
  process.exitCode = 1;
}
