#!/usr/bin/env node

import { spawn, spawnSync } from "node:child_process";
import {
  chmodSync,
  copyFileSync,
  lstatSync,
  mkdirSync,
  mkdtempSync,
  readdirSync,
  readlinkSync,
  rmSync,
  symlinkSync,
  writeFileSync,
} from "node:fs";
import { tmpdir } from "node:os";
import { basename, isAbsolute, join } from "node:path";

import { adjudicate } from "./run-record-adjudicator.mjs";
import { attachOutOfScopeObservations } from "./out-of-scope-observations.mjs";

const LAUNCHER = "/opt/minos/runtime/ensemble.mjs";

// The engagement-gate workflow carries its decision on the envelope; copy a
// valid one onto the verdict so the lead can read it there. Envelopes without
// one — every other review workflow — leave the verdict untouched.
function attachScopeDecision(verdict, envelope) {
  const decision = envelope && envelope.scopeDecision;
  if (
    !decision || typeof decision !== "object" || Array.isArray(decision) ||
    (decision.status !== "nothing-engages" && decision.status !== "review-required") ||
    typeof decision.reason !== "string" || decision.reason === ""
  ) return verdict;
  return { ...verdict, scopeDecision: { status: decision.status, reason: decision.reason } };
}

function noteRetentionFailure(failures, relativePath, error) {
  const detail = `${relativePath}: ${error.message}`;
  failures.push(detail);
  process.stderr.write(
    `adjudicated-review: could not retain run-record entry "${relativePath}" for archival: ${error.message}\n`,
  );
}

function retainEntry(source, destination, relativePath, failures) {
  try {
    const stat = lstatSync(source);
    if (stat.isDirectory()) {
      mkdirSync(destination, { recursive: true, mode: 0o700 });
      let entries;
      try {
        entries = readdirSync(source, { withFileTypes: true });
      } catch (error) {
        noteRetentionFailure(failures, relativePath, error);
        return;
      }
      for (const entry of entries) {
        retainEntry(
          join(source, entry.name),
          join(destination, entry.name),
          join(relativePath, entry.name),
          failures,
        );
      }
      return;
    }
    if (stat.isFile()) {
      copyFileSync(source, destination);
      return;
    }
    if (stat.isSymbolicLink()) {
      symlinkSync(readlinkSync(source), destination);
      return;
    }
    throw new Error("unsupported filesystem entry type");
  } catch (error) {
    noteRetentionFailure(failures, relativePath, error);
  }
}

function retainRunRecord(recordDir, minosRunDir) {
  const evidenceDir = join(minosRunDir, "ensemble-records");
  const retainedRoot = join(evidenceDir, basename(recordDir));
  mkdirSync(evidenceDir, { recursive: true, mode: 0o700 });
  chmodSync(evidenceDir, 0o700);
  mkdirSync(retainedRoot, { recursive: true, mode: 0o700 });
  chmodSync(retainedRoot, 0o700);
  const failures = [];
  let entries;
  try {
    entries = readdirSync(recordDir, { withFileTypes: true });
  } catch (error) {
    noteRetentionFailure(failures, ".", error);
    entries = [];
  }
  for (const entry of entries) {
    retainEntry(
      join(recordDir, entry.name),
      join(retainedRoot, entry.name),
      entry.name,
      failures,
    );
  }
  if (failures.length > 0) {
    try {
      writeFileSync(
        join(retainedRoot, "RETENTION-INCOMPLETE"),
        `Retention was incomplete.\n${failures.map((failure) => `- ${failure}`).join("\n")}\n`,
        { mode: 0o600 },
      );
    } catch (error) {
      process.stderr.write(
        `adjudicated-review: could not write retained-record incompleteness marker: ${error.message}\n`,
      );
    }
  }
}

function makeTreeRemovable(path) {
  try {
    const stat = lstatSync(path);
    if (!stat.isDirectory()) return;
    try { chmodSync(path, 0o700); } catch {}
    for (const entry of readdirSync(path, { withFileTypes: true })) {
      if (entry.isDirectory()) makeTreeRemovable(join(path, entry.name));
    }
  } catch {}
}

function incomplete(reason, envelope = null) {
  const reviewed = envelope && envelope.reviewed && typeof envelope.reviewed === "object"
    ? envelope.reviewed
    : { target: null, head: null, occasion: null };
  return attachOutOfScopeObservations({
    status: "incomplete",
    complete: false,
    reviewed,
    incomplete: [reason],
    infrastructureFailure: null,
    confirmedFindings: [],
    operatorAttention: [],
    reviewBody: null,
    ran: [],
    skipped: [],
    misconfigurations: [],
    modelEvidence: [],
  }, envelope);
}

function launchEnsemble(args, options) {
  return new Promise((resolve, reject) => {
    const child = spawn(process.execPath, args, options);
    let stdout = "";
    child.stdout.setEncoding("utf8");
    child.stderr.setEncoding("utf8");
    child.stdout.on("data", (chunk) => { stdout += chunk; });
    child.stderr.on("data", (chunk) => { process.stderr.write(chunk); });
    child.once("error", reject);
    child.once("close", (code, signal) => {
      if (code === 0) resolve(stdout);
      else reject(new Error(signal ? `ensemble launcher ended on ${signal}` : `ensemble launcher exited ${code}`));
    });
  });
}

const [workflowScript, flag, jsonArgs, ...extra] = process.argv.slice(2);
let verdict;
let recordDir;
let envelope = null;
try {
  if (!workflowScript || flag !== "--json-args" || !jsonArgs || !jsonArgs.startsWith("@") || extra.length > 0)
    throw new Error("usage: adjudicated-review <workflow-script-abs-path> --json-args @<argsfile>");
  if (!isAbsolute(workflowScript)) throw new Error("workflow script path must be absolute");
  recordDir = mkdtempSync(join(tmpdir(), "minos-ensemble-record-"));
  const stdout = await launchEnsemble([LAUNCHER, "--json-args", jsonArgs, workflowScript], {
    cwd: process.cwd(),
    env: {
      ...process.env,
      ENSEMBLE_RUN_RECORD: "on",
      ENSEMBLE_RUN_RECORD_DIR: recordDir,
    },
  });
  const lines = stdout.split(/\r?\n/).filter((line) => line !== "");
  if (lines.length !== 1) throw new Error(`ensemble launcher emitted ${lines.length} stdout lines; expected one envelope`);
  envelope = JSON.parse(lines[0]);
  verdict = attachScopeDecision(
    attachOutOfScopeObservations(await adjudicate({ envelope, recordDir }), envelope),
    envelope,
  );
} catch (error) {
  process.stderr.write(`adjudicated-review: ${error.message}\n`);
  verdict = incomplete(error.message, envelope);
} finally {
  if (recordDir) {
    if (process.env.MINOS_RUN_DIR) {
      try {
        retainRunRecord(recordDir, process.env.MINOS_RUN_DIR);
      } catch (error) {
        process.stderr.write(`adjudicated-review: could not retain run record for archival: ${error.message}\n`);
      }
    }
    try {
      makeTreeRemovable(recordDir);
      rmSync(recordDir, { recursive: true, force: true });
    } catch (error) {
      process.stderr.write(`adjudicated-review: could not remove run-record directory: ${error.message}\n`);
      verdict = incomplete(`run-record directory cleanup failed: ${error.message}`, envelope);
    }
  }
  // The verdict is settled and the run record retained; the workflow's
  // worktrees are spent, and their build directories are the run's largest
  // transient disk cost. Reap is best-effort: it never touches the verdict.
  if (process.env.MINOS_REAP_WORKTREES) {
    const reap = spawnSync(process.env.MINOS_REAP_WORKTREES, [process.cwd()], {
      stdio: ["ignore", "ignore", "inherit"],
    });
    if (reap.error || reap.status !== 0) {
      const cause = reap.error ? reap.error.message : `exit ${reap.status}`;
      process.stderr.write(`adjudicated-review: could not reap worktree build directories: ${cause}\n`);
    }
  }
}

process.stdout.write(`${JSON.stringify(verdict)}\n`);
process.stderr.write("[workflow] complete\n");
